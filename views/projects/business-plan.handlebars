<!-- Business Plan Page -->
<div class="min-h-screen bg-background">
<div id="business-plan-main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="flex flex-col gap-4 lg:gap-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-foreground">Business Plan</h1>
      <p class="text-base text-muted-foreground">Develop a comprehensive business plan for your startup.</p>
    </div>
  </div>

    <!-- Model Overview -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">How It Works</h3>
          <p class="text-sm text-muted-foreground mb-4">Our business plan builder guides you through creating a detailed document that outlines your business strategy and operations.</p>
          <ul class="space-y-2 text-sm">
             <li class="flex items-center gap-2">
{{{icon 'file-text' size="16" class="w-4 h-4 text-primary"}}}
               Executive summary
             </li>
             <li class="flex items-center gap-2">
{{{icon 'users' size="16" class="w-4 h-4 text-primary"}}}
               Market analysis
             </li>
             <li class="flex items-center gap-2">
{{{icon 'cog' size="16" class="w-4 h-4 text-primary"}}}
               Operations plan
             </li>
             <li class="flex items-center gap-2">
{{{icon 'trending-up' size="16" class="w-4 h-4 text-primary"}}}
               Financial projections
             </li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">Key Features</h3>
          <div class="space-y-3">
            <div class="p-3 bg-primary/10 rounded-lg">
              <h4 class="font-medium text-primary mb-1">Structured Templates</h4>
              <p class="text-xs text-primary/80">Professional templates for each business plan section.</p>
            </div>
            <div class="p-3 bg-secondary/10 rounded-lg">
              <h4 class="font-medium text-secondary mb-1">Auto-population</h4>
              <p class="text-xs text-secondary/80">Pull data from other models automatically.</p>
            </div>
            <div class="p-3 bg-success/10 rounded-lg">
              <h4 class="font-medium text-success mb-1">Export Options</h4>
              <p class="text-xs text-success/80">Export to PDF, Word, or other formats.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Business Plan Sections -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <h3 class="text-xl font-semibold text-foreground mb-4">Business Plan Components</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'lightbulb' size="20" class="w-5 h-5 text-primary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Company Description</h4>
          <p class="text-sm text-muted-foreground">Overview of your business and mission.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'bar-chart' size="20" class="w-5 h-5 text-secondary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Market Analysis</h4>
          <p class="text-sm text-muted-foreground">Industry trends and competitive landscape.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-success/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'cog' size="20" class="w-5 h-5 text-success"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Organization & Management</h4>
          <p class="text-sm text-muted-foreground">Team structure and management approach.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-warning/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'dollar-sign' size="20" class="w-5 h-5 text-warning"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Financial Projections</h4>
          <p class="text-sm text-muted-foreground">Revenue forecasts and funding requirements.</p>
        </div>
      </div>
    </div>

    <!-- Try It Out -->
    <div class="rounded-lg bg-primary/10 px-6 py-5 text-card-foreground">
      <div class="text-center">
        <h3 class="text-lg font-medium text-foreground mb-2">Ready to Write Your Business Plan?</h3>
        <p class="text-sm text-muted-foreground mb-4">Create a comprehensive plan for your business success.</p>
        <a href="/startup-dashboard/business-plan" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
{{{icon 'file-text' size="16" class="w-4 h-4 mr-2"}}}
          Write Business Plan
        </a>
      </div>
    </div>
  </div>
</div>
</div>