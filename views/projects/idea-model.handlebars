<div class="flex h-full">
  <div class="flex flex-col bg-background min-h-full">

    <div class="flex-1 overflow-y-auto px-4 py-6">
      <div class="max-w-7xl mx-auto space-y-6">
        <!-- Conversation will continue here -->
        {{> ai-message title="Welcome & Introduction" message="Welcome to the iGate Accelerator Idea Model Assistant!
        Im here to guide you through a comprehensive process of validating and developing your startup idea. Well work
        together step by step to explore your problem, define your solution, understand your customers, and build a
        strong foundation for your entrepreneurial journey. Lets begin by examining the core problem you want to
        solve." time="10:28 AM"}}
        {{> task-progress
        title="Idea Onboarding"
        description="Guide to developing your startup idea"
        status="In Progress"
        time="10:30 AM"
        progress="20"
        footerTime="10:30 AM"
        steps=steps
        }}
        <!-- Section 1: Problem Validation -->
        {{> section-header id="section-1" number="1" title="Problem Validation" description="Lets start by thoroughly
        understanding the problem youre solving. This section will help validate that youve identified a real problem
        worth solving and ensure your solution addresses genuine needs." topics="Problem Definition, Target Audience,
        Key Assumptions, Existing Alternatives" bgGradient="from-blue-50 to-indigo-50 dark:from-blue-900/20
        dark:to-indigo-900/20" border="border-blue-200 dark:border-blue-800" circleBg="bg-blue-100 dark:bg-blue-900/30"
        circleText="text-blue-600 dark:text-blue-400" titleText="text-blue-900 dark:text-blue-100"
        descText="text-blue-800 dark:text-blue-200" topicsText="text-blue-700 dark:text-blue-300"}}
        {{> ai-message title="Problem Definition" message="Please describe in detail the specific problem or challenge
        that your startup idea aims to address. Include information about who is affected by this problem, how it
        currently impacts their daily lives or customer operations, the scale of the problem, and why it urgently needs
        to be solved. Provide concrete examples if possible." time="10:28 AM"}} <!-- Problem Definition Form -->
        {{#> form-card title="Problem Definition" alignRight=true formConfigs=formConfigs}} {{> forms/_generic-form
        config=formConfigs.problemDefinition}} {{/form-card}}
        {{> ai-message title="Target Audience" message="Identify and describe the primary group of people or
        organizations who are currently struggling with the problem you described. Provide demographic details, their
        characteristics, pain points, and how this problem affects their productivity, finances, or quality of life. Be
        specific about their needs and frustrations." time="10:28 AM"}} <!-- Target Audience Form -->
        {{#> form-card title="Target Audience" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.targetAudience}} {{/form-card}}
        {{> ai-message title="Key Assumptions" message="List and explain your key assumptions about the problem, the
        market, and your potential solution. For each assumption, describe why you believe its true, what evidence you
        have to support it, and what risks exist if the assumption proves incorrect. This will help validate your
        understanding of the situation." time="10:28 AM"}} <!-- Key Assumptions Form -->
        {{#> form-card title="Key Assumptions" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.keyAssumptions}} {{/form-card}}
        {{> ai-message title="Existing Alternatives" message="Research and describe the existing solutions or
        alternatives that people currently use to address this problem. Include both direct competitors and indirect
        alternatives (workarounds). For each one, explain their strengths, weaknesses, pricing, user adoption, and why
        they havent fully solved the problem." time="10:28 AM"}} <!-- Existing Alternatives Form -->
        {{#> form-card title="Existing Alternatives" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.existingAlternatives}} {{/form-card}}
        {{> section-complete buttonColor="blue" emoji="🎉" title="Section 1 Complete!" message="Great job exploring the
        problem you are solving. Now that we have a solid understanding of the challenge, are you ready to define your
        solution?" sectionName="Problem Validation" completedTopics="Completed: Problem Definition, Target Audience, Key
        Assumptions, Existing Alternatives" progressFraction="1/5" sections="completed" progressBars=progressBars1
        progressLabels=progressLabels1 nextTarget="2" currentTarget="1" isFinal=false}}
        <!-- Section 2: Solution Development -->
        {{> section-header id="section-2" number="2" title="Solution Development" description="Now that we understand
        the problem, lets define your solution. This section focuses on clearly articulating what youre building and
        how it works." topics="Solution Title, Solution Description" bgGradient="from-green-50 to-emerald-50
        dark:from-green-900/20 dark:to-emerald-900/20" border="border-green-200 dark:border-green-800"
        circleBg="bg-green-100 dark:bg-green-900/30" circleText="text-green-600 dark:text-green-400"
        titleText="text-green-900 dark:text-green-100" descText="text-green-800 dark:text-green-200"
        topicsText="text-green-700 dark:text-green-300"}}
        {{> ai-message title="Solution Title" message="Provide a clear, compelling title for your proposed solution.
        This should be concise yet descriptive, capturing the essence of what your product or service does and the value
        it provides. The title should be memorable and communicate the core benefit to potential users." time="10:28
        AM"}} <!-- Solution Title Form -->
        {{#> form-card title="Solution Title" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.solutionTitle}} {{/form-card}}
        {{> ai-message title="Solution Description" message="Provide a comprehensive description of your solution,
        explaining exactly how it works, its key features and capabilities, and how it specifically addresses the
        problem you identified. Include technical details if relevant, user workflows, and how it differs from existing
        alternatives. Be detailed enough that someone could understand the solution without prior knowledge."
        time="10:28 AM"}} <!-- Solution Description Form -->
        {{#> form-card title="Solution Description" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.solutionDescription}} {{/form-card}}
        {{> section-complete buttonColor="green" emoji="🚀" title="Section 2 Complete!" message="Excellent! Your
        solution is taking shape. Now let's build out the complete customer model to ensure your idea can succeed in the
        market." sectionName="Solution Development" completedTopics="Completed: Solution Title, Solution Description"
        progressFraction="2/5" sections="completed" progressBars=progressBars2 progressLabels=progressLabels2
        nextTarget=3 currentTarget=2 isFinal=false }}
        <!-- Section 3: Customer Model -->
        {{> section-header id="section-3" number="3" title="Customer Model" description="With a clear problem and
        solution defined, lets build out your customer model. This comprehensive section covers all aspects of how your
        customer will operate and succeed." topics="Target Customers, Key Metrics, Competitive Analysis, Unique Value
        Proposition, High-Level Concept, Unfair Advantage, Distribution Channels, Early Adopters, Customer
        Relationships" bgGradient="from-purple-50 to-violet-50 dark:from-purple-900/20 dark:to-violet-900/20"
        border="border-purple-200 dark:border-purple-800" circleBg="bg-purple-100 dark:bg-purple-900/30"
        circleText="text-purple-600 dark:text-purple-400" titleText="text-purple-900 dark:text-purple-100"
        descText="text-purple-800 dark:text-purple-200" topicsText="text-purple-700 dark:text-purple-300"}}
        {{> ai-message title="Target Customers" message="Define your ideal target customers in detail. Create detailed
        customer personas including demographics, psychographics, behaviors, needs, motivations, and pain points.
        Explain why these specific customers would be most likely to adopt your solution and how your product fits into
        their current workflows or lifestyles." time="10:28 AM"}} <!-- Target Customers Form -->
        {{#> form-card title="Target Customers" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.targetCustomers}} {{/form-card}}
        {{> ai-message title="Key Metrics" message="Identify the key performance indicators (KPIs) and metrics that will
        measure the success of your customer. Include metrics for customer acquisition, retention, revenue, user
        engagement, and product performance. Explain how youll track these metrics and what benchmarks indicate
        success." time="10:28 AM"}} <!-- Key Metrics Form -->
        {{#> form-card title="Key Metrics" alignRight=true}} {{> forms/_generic-form config=formConfigs.keyMetrics}}
        {{/form-card}}
        {{> ai-message title="Competitive Analysis" message="Create a comprehensive list of your direct and indirect
        competitors. For each competitor, analyze their market position, target customers, pricing strategy, key
        features, strengths, weaknesses, market share, and growth trajectory. Explain how your solution compares and
        what your competitive advantages are." time="10:28 AM"}} <!-- Competitive Analysis Form -->
        {{#> form-card title="Competitive Analysis" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.competitiveAnalysis}} {{/form-card}}
        {{> ai-message title="Unique Value Proposition" message="Articulate your unique value proposition (UVP) - the
        single most compelling reason why customers should choose your solution over competitors. Clearly state what
        makes your offering different and better, focusing on specific benefits and outcomes that matter most to your
        target customers." time="10:28 AM"}} <!-- Unique Value Proposition Form -->
        {{#> form-card title="Unique Value Proposition" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.uniqueValueProposition}} {{/form-card}}
        {{> ai-message title="High-Level Concept" message="Describe your solution at a high level, focusing on the core
        concept and how it fundamentally solves the customers problem. Explain the main idea in simple terms that
        anyone could understand, avoiding technical jargon. Include the primary mechanism through which value is
        delivered to users." time="10:28 AM"}} <!-- High-Level Concept Form -->
        {{#> form-card title="High-Level Concept" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.highLevelConcept}} {{/form-card}}
        {{> ai-message title="Unfair Advantage" message="Explain your unfair advantage - the unique assets,
        capabilities, or positioning that competitors cannot easily replicate. This could include proprietary
        technology, exclusive partnerships, first-mover advantage, network effects, or other barriers to entry that give
        you a sustainable competitive edge." time="10:28 AM"}} <!-- Unfair Advantage Form -->
        {{#> form-card title="Unfair Advantage" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.unfairAdvantage}} {{/form-card}}
        {{> ai-message title="Distribution Channels" message="Describe the channels and distribution strategies you will
        use to reach your target customers. Include both customer acquisition channels (how people will discover your
        product) and delivery channels (how they will access and use your solution). Explain your rationale for choosing
        these channels and how they align with customer preferences." time="10:28 AM"}}
        <!-- Distribution Channels Form -->
        {{#> form-card title="Distribution Channels" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.distributionChannels}} {{/form-card}}
        {{> ai-message title="Early Adopters" message="Identify your early adopters - the first customers who will try
        your product and provide feedback. Describe their characteristics, where to find them, what motivates them to
        try new solutions, and how they differ from your mainstream target customers. Explain how youll engage with
        them during the early stages." time="10:28 AM"}} <!-- Early Adopters Form -->
        {{#> form-card title="Early Adopters" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.earlyAdopters}} {{/form-card}}
        {{> ai-message title="Customer Relationships" message="Describe how you will establish and maintain
        relationships with your customers. Include your customer acquisition strategy, onboarding process, support
        mechanisms, communication channels, and retention tactics. Explain how youll build loyalty and encourage
        long-term engagement with your product or service." time="10:28 AM"}} <!-- Customer Relationships Form -->
        {{#> form-card title="Customer Relationships" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.customerRelationships}}
        {{/form-card}}
        {{> section-complete buttonColor="purple" emoji="💼" title="Section 3 Complete!" message="Outstanding work on
        your customer model! Your startup foundation is solid. Now let's create a compelling brand identity that will
        make you stand out." sectionName="Customer Model" completedTopics="Completed: Target Customers, Key Metrics,
        Competitive Analysis, Unique Value Proposition, High-Level Concept, Unfair Advantage, Distribution Channels,
        Early Adopters, Customer Relationships" progressFraction="3/5" sections="completed" progressBars=progressBars3
        progressLabels=progressLabels3 nextTarget="4" currentTarget="3" isFinal=false }}
        <!-- Section 4: Branding -->
        {{> section-header id="section-4" number="4" title="Branding" description="Your customer foundation is solid -
        now lets establish your brand identity. This section will help you create a memorable and consistent brand
        presence that resonates with your target customers." topics="Brand Identity, Brand Statement, Customer Name,
        Brand Slogan, Logo Design, Visual Language, Brand Voice, Brand Application, Brand Guidelines"
        bgGradient="from-orange-50 to-amber-50 dark:from-orange-900/20 dark:to-amber-900/20" border="border-orange-200
        dark:border-orange-800" circleBg="bg-orange-100 dark:bg-orange-900/30" circleText="text-orange-600
        dark:text-orange-400" titleText="text-orange-900 dark:text-orange-100" descText="text-orange-800
        dark:text-orange-200" topicsText="text-orange-700 dark:text-orange-300"}}
        {{> ai-message title="Brand Identity" message="Describe your brand identity, including your mission, vision,
        core values, personality, and positioning in the market. Explain what your brand stands for, how you want
        customers to perceive it, and how it differentiates you from competitors. Include details about your brand
        voice, tone, and visual identity elements." time="10:28 AM"}} <!-- Brand Identity Form -->
        {{#> form-card title="Brand Identity"}} {{> forms/_generic-form config=formConfigs.brandIdentity}}
        {{/form-card}}
        {{> ai-message title="Brand Statement" message="Craft a compelling brand statement that encapsulates your
        companys purpose, values, and unique position in the market. This should be a concise, memorable statement that
        communicates what you do, who you serve, and why you matter. It should inspire both customers and employees."
        time="10:28 AM"}} <!-- Brand Statement Form -->
        {{#> form-card title="Brand Statement" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.brandStatement}} {{/form-card}}
        {{> ai-message title="Customer Name" message="Provide your proposed customer name. Explain the reasoning behind
        your choice, including what the name represents, its memorability, availability (domain, trademarks), and how it
        aligns with your brand identity and target market. Consider cultural implications and pronunciation."
        time="10:28 AM"}} <!-- Customer Name Form -->
        {{#> form-card title="Customer Name"}} {{> forms/_generic-form config=formConfigs.customerName}} {{/form-card}}
        {{> ai-message title="Brand Slogan" message="Create a catchy, memorable slogan that captures the essence of your
        brand and value proposition. The slogan should be short, easy to remember, and effectively communicate your key
        benefit or unique selling point. Explain how it resonates with your target audience." time="10:28 AM"}}
        <!-- Brand Slogan Form -->
        {{#> form-card title="Brand Slogan" alignRight=true}} {{> forms/_generic-form config=formConfigs.brandSlogan}}
        {{/form-card}}
        {{> ai-message title="Logo Design" message="Upload your logo design files and provide details about your visual
        identity. Include the logo concept, color scheme, typography choices, and how it represents your brand values.
        Multiple file formats are supported for comprehensive logo presentation." time="10:28 AM"}}
        <div class="flex justify-end mb-4">
          <div class="bg-background rounded-2xl p-4 max-w-2xl border border-input/80 shadow-sm">
            <div class="flex items-start gap-3 mb-3 justify-end">
              <div class="flex-1 text-right">
                <div class="text-sm font-semibold text-foreground">You</div>
                <div class="text-xs text-muted-foreground">Responding</div>
                <div class="mt-2">
                  <h3 class="text-sm font-semibold text-primary bg-primary/10 rounded-md px-2 py-1 inline-block">Logo
                    Design</h3>
                </div>
              </div>
              <div class="flex-shrink-0">
                <div
                  class="w-8 h-8 rounded-md bg-primary flex items-center justify-center text-primary-foreground text-sm font-bold">
                  U</div>
              </div>
            </div>
            {{> forms/_generic-form config=formConfigs.logoDesign}}
          </div>
        </div>
        {{> ai-message title="Visual Language" message="Define your visual language elements that will be used
        consistently across all brand touchpoints. This includes color palettes, typography hierarchy, iconography,
        imagery style, and other visual elements that create a cohesive brand experience." time="10:28 AM"}}
        <div class="flex justify-end mb-4">
          <div class="bg-background rounded-2xl p-4 max-w-2xl border border-input/80 shadow-sm">
            <div class="flex items-start gap-3 mb-3 justify-end">
              <div class="flex-1 text-right">
                <div class="text-sm font-semibold text-foreground">You</div>
                <div class="text-xs text-muted-foreground">Responding</div>
                <div class="mt-2">
                  <h3 class="text-sm font-semibold text-primary bg-primary/10 rounded-md px-2 py-1 inline-block">Visual
                    Language</h3>
                </div>
              </div>
              <div class="flex-shrink-0">
                <div
                  class="w-8 h-8 rounded-md bg-primary flex items-center justify-center text-primary-foreground text-sm font-bold">
                  U</div>
              </div>
            </div>
            {{> forms/_generic-form config=formConfigs.visualLanguage}}
          </div>
        </div>
        {{> ai-message title="Brand Voice" message="Establish your brand voice and tone guidelines. Describe how your
        brand communicates - whether it's professional, friendly, authoritative, or conversational. Include examples of
        language to use and avoid, ensuring consistent messaging across all customer interactions." time="10:28 AM"}}
        <div class="flex justify-end mb-4">
          <div class="bg-background rounded-2xl p-4 max-w-2xl border border-input/80 shadow-sm">
            <div class="flex items-start gap-3 mb-3 justify-end">
              <div class="flex-1 text-right">
                <div class="text-sm font-semibold text-foreground">You</div>
                <div class="text-xs text-muted-foreground">Responding</div>
                <div class="mt-2">
                  <h3 class="text-sm font-semibold text-primary bg-primary/10 rounded-md px-2 py-1 inline-block">Brand
                    Voice</h3>
                </div>
              </div>
              <div class="flex-shrink-0">
                <div
                  class="w-8 h-8 rounded-md bg-primary flex items-center justify-center text-primary-foreground text-sm font-bold">
                  U</div>
              </div>
            </div>
            {{> forms/_generic-form config=formConfigs.brandVoice}}
          </div>
        </div>
        {{> ai-message title="Brand Guidelines" message="Create comprehensive brand guidelines that serve as the
        definitive reference for your brand identity. This document should cover all aspects of your brand including
        usage rules, do's and don'ts, application examples, and guidelines for maintaining brand consistency across
        different media and contexts." time="10:28 AM"}}
        <div class="flex justify-end mb-4">
          <div class="bg-background rounded-2xl p-4 max-w-2xl border border-input/80 shadow-sm">
            <div class="flex items-start gap-3 mb-3 justify-end">
              <div class="flex-1 text-right">
                <div class="text-sm font-semibold text-foreground">You</div>
                <div class="text-xs text-muted-foreground">Responding</div>
                <div class="mt-2">
                  <h3 class="text-sm font-semibold text-primary bg-primary/10 rounded-md px-2 py-1 inline-block">Brand
                    Guidelines</h3>
                </div>
              </div>
              <div class="flex-shrink-0">
                <div
                  class="w-8 h-8 rounded-md bg-primary flex items-center justify-center text-primary-foreground text-sm font-bold">
                  U</div>
              </div>
            </div>
            {{> forms/_generic-form config=formConfigs.brandGuidelines}}
          </div>
        </div>
        {{> section-complete buttonColor="orange" emoji="🎨" title="Section 4 Complete!" message="Your brand identity is
        taking shape beautifully! Almost there - let's protect your intellectual property to secure your competitive
        advantage." sectionName="Branding" completedTopics="Completed: Brand Identity, Brand Statement, Customer Name,
        Brand Slogan, Logo Design, Visual Language, Brand Voice, Brand Application, Brand Guidelines"
        progressFraction="4/5" sections="completed" progressBars=progressBars4 progressLabels=progressLabels4
        nextTarget="5" currentTarget="4" isFinal=false }}
        <!-- Section 5: IP Protection -->
        {{> section-header id="section-5" number="5" title="IP Protection" description="Finally, lets protect your
        intellectual property to safeguard your competitive advantage. This section ensures your ideas and assets are
        legally protected, giving you the security to build and scale your customer." topics="IP Protection Details,
        Domain Registration, IP Protection Elements, IP Documentation" bgGradient="from-red-50 to-rose-50
        dark:from-red-900/20 dark:to-rose-900/20" border="border-red-200 dark:border-red-800" circleBg="bg-red-100
        dark:bg-red-900/30" circleText="text-red-600 dark:text-red-400" titleText="text-red-900 dark:text-red-100"
        descText="text-red-800 dark:text-red-200" topicsText="text-red-700 dark:text-red-300"}}
        {{> ai-message title="IP Protection Details" message="Provide a detailed description of your intellectual
        property protection measures. Explain each type of IP protection youre using, the specific assets protected,
        filing dates and jurisdictions, protection duration, maintenance requirements, and how you plan to enforce your
        IP rights. Include any licenses, assignments, or other IP-related agreements." time="10:28 AM"}}
        <!-- IP Protection Details Form -->
        {{#> form-card title="IP Protection Details" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.ipProtectionDetails}} {{/form-card}}
        {{> ai-message title="Domain Registration" message="Describe your domain name registration strategy. Include the
        primary domain youve registered, alternative domains youve secured, registration details (registrar,
        registration date, expiration), and how your domain name strategy supports your branding and online presence.
        Explain any trademark considerations in domain selection." time="10:28 AM"}} <!-- Domain Registration Form -->
        {{#> form-card title="Domain Registration" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.domainRegistration}} {{/form-card}}
        {{> ai-message title="IP Protection Elements" message="Detail the specific elements of your intellectual
        property that youre protecting. For each element, explain what it is, why its valuable, how its protected
        (patent, copyright, trademark, etc.), and how it contributes to your competitive advantage. Include both
        registered and unregistered IP elements." time="10:28 AM"}} <!-- IP Protection Elements Form -->
        {{#> form-card title="IP Protection Elements" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.ipProtectionElements}}
        {{/form-card}}
        {{> ai-message title="IP Documentation" message="Upload all relevant legal documents that support your
        intellectual property protection strategy. Include patent filings, trademark certificates, copyright
        registrations, licensing agreements, non-disclosure agreements, and any other documentation that proves your IP
        ownership and protection measures. These documents will validate your IP claims and strengthen your startup's
        legal foundation." time="10:28 AM"}}
        {{#> form-card title="IP Documentation" alignRight=true}} {{> forms/_generic-form
        config=formConfigs.ipDocumentation}} {{/form-card}}
        {{> section-complete buttonColor="red" emoji="🎉" title="Congratulations! All Sections Complete!"
        message="You've successfully completed the comprehensive Idea Model validation process! Your startup idea now
        has a solid foundation with a validated problem, defined solution, customer model, brand identity, and IP
        protection strategy." sectionName="Complete Idea Model" completedTopics="Validated: Problem, Solution, Customer
        Model, Branding, IP Protection" progressFraction="5/5" sections="completed" progressBars=progressBars5
        progressLabels=progressLabels5 nextTarget="" currentTarget="5" isFinal=true }}
      </div>
    </div>
{{> chat-input}}
  </div>

</div>