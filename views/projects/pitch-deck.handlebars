<!-- Pitch Deck Page -->
<div class="min-h-screen bg-background">
<div id="pitch-deck-main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="flex flex-col gap-4 lg:gap-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-foreground">Pitch Deck</h1>
      <p class="text-base text-muted-foreground">Create compelling presentations to attract investors.</p>
    </div>
  </div>

    <!-- Model Overview -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">How It Works</h3>
          <p class="text-sm text-muted-foreground mb-4">Our pitch deck builder helps you create professional presentations that effectively communicate your business story to investors.</p>
          <ul class="space-y-2 text-sm">
             <li class="flex items-center gap-2">
{{{icon 'presentation' size="16" class="w-4 h-4 text-primary"}}}
               Story structure
             </li>
             <li class="flex items-center gap-2">
{{{icon 'bar-chart' size="16" class="w-4 h-4 text-primary"}}}
               Data visualization
             </li>
             <li class="flex items-center gap-2">
{{{icon 'target' size="16" class="w-4 h-4 text-primary"}}}
               Value proposition
             </li>
             <li class="flex items-center gap-2">
{{{icon 'trending-up' size="16" class="w-4 h-4 text-primary"}}}
               Growth projections
             </li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">Key Features</h3>
          <div class="space-y-3">
            <div class="p-3 bg-primary/10 rounded-lg">
              <h4 class="font-medium text-primary mb-1">Template Library</h4>
              <p class="text-xs text-primary/80">Professional templates for different industries.</p>
            </div>
            <div class="p-3 bg-secondary/10 rounded-lg">
              <h4 class="font-medium text-secondary mb-1">Real-time Collaboration</h4>
              <p class="text-xs text-secondary/80">Work with your team on pitch deck creation.</p>
            </div>
            <div class="p-3 bg-success/10 rounded-lg">
              <h4 class="font-medium text-success mb-1">Investor Feedback</h4>
              <p class="text-xs text-success/80">Get feedback from potential investors.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pitch Deck Structure -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <h3 class="text-xl font-semibold text-foreground mb-4">Standard Pitch Deck Structure</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-primary font-bold">1</span>
          </div>
          <h4 class="font-medium text-foreground mb-2">Problem</h4>
          <p class="text-sm text-muted-foreground">Define the problem you're solving.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-secondary font-bold">2</span>
          </div>
          <h4 class="font-medium text-foreground mb-2">Solution</h4>
          <p class="text-sm text-muted-foreground">Present your unique solution.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-success/20 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-success font-bold">3</span>
          </div>
          <h4 class="font-medium text-foreground mb-2">Market</h4>
          <p class="text-sm text-muted-foreground">Show market opportunity and size.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-warning/20 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-warning font-bold">4</span>
          </div>
          <h4 class="font-medium text-foreground mb-2">Traction</h4>
          <p class="text-sm text-muted-foreground">Demonstrate progress and validation.</p>
        </div>
      </div>
    </div>

    <!-- Try It Out -->
    <div class="rounded-lg bg-primary/10 px-6 py-5 text-card-foreground">
      <div class="text-center">
        <h3 class="text-lg font-medium text-foreground mb-2">Ready to Create Your Pitch Deck?</h3>
        <p class="text-sm text-muted-foreground mb-4">Build a compelling presentation to attract investors.</p>
        <a href="/startup-dashboard/fund-pitch-deck" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
{{{icon 'presentation' size="16" class="w-4 h-4 mr-2"}}}
          Build Pitch Deck
        </a>
      </div>
    </div>
  </div>
