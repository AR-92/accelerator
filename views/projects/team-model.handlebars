<!-- Team Model Page -->
<div class="min-h-screen bg-background">
<div id="team-model-main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="flex flex-col gap-4 lg:gap-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-foreground">Team Model</h1>
      <p class="text-base text-muted-foreground">Build and manage your startup team structure.</p>
    </div>
  </div>

    <!-- Model Overview -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">How It Works</h3>
          <p class="text-sm text-muted-foreground mb-4">Our team model helps you define roles, assess skills gaps, and create a hiring plan for your startup's growth.</p>
          <ul class="space-y-2 text-sm">
             <li class="flex items-center gap-2">
{{{icon 'users' size="16" class="w-4 h-4 text-primary"}}}
               Role definition
             </li>
             <li class="flex items-center gap-2">
{{{icon 'user-check' size="16" class="w-4 h-4 text-primary"}}}
               Skills assessment
             </li>
             <li class="flex items-center gap-2">
{{{icon 'calendar' size="16" class="w-4 h-4 text-primary"}}}
               Hiring timeline
             </li>
             <li class="flex items-center gap-2">
{{{icon 'award' size="16" class="w-4 h-4 text-primary"}}}
               Compensation planning
             </li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">Key Features</h3>
          <div class="space-y-3">
            <div class="p-3 bg-primary/10 rounded-lg">
              <h4 class="font-medium text-primary mb-1">Org Chart Builder</h4>
              <p class="text-xs text-primary/80">Visualize your team structure and reporting lines.</p>
            </div>
            <div class="p-3 bg-secondary/10 rounded-lg">
              <h4 class="font-medium text-secondary mb-1">Candidate Matching</h4>
              <p class="text-xs text-secondary/80">Find candidates with the right skills and experience.</p>
            </div>
            <div class="p-3 bg-success/10 rounded-lg">
              <h4 class="font-medium text-success mb-1">Performance Tracking</h4>
              <p class="text-xs text-success/80">Monitor team productivity and goal achievement.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Team Roles -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <h3 class="text-xl font-semibold text-foreground mb-4">Core Team Roles</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'crown' size="20" class="w-5 h-5 text-primary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Founder/CEO</h4>
          <p class="text-sm text-muted-foreground">Vision and strategic direction.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'code' size="20" class="w-5 h-5 text-secondary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Technical Lead</h4>
          <p class="text-sm text-muted-foreground">Product development and engineering.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-success/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'megaphone' size="20" class="w-5 h-5 text-success"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Marketing Lead</h4>
          <p class="text-sm text-muted-foreground">Customer acquisition and branding.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-warning/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'dollar-sign' size="20" class="w-5 h-5 text-warning"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Operations Lead</h4>
          <p class="text-sm text-muted-foreground">Business operations and finance.</p>
        </div>
      </div>
    </div>

    <!-- Try It Out -->
    <div class="rounded-lg bg-primary/10 px-6 py-5 text-card-foreground">
      <div class="text-center">
        <h3 class="text-lg font-medium text-foreground mb-2">Ready to Build Your Team?</h3>
        <p class="text-sm text-muted-foreground mb-4">Create a strong foundation with the right team structure.</p>
        <a href="/startup-dashboard/team" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
{{{icon 'users' size="16" class="w-4 h-4 mr-2"}}}
          Build Team Structure
        </a>
      </div>
    </div>
  </div>
</div>
</div>