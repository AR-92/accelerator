<!-- Funding Model Page -->
<div class="min-h-screen bg-background">
<div id="funding-model-main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="flex flex-col gap-4 lg:gap-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-foreground">Funding Model</h1>
      <p class="text-base text-muted-foreground">Plan your funding strategy and capital requirements.</p>
    </div>
  </div>

    <!-- Model Overview -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">How It Works</h3>
          <p class="text-sm text-muted-foreground mb-4">Our funding model helps you determine capital needs, explore funding options, and create compelling pitches for investors.</p>
          <ul class="space-y-2 text-sm">
             <li class="flex items-center gap-2">
{{{icon 'target' size="16" class="w-4 h-4 text-primary"}}}
               Capital requirements analysis
             </li>
             <li class="flex items-center gap-2">
{{{icon 'users' size="16" class="w-4 h-4 text-primary"}}}
               Investor targeting
             </li>
             <li class="flex items-center gap-2">
{{{icon 'file-text' size="16" class="w-4 h-4 text-primary"}}}
               Funding strategy planning
             </li>
             <li class="flex items-center gap-2">
{{{icon 'trending-up' size="16" class="w-4 h-4 text-primary"}}}
               Dilution modeling
             </li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">Key Features</h3>
          <div class="space-y-3">
            <div class="p-3 bg-primary/10 rounded-lg">
              <h4 class="font-medium text-primary mb-1">Funding Roadmap</h4>
              <p class="text-xs text-primary/80">Create a timeline for funding milestones.</p>
            </div>
            <div class="p-3 bg-secondary/10 rounded-lg">
              <h4 class="font-medium text-secondary mb-1">Investor Matching</h4>
              <p class="text-xs text-secondary/80">Find suitable investors based on your profile.</p>
            </div>
            <div class="p-3 bg-success/10 rounded-lg">
              <h4 class="font-medium text-success mb-1">Term Sheet Analysis</h4>
              <p class="text-xs text-success/80">Understand and negotiate funding terms.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Funding Types -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <h3 class="text-xl font-semibold text-foreground mb-4">Funding Options</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'user' size="20" class="w-5 h-5 text-primary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Bootstrapping</h4>
          <p class="text-sm text-muted-foreground">Self-funding your business growth.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'users' size="20" class="w-5 h-5 text-secondary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Angel Investors</h4>
          <p class="text-sm text-muted-foreground">Individual investors providing capital.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-success/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'building' size="20" class="w-5 h-5 text-success"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Venture Capital</h4>
          <p class="text-sm text-muted-foreground">Institutional funding for growth.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-warning/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'globe' size="20" class="w-5 h-5 text-warning"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Crowdfunding</h4>
          <p class="text-sm text-muted-foreground">Raise funds from the public.</p>
        </div>
      </div>
    </div>

    <!-- Try It Out -->
    <div class="rounded-lg bg-primary/10 px-6 py-5 text-card-foreground">
      <div class="text-center">
        <h3 class="text-lg font-medium text-foreground mb-2">Ready to Plan Your Funding?</h3>
        <p class="text-sm text-muted-foreground mb-4">Develop a comprehensive funding strategy for your startup.</p>
        <a href="/startup-dashboard/fund" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
{{{icon 'target' size="16" class="w-4 h-4 mr-2"}}}
          Plan Funding Strategy
        </a>
      </div>
    </div>
  </div>
</div>
</div>