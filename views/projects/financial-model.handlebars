<!-- Financial Model Page -->
<div class="min-h-screen bg-background">
<div id="financial-model-main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="flex flex-col gap-4 lg:gap-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-foreground">Financial Model</h1>
      <p class="text-base text-muted-foreground">Build and analyze your financial projections.</p>
    </div>
  </div>

    <!-- Model Overview -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">How It Works</h3>
          <p class="text-sm text-muted-foreground mb-4">Our financial model helps you create detailed projections for revenue, expenses, cash flow, and profitability to guide your business decisions.</p>
          <ul class="space-y-2 text-sm">
             <li class="flex items-center gap-2">
{{{icon 'calculator' size="16" class="w-4 h-4 text-primary"}}}
               Revenue forecasting
             </li>
             <li class="flex items-center gap-2">
{{{icon 'trending-up' size="16" class="w-4 h-4 text-primary"}}}
               Expense tracking
             </li>
             <li class="flex items-center gap-2">
{{{icon 'dollar-sign' size="16" class="w-4 h-4 text-primary"}}}
               Cash flow analysis
             </li>
             <li class="flex items-center gap-2">
{{{icon 'bar-chart' size="16" class="w-4 h-4 text-primary"}}}
               Profitability metrics
             </li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">Key Features</h3>
          <div class="space-y-3">
            <div class="p-3 bg-primary/10 rounded-lg">
              <h4 class="font-medium text-primary mb-1">Scenario Planning</h4>
              <p class="text-xs text-primary/80">Model different growth scenarios and market conditions.</p>
            </div>
            <div class="p-3 bg-secondary/10 rounded-lg">
              <h4 class="font-medium text-secondary mb-1">Automated Calculations</h4>
              <p class="text-xs text-secondary/80">Real-time calculations for all financial metrics.</p>
            </div>
            <div class="p-3 bg-success/10 rounded-lg">
              <h4 class="font-medium text-success mb-1">Visual Dashboards</h4>
              <p class="text-xs text-success/80">Interactive charts and graphs for easy analysis.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Model Components -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <h3 class="text-xl font-semibold text-foreground mb-4">Financial Components</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'dollar-sign' size="20" class="w-5 h-5 text-primary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Revenue Model</h4>
          <p class="text-sm text-muted-foreground">Define pricing strategies and revenue streams.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'minus' size="20" class="w-5 h-5 text-secondary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Cost Structure</h4>
          <p class="text-sm text-muted-foreground">Track fixed and variable expenses.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-success/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'activity' size="20" class="w-5 h-5 text-success"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Cash Flow</h4>
          <p class="text-sm text-muted-foreground">Monitor cash inflows and outflows.</p>
        </div>
      </div>
    </div>

    <!-- Try It Out -->
    <div class="rounded-lg bg-primary/10 px-6 py-5 text-card-foreground">
      <div class="text-center">
        <h3 class="text-lg font-medium text-foreground mb-2">Ready to Build Your Financial Model?</h3>
        <p class="text-sm text-muted-foreground mb-4">Create detailed financial projections for your business.</p>
        <a href="/startup-dashboard/financial" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
{{{icon 'calculator' size="16" class="w-4 h-4 mr-2"}}}
          Build Financial Model
        </a>
      </div>
    </div>
  </div>
</div>
</div>