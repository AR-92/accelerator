<!-- Valuation Page -->
<div class="min-h-screen bg-background">
<div id="valuation-main-content" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full">
        <div class="flex flex-col gap-4 lg:gap-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold text-foreground">Valuation</h1>
      <p class="text-base text-muted-foreground">Determine the economic value of your startup.</p>
    </div>
  </div>

    <!-- Model Overview -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">How It Works</h3>
          <p class="text-sm text-muted-foreground mb-4">Our valuation tools help you calculate your startup's worth using multiple methodologies for fundraising and exit planning.</p>
          <ul class="space-y-2 text-sm">
             <li class="flex items-center gap-2">
{{{icon 'calculator' size="16" class="w-4 h-4 text-primary"}}}
               DCF analysis
             </li>
             <li class="flex items-center gap-2">
{{{icon 'trending-up' size="16" class="w-4 h-4 text-primary"}}}
               Comparable transactions
             </li>
             <li class="flex items-center gap-2">
{{{icon 'users' size="16" class="w-4 h-4 text-primary"}}}
               Venture capital method
             </li>
             <li class="flex items-center gap-2">
{{{icon 'bar-chart' size="16" class="w-4 h-4 text-primary"}}}
               Market multiples
             </li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-medium text-foreground mb-3">Key Features</h3>
          <div class="space-y-3">
            <div class="p-3 bg-primary/10 rounded-lg">
              <h4 class="font-medium text-primary mb-1">Multi-Method Approach</h4>
              <p class="text-xs text-primary/80">Use multiple valuation methods for comprehensive analysis.</p>
            </div>
            <div class="p-3 bg-secondary/10 rounded-lg">
              <h4 class="font-medium text-secondary mb-1">Sensitivity Analysis</h4>
              <p class="text-xs text-secondary/80">Test different scenarios and assumptions.</p>
            </div>
            <div class="p-3 bg-success/10 rounded-lg">
              <h4 class="font-medium text-success mb-1">Benchmarking</h4>
              <p class="text-xs text-success/80">Compare against similar companies and deals.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Valuation Methods -->
    <div class="rounded-lg bg-card px-6 py-5 text-card-foreground">
      <h3 class="text-xl font-semibold text-foreground mb-4">Valuation Methodologies</h3>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'dollar-sign' size="20" class="w-5 h-5 text-primary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Asset-Based</h4>
          <p class="text-sm text-muted-foreground">Value based on company assets and liabilities.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-secondary/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'trending-up' size="20" class="w-5 h-5 text-secondary"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Income-Based</h4>
          <p class="text-sm text-muted-foreground">Value based on future earnings potential.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-success/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'users' size="20" class="w-5 h-5 text-success"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Market-Based</h4>
          <p class="text-sm text-muted-foreground">Value based on comparable company transactions.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-warning/20 rounded-full flex items-center justify-center mx-auto mb-3">
{{{icon 'target' size="20" class="w-5 h-5 text-warning"}}}
          </div>
          <h4 class="font-medium text-foreground mb-2">Option-Based</h4>
          <p class="text-sm text-muted-foreground">Value based on real options and strategic value.</p>
        </div>
      </div>
    </div>

    <!-- Try It Out -->
    <div class="rounded-lg bg-primary/10 px-6 py-5 text-card-foreground">
      <div class="text-center">
        <h3 class="text-lg font-medium text-foreground mb-2">Ready to Calculate Your Valuation?</h3>
        <p class="text-sm text-muted-foreground mb-4">Determine the economic value of your startup using professional methodologies.</p>
        <a href="/startup-dashboard/valuation" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
{{{icon 'calculator' size="16" class="w-4 h-4 mr-2"}}}
          Calculate Valuation
        </a>
      </div>
    </div>
  </div>
</div>
</div>