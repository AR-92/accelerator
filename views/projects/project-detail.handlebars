<main class="flex w-full flex-col p-4 mx-auto max-w-7xl">
  <!-- Header -->
  <header class="w-full mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-sans font-medium text-foreground mb-2">
          {{project.name}}
        </h1>
        <p class="text-muted-foreground">
          {{project.description}}
        </p>
      </div>
      <div class="flex items-center gap-4">
        <span
          class="text-sm px-3 py-1 rounded-md bg-{{#if (eq project.status 'completed')}}green{{else if (eq project.status 'in_progress')}}blue{{else}}gray{{/if}}-100 text-{{#if (eq project.status 'completed')}}green{{else if (eq project.status 'in_progress')}}blue{{else}}gray{{/if}}-800">
          {{project.status}}
        </span>
        <span class="text-sm text-muted-foreground">
          Progress: {{project.progress}}%
        </span>
      </div>
    </div>
  </header>

  <!-- Progress Bar -->
  <section class="mb-8">
    <div class="bg-card border border-input/80 rounded-md p-6">
      <div class="flex justify-between text-sm text-muted-foreground mb-2">
        <span>Overall Progress</span>
        <span>{{project.progress}}%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-md h-3">
        <div class="bg-primary h-3 rounded-md transition-all duration-300" style="width: {{project.progress}}%"></div>
      </div>
    </div>
  </section>

  <!-- Quick Actions -->
  {{#if quickActions}}
  <section class="mb-8">
    <h2 class="text-xl font-medium mb-4">Quick Actions</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {{#each quickActions}}
      <a href="{{this.href}}"
        class="bg-card border border-input/80 rounded-md p-4 hover:bg-accent transition-colors block">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M{{this.icon}}"></path>
          </svg>
          <span class="font-medium">{{this.text}}</span>
        </div>
      </a>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- Project Details Grid -->
  <section class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8 mb-8">
    <!-- Idea Model -->
    <div class="bg-card border border-input/80 rounded-md p-6">
      <h3 class="text-lg font-medium mb-4">Idea Model</h3>
      {{#if project.idea_model}}
      <p class="text-muted-foreground">{{project.idea_model}}</p>
      {{else}}
      <p class="text-muted-foreground italic">Not defined yet</p>
      <a href="/projects/idea-model" class="text-primary hover:underline text-sm mt-2 inline-block">
        Define Idea Model →
      </a>
      {{/if}}
    </div>

    <!-- Business Model -->
    <div class="bg-card border border-input/80 rounded-md p-6">
      <h3 class="text-lg font-medium mb-4">Business Model</h3>
      {{#if project.business_model}}
      <p class="text-muted-foreground">{{project.business_model}}</p>
      {{else}}
      <p class="text-muted-foreground italic">Not defined yet</p>
      <a href="/projects/business-model" class="text-primary hover:underline text-sm mt-2 inline-block">
        Define Business Model →
      </a>
      {{/if}}
    </div>



    <!-- Financial Model -->
    <div class="bg-card border border-input/80 rounded-md p-6">
      <h3 class="text-lg font-medium mb-4">Financial Model</h3>
      {{#if project.financial_model}}
      <p class="text-muted-foreground">{{project.financial_model}}</p>
      {{else}}
      <p class="text-muted-foreground italic">Not defined yet</p>
      <a href="/projects/financial-model" class="text-primary hover:underline text-sm mt-2 inline-block">
        Define Financial Model →
      </a>
      {{/if}}
    </div>

    <!-- Funding Model -->
    <div class="bg-card border border-input/80 rounded-md p-6">
      <h3 class="text-lg font-medium mb-4">Funding Model</h3>
      {{#if project.funding_model}}
      <p class="text-muted-foreground">{{project.funding_model}}</p>
      {{else}}
      <p class="text-muted-foreground italic">Not defined yet</p>
      <a href="/projects/funding-model" class="text-primary hover:underline text-sm mt-2 inline-block">
        Define Funding Model →
      </a>
      {{/if}}
    </div>

    <!-- Legal Model -->
    <div class="bg-card border border-input/80 rounded-md p-6">
      <h3 class="text-lg font-medium mb-4">Legal Model</h3>
      {{#if project.legal_model}}
      <p class="text-muted-foreground">{{project.legal_model}}</p>
      {{else}}
      <p class="text-muted-foreground italic">Not defined yet</p>
      <a href="/projects/legal-model" class="text-primary hover:underline text-sm mt-2 inline-block">
        Define Legal Model →
      </a>
      {{/if}}
    </div>

    <!-- Marketing Model -->
    <div class="bg-card border border-input/80 rounded-md p-6">
      <h3 class="text-lg font-medium mb-4">Marketing Model</h3>
      {{#if project.marketing_model}}
      <p class="text-muted-foreground">{{project.marketing_model}}</p>
      {{else}}
      <p class="text-muted-foreground italic">Not defined yet</p>
      <a href="/projects/marketing-model" class="text-primary hover:underline text-sm mt-2 inline-block">
        Define Marketing Model →
      </a>
      {{/if}}
    </div>



    <!-- Team Model -->
    <div class="bg-card border border-input/80 rounded-md p-6">
      <h3 class="text-lg font-medium mb-4">Team Model</h3>
      {{#if project.team_model}}
      <p class="text-muted-foreground">{{project.team_model}}</p>
      {{else}}
      <p class="text-muted-foreground italic">Not defined yet</p>
      <a href="/projects/team-model" class="text-primary hover:underline text-sm mt-2 inline-block">
        Define Team Model →
      </a>
      {{/if}}
    </div>


  </section>

  <!-- Tasks Section -->
  {{#if project.tasks}}
  <section class="mb-8">
    <h2 class="text-xl font-medium mb-4">Tasks</h2>
    <div class="bg-card border border-input/80 rounded-md p-6">
      <div class="space-y-3">
        {{#each project.tasks}}
        <div class="flex items-center justify-between p-3 bg-accent/50 rounded-md">
          <div class="flex items-center gap-3">
            <input type="checkbox" {{#if this.completed}}checked{{/if}} disabled class="rounded">
            <span class="{{#if this.completed}}line-through text-muted-foreground{{/if}}">{{this.title}}</span>
          </div>
          <span
            class="text-xs px-2 py-1 rounded-md bg-{{#if (eq this.priority 'high')}}red{{else if (eq this.priority 'medium')}}yellow{{else}}green{{/if}}-100 text-{{#if (eq this.priority 'high')}}red{{else if (eq this.priority 'medium')}}yellow{{else}}green{{/if}}-800">
            {{this.priority}}
          </span>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Team Section -->
  {{#if project.team}}
  <section class="mb-8">
    <h2 class="text-xl font-medium mb-4">Team Members</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {{#each project.team}}
      <div class="bg-card border border-input/80 rounded-md p-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-primary/10 rounded-md flex items-center justify-center">
            <span class="text-primary font-semibold">{{this.name.charAt 0}}</span>
          </div>
          <div>
            <p class="font-medium">{{this.name}}</p>
            <p class="text-sm text-muted-foreground">{{this.email}}</p>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <!-- Back to All Projects -->
  <section class="mt-8">
    <a href="/projects/all-projects" class="inline-flex items-center text-primary hover:underline">
      ← Back to All Projects
    </a>
  </section>
</main>