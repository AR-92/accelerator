<script>
  // Check for toast messages from query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const error = urlParams.get('error');
  const success = urlParams.get('success');

  if (error) {
    let message = 'An error occurred while creating your idea.';
    switch (error) {
      case 'auth_required':
        message = 'You must be logged in to create an idea.';
        break;
      case 'config_error':
        message = 'Configuration error. Please try again later.';
        break;
      case 'no_token':
        message = 'Authentication token not found. Please log in again.';
        break;
      case 'invalid_token':
        message = 'Your session has expired. Please log in again.';
        break;
      case 'creation_failed':
        message = 'Failed to create idea. Please try again.';
        break;
    }
    if (typeof showToast !== 'undefined') {
      showToast(message, 'error');
    }
  }

  if (success === 'idea_created') {
    if (typeof showToast !== 'undefined') {
      showToast('Idea created successfully!', 'success');
    }
  }

  // Clean up URL by removing query parameters
  if (error || success) {
    const url = new URL(window.location);
    url.searchParams.delete('error');
    url.searchParams.delete('success');
    window.history.replaceState({}, '', url);
  }


</script>