<main class="flex flex-col w-full items-center justify-center">

   {{#if showCreateCard}}
   <div id="create-idea-section">
     {{> create-idea-card showExplore=(eq ideas.length 0) hasIdeas=(gt ideas.length 0) populateIdea=populateIdea}}
   </div>
   {{/if}}

  <!-- Ideas Grid Section -->
   <div id="main-main-content">
     {{> admin/new-project-content}}
   </div>
</main>

<script>
  // Check for toast messages from query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const error = urlParams.get('error');
  const success = urlParams.get('success');

  if (error) {
    let message = 'An error occurred while creating your idea.';
    switch (error) {
      case 'auth_required':
        message = 'You must be logged in to create an idea.';
        break;
      case 'config_error':
        message = 'Configuration error. Please try again later.';
        break;
      case 'no_token':
        message = 'Authentication token not found. Please log in again.';
        break;
      case 'invalid_token':
        message = 'Your session has expired. Please log in again.';
        break;
      case 'creation_failed':
        message = 'Failed to create idea. Please try again.';
        break;
    }
    if (typeof showToast !== 'undefined') {
      showToast(message, 'error');
    }
  }

  if (success === 'idea_created') {
    if (typeof showToast !== 'undefined') {
      showToast('Idea created successfully!', 'success');
    }
  }

  // Clean up URL by removing query parameters
  if (error || success) {
    const url = new URL(window.location);
    url.searchParams.delete('error');
    url.searchParams.delete('success');
    window.history.replaceState({}, '', url);
  }

   // Prevent link navigation when clicking buttons
   document.querySelectorAll('.group-item-btns').forEach(link => {
     link.addEventListener('click', (e) => {
       if (e.target.closest('button')) {
         e.preventDefault();
         e.stopPropagation();
       }
     });
   });

   // Hide create idea section when filtering
   document.addEventListener('htmx:afterSwap', function(evt) {
     if (evt.detail.target.id === 'main-main-content') {
       const createSection = document.getElementById('create-idea-section');
       if (createSection) {
         createSection.style.display = 'none';
       }
     }
   });

  // Handle publish/unpublish and favorite/unfavorite buttons
  document.querySelectorAll('.group-item-btns button').forEach(btn => {
    const icon = btn.querySelector('svg');
    if (icon && icon.classList.contains('lucide-heart')) {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('a');
        const id = card.getAttribute('data-id') || card.href.split('/').pop() || '1'; // Use actual ID if available
        const isCurrentlyFavorite = icon.classList.contains('fill-red-500');

        try {
          const endpoint = isCurrentlyFavorite ? 'unfavorite' : 'favorite';
          const response = await fetch(`/admin/ideas/${id}/${endpoint}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          if (response.ok) {
            // Toggle the heart icon
            if (isCurrentlyFavorite) {
              icon.classList.remove('fill-red-500', 'text-red-500');
              icon.classList.add('text-muted-foreground');
            } else {
              icon.classList.remove('text-muted-foreground');
              icon.classList.add('fill-red-500', 'text-red-500');
            }

            if (typeof showToast !== 'undefined') {
              showToast(`Idea ${isCurrentlyFavorite ? 'unfavorited' : 'favorited'} successfully`, 'success');
            }
          } else {
            if (typeof showToast !== 'undefined') {
              showToast(`Failed to ${isCurrentlyFavorite ? 'unfavorite' : 'favorite'} idea`, 'error');
            }
          }
        } catch (error) {
          if (typeof showToast !== 'undefined') {
            showToast(`Error ${isCurrentlyFavorite ? 'unfavoriting' : 'favoriting'} idea`, 'error');
          }
        }
      });
    } else if (btn.classList.contains('publish-btn')) {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('a');
        const id = card.getAttribute('data-id') || card.href.split('/').pop() || '1';
        try {
          const response = await fetch(`/admin/ideas/${id}/publish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          if (response.ok) {
            if (typeof showToast !== 'undefined') {
              showToast('Idea published successfully', 'success');
            }
            // Reload to update the UI
            setTimeout(() => window.location.reload(), 1000);
          } else {
            if (typeof showToast !== 'undefined') {
              showToast('Failed to publish idea', 'error');
            }
          }
        } catch (error) {
          if (typeof showToast !== 'undefined') {
            showToast('Error publishing idea', 'error');
          }
        }
      });
    } else if (btn.classList.contains('unpublish-btn')) {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('a');
        const id = card.getAttribute('data-id') || card.href.split('/').pop() || '1';
        try {
          const response = await fetch(`/admin/ideas/${id}/unpublish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          if (response.ok) {
            if (typeof showToast !== 'undefined') {
              showToast('Idea unpublished successfully', 'success');
            }
            // Reload to update the UI
            setTimeout(() => window.location.reload(), 1000);
          } else {
            if (typeof showToast !== 'undefined') {
              showToast('Failed to unpublish idea', 'error');
            }
          }
        } catch (error) {
          if (typeof showToast !== 'undefined') {
            showToast('Error unpublishing idea', 'error');
          }
        }
      });
    } else if (btn.classList.contains('archive-btn')) {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('a');
        const id = card.getAttribute('data-id') || card.href.split('/').pop() || '1';
        try {
          const response = await fetch(`/admin/ideas/${id}/archive`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          if (response.ok) {
            if (typeof showToast !== 'undefined') {
              showToast('Idea archived successfully', 'success');
            }
          } else {
            if (typeof showToast !== 'undefined') {
              showToast('Failed to archive idea', 'error');
            }
          }
        } catch (error) {
          if (typeof showToast !== 'undefined') {
            showToast('Error archiving idea', 'error');
          }
        }
      });
    } else if (icon && icon.classList.contains('lucide-rotate-ccw')) {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('a');
        const id = card.getAttribute('data-id') || card.href.split('/').pop() || '1'; // Use actual ID if available
        try {
          const response = await fetch(`/admin/ideas/${id}/unarchive`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          if (response.ok) {
            if (typeof showToast !== 'undefined') {
              showToast('Idea unarchived successfully', 'success');
            }
            // Optionally reload the page or update the UI
            setTimeout(() => window.location.reload(), 1000);
          } else {
            if (typeof showToast !== 'undefined') {
              showToast('Failed to unarchive idea', 'error');
            }
          }
        } catch (error) {
          if (typeof showToast !== 'undefined') {
            showToast('Error unarchiving idea', 'error');
          }
        }
      });
    } else if (btn.classList.contains('delete-btn')) {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = btn.closest('a');
        const id = card.getAttribute('data-id') || card.href.split('/').pop() || '1';

        const deleteIdea = async () => {
          try {
            const response = await fetch(`/admin/ideas/${id}`, {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' }
            });
            if (response.ok) {
              if (typeof showToast !== 'undefined') {
                showToast('Idea deleted successfully', 'success');
              }
              // Remove the card from the UI
              card.remove();
            } else {
              if (typeof showToast !== 'undefined') {
                showToast('Failed to delete idea', 'error');
              }
            }
          } catch (error) {
            if (typeof showToast !== 'undefined') {
              showToast('Error deleting idea', 'error');
            }
          }
        };

        if (typeof showToast !== 'undefined') {
          showToast('Delete this idea permanently?', 'warning', {
            confirmText: 'Delete',
            cancelText: 'Cancel',
            onConfirm: deleteIdea,
            persistent: true
          });
        }
      });
    }
   });

   // Handle populate idea button
   window.redirectToPopulate = function(id) {
     window.location.href = '/admin/other-pages/new-project?showCard=true&populate=' + id;
   };

 </script>