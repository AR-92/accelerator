  {{> sidebar-item href=href title=text page=text text=text spanClass="font-medium sidebar-text" icon=icon }}
  {{/each}}
  {{> sidebar-item href="/admin/other-pages/new-project" title="New Project" text="New Project" spanClass="font-medium sidebar-text" icon='plus' }}
  {{> sidebar-item href="/admin/other-pages/explore-ideas" title="Explore Ideas" text="Explore Ideas" spanClass="font-medium sidebar-text" icon='lightbulb' }}
