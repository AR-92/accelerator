<!-- Sidebar -->
  <div id="sidebar" class="w-56 transition-all duration-300 bg-card border border-border fixed md:relative inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 opacity-0 md:opacity-100 pointer-events-none md:pointer-events-auto flex flex-col h-[calc(100vh-90px)]">
    <div class="flex-1 overflow-y-auto">
      <nav class="px-3 py-3 text-sm">
