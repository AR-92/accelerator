          <ul class="space-y-1 border-b border-border pb-2 mb-2 md:hidden">
             {{> sidebar-item href="/admin/other-pages/dashboard" title="Dashboard" text="Dashboard" spanClass="font-medium sidebar-text" icon='bar-chart' }}
             {{> sidebar-item href="/admin/other-pages/portfolio" title="Portfolio" text="Portfolio" spanClass="font-medium sidebar-text" icon='briefcase' }}
              {{> sidebar-item href="/admin/other-pages/collaborate" title="Collaborate" text="Collaborate" spanClass="font-medium sidebar-text" icon='users' }}
             {{> sidebar-item href="/pages/help" title="Help" text="Help" spanClass="font-medium sidebar-text" icon='help-circle' }}
             {{> sidebar-item href="/pages/learn" title="Learn" text="Learn" spanClass="font-medium sidebar-text" icon='book-open' }}
             {{> sidebar-item href="/pages/settings" title="Settings" text="Settings" spanClass="font-medium sidebar-text" icon='settings' }}
             {{> sidebar-item href="/pages/billing" title="Billing" text="Billing" spanClass="font-medium sidebar-text" icon='credit-card' }}
          </ul>
          {{#if (eq currentSection 'dashboard')}}
          <ul class="space-y-1">
{{> sidebar-item href="/admin/other-pages/dashboard" title="Overview" page="dashboard" text="Overview" spanClass="font-medium sidebar-text" icon='bar-chart' }}
{{> sidebar-item href="/admin/other-pages/new-project" title="New Project" page="new-project" text="New Project" spanClass="font-medium sidebar-text" icon='plus' }}
{{> sidebar-item href="/admin/other-pages/explore-ideas" title="Explore Ideas" page="explore-ideas" text="Explore Ideas" spanClass="font-medium sidebar-text" icon='lightbulb' }}
              {{> sidebar-item href="/pages/learn" title="Learn" text="Learn" spanClass="sidebar-text" icon='book-open' }}
          </ul>
          {{/if}}

         {{#if (eq currentSection 'portfolio')}}
         <ul class="space-y-1">
            {{> sidebar-item href="/admin/other-pages/portfolio" title="Overview" page="portfolio" text="Overview"
            spanClass="sidebar-text" icon='briefcase' }}
           </ul>
           {{/if}}

  {{#if (eq currentSection 'corporate-dashboard')}}
