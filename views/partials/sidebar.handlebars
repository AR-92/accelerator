         {{#if isRowPage}}
         <ul class="space-y-1 mt-4">
           {{#each rowActions}}
           <li>
               <a href="{{link}}" class="flex items-center px-3 py-2 text-sm text-muted-foreground hover:bg-primary/10 hover:text-primary transition-colors">
                {{{icon icon size='16' class='w-4 h-4 mr-3'}}}
                {{text}}
              </a>
           </li>
           {{/each}}
         </ul>
          {{/if}}
