              {{> sidebar-item href="/admin/other-pages/explore-ideas" title="All Ideas" text="All Ideas" spanClass="sidebar-text ml-4" icon='list' }}
              {{> sidebar-item href="/admin/other-pages/explore-ideas?category=healthcare" title="Healthcare" text="Healthcare" spanClass="sidebar-text ml-4" icon='heart' }}
              {{> sidebar-item href="/admin/other-pages/explore-ideas?category=technology" title="Technology" text="Technology" spanClass="sidebar-text ml-4" icon='cpu' }}
              {{> sidebar-item href="/admin/other-pages/explore-ideas?category=environment" title="Environment" text="Environment" spanClass="sidebar-text ml-4" icon='leaf' }}
              {{> sidebar-item href="/admin/other-pages/explore-ideas?category=agriculture" title="Agriculture" text="Agriculture" spanClass="sidebar-text ml-4" icon='sprout' }}
              {{> sidebar-item href="/admin/other-pages/explore-ideas?category=research" title="Research" text="Research" spanClass="sidebar-text ml-4" icon='search' }}
