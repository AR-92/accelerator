<!-- Sidebar -->
<div id="sidebar"
  class="w-56 transition-all duration-300 border border-input/80 fixed md:relative inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 opacity-0 md:opacity-100 pointer-events-none md:pointer-events-auto flex flex-col h-[calc(100vh-90px)]">
  <div class="flex-1 overflow-y-auto">
    <nav class="px-3 py-3 text-sm">
      <!-- Top-level Sections -->
      <ul class="space-y-1 border-b border-input/80 pb-2 mb-2 md:hidden">
        {{> sidebar-item href="/admin/other-pages/dashboard" title="Dashboard" text="Dashboard" spanClass="font-medium
        sidebar-text" icon='bar-chart' }}
        {{> sidebar-item href="/admin/other-pages/new-project?showCard=true" title="New Project" text="New Project"
        spanClass="font-medium
        sidebar-text" icon='plus' }}
        {{> sidebar-item href="/admin/other-pages/new-project?filter=explore" title="Explore" text="Explore"
        spanClass="font-medium
        sidebar-text" icon='search' }}
        {{> sidebar-item href="/pages/help" title="Help" text="Help" spanClass="font-medium sidebar-text"
        icon='help-circle' }}
        {{> sidebar-item href="/pages/learn" title="Learn" text="Learn" spanClass="font-medium sidebar-text"
        icon='book-open' }}
        {{> sidebar-item href="/pages/settings" title="Settings" text="Settings" spanClass="font-medium sidebar-text"
        icon='settings' }}
        {{> sidebar-item href="/pages/billing" title="Billing" text="Billing" spanClass="font-medium sidebar-text"
        icon='credit-card' }}
      </ul>

      {{#if (eq currentSection 'dashboard')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/admin/other-pages/new-project?showCard=true" title="New Project" text="New Project"
        spanClass="font-medium sidebar-text" icon='plus' }}
        {{> sidebar-item href="/admin/other-pages/new-project?filter=explore" title="Explore Ideas" text="Explore Ideas"
        spanClass="font-medium sidebar-text" icon='search' }}
        {{> sidebar-item href="/pages/learn" title="Learn" text="Learn" spanClass="font-medium sidebar-text"
        icon='book-open' }}
      </ul>
      {{/if}}

      {{#if (eq currentSection 'help')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/pages/help" title="Help" text="Help" spanClass="font-medium sidebar-text"
        icon='help-circle' }}
      </ul>
      {{/if}}

      {{#if (eq currentSection 'learn')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/pages/learn" title="Learn" text="Learn" spanClass="font-medium sidebar-text"
        icon='book-open' }}
      </ul>
      {{/if}}

      {{#if (eq currentSection 'settings')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/pages/settings" title="Overview" text="Overview" spanClass="font-medium sidebar-text"
        icon='settings' }}
        {{> sidebar-item href="/pages/settings/profile" title="Account" text="Account" spanClass="font-medium
        sidebar-text" icon='user' }}
        {{> sidebar-item href="/pages/settings/billing" title="Billing" text="Billing" spanClass="font-medium
        sidebar-text" icon='credit-card' }}
        {{> sidebar-item href="/pages/settings/other" title="Security & Privacy" text="Security & Privacy"
        spanClass="font-medium sidebar-text" icon='shield' }}
      </ul>
      {{/if}}

      {{#if (eq currentSection 'billing')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/pages/billing" title="Billing" text="Billing" spanClass="font-medium sidebar-text"
        icon='credit-card' }}
        {{> sidebar-item href="/pages/buy-credits" title="Buy Credits" text="Buy Credits" spanClass="font-medium
        sidebar-text" icon='coins' }}
        {{> sidebar-item href="/pages/core/upgrade-plan" title="Upgrade Plan" text="Upgrade Plan" spanClass="font-medium
        sidebar-text" icon='star' }}
      </ul>
      {{/if}}

      {{#if (eq currentSection 'system')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/admin/other-pages/activity" title="Activity" text="Activity" spanClass="font-medium
        sidebar-text" icon='activity' }}
        {{> sidebar-item href="/admin/other-pages/notifications" title="Notifications" text="Notifications"
        spanClass="font-medium sidebar-text" icon='bell' }}
        {{> sidebar-item href="/admin/other-pages/system-health" title="System Health" text="System Health"
        spanClass="font-medium sidebar-text" icon='shield-check' }}
        {{> sidebar-item href="/admin/other-pages/system-config" title="System Config" text="System Config"
        spanClass="font-medium sidebar-text" icon='settings' }}
        {{> sidebar-item href="/admin/other-pages/system-logs" title="System Logs" text="System Logs"
        spanClass="font-medium sidebar-text" icon='file-text' }}
        {{> sidebar-item href="/admin/other-pages/profile-settings" title="Profile Settings" text="Profile Settings"
        spanClass="font-medium sidebar-text" icon='user' }}
        {{> sidebar-item href="/admin/other-pages/settings" title="Settings" text="Settings" spanClass="font-medium
        sidebar-text" icon='settings' }}
        {{> sidebar-item href="/admin/other-pages/user-management" title="User Management" text="User Management" spanClass="font-medium
        sidebar-text" icon='users' }}
      </ul>
      {{/if}}

      {{#if (eq currentSection 'main')}}
      <div class="md:hidden">
        <ul class="space-y-1">
          {{#each filterLinks}}
          {{> sidebar-item href=href title=text page=text text=text spanClass="font-medium sidebar-text" icon=icon }}
          {{/each}}
        </ul>
      </div>
      {{#if (eq currentPage 'New Project')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/admin/other-pages/new-project?showCard=true" title="New Project" text="New Project"
        spanClass="font-medium sidebar-text" icon='plus' }}
        {{> sidebar-item href="/admin/other-pages/new-project?filter=explore" title="Explore Ideas" text="Explore Ideas"
        spanClass="font-medium sidebar-text" icon='search' }}
        {{> sidebar-item href="/pages/learn" title="Learn" text="Learn" spanClass="font-medium sidebar-text"
        icon='book-open' }}
      </ul>
      {{#if allIdeas}}
      <div class="mt-4">
        <h3
          class="px-3 py-2 text-xs font-semibold text-muted-foreground uppercase tracking-wider flex items-center gap-2">
          {{{icon 'folder' size="14" class='w-3.5 h-3.5'}}}
          All Projects
        </h3>
        <ul class="space-y-1">
          {{#each allIdeas}}
          <li>
            <a href="/projects/{{this.id}}" title="{{this.title}}"
              class="flex items-center px-3 py-1 text-sm text-muted-foreground hover:bg-primary/10 hover:text-primary transition-colors">
              {{{icon 'file-text' size="16" class='w-4 h-4 mr-3'}}}
              <span class="text-xs sidebar-text">{{this.title}}</span>
            </a>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
      {{/if}}
      {{/if}}



      {{#if (eq currentPage 'Project Detail')}}
      <ul class="space-y-1">
        {{> sidebar-item href="/projects/idea-model" title="Idea Model" text="Idea Model" spanClass="font-medium
        sidebar-text" icon='lightbulb' }}
        {{> sidebar-item href="/projects/business-model" title="Business Model" text="Business Model"
        spanClass="font-medium sidebar-text" icon='briefcase' }}
        {{> sidebar-item href="/projects/financial-model" title="Financial Model" text="Financial Model"
        spanClass="font-medium sidebar-text" icon='dollar-sign' }}
        {{> sidebar-item href="/projects/funding-model" title="Funding Model" text="Funding Model"
        spanClass="font-medium sidebar-text" icon='trending-up' }}
        {{> sidebar-item href="/projects/legal-model" title="Legal Model" text="Legal Model" spanClass="font-medium
        sidebar-text" icon='scale' }}
        {{> sidebar-item href="/projects/marketing-model" title="Marketing Model" text="Marketing Model"
        spanClass="font-medium sidebar-text" icon='megaphone' }}
        {{> sidebar-item href="/projects/team-model" title="Team Model" text="Team Model" spanClass="font-medium
        sidebar-text" icon='users' }}
      </ul>
      {{/if}}



      {{#if isRowPage}}
      <ul class="space-y-1 mt-4">
        {{#each rowActions}}
        <li>
          <a href="{{link}}"
            class="flex items-center px-3 py-2 text-sm text-muted-foreground hover:bg-primary/10 hover:text-primary transition-colors">
            {{{icon icon size="16" class='w-4 h-4 mr-3'}}}
            <span class="font-medium sidebar-text">{{text}}</span>
          </a>
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </nav>
  </div>
  {{> sidebar-footer}}
</div>