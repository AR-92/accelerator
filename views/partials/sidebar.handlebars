              {{> sidebar-item href="/admin/other-pages/portfolio" title="Portfolio" text="Portfolio" spanClass="sidebar-text" icon='briefcase' }}
              {{> sidebar-item href="/admin/other-pages/portfolio?filter=professional" title="Professional Projects" text="Professional Projects" spanClass="sidebar-text ml-4" icon='zap' }}
              {{> sidebar-item href="/admin/other-pages/portfolio?filter=community" title="Community Driven" text="Community Driven" spanClass="sidebar-text ml-4" icon='users' }}
              {{> sidebar-item href="/admin/other-pages/portfolio?filter=quality" title="Quality Assured" text="Quality Assured" spanClass="sidebar-text ml-4" icon='shield-check' }}
           </ul>
