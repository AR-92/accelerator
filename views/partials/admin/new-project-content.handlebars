<!-- Ideas Grid Section -->
<div class="flex flex-col">
  <div class="flex flex-col w-full px-4 mx-auto ">
    <div class="flex flex-col pb-[100px] max-md:pb-[64px] ">


      {{#if ideas}}
      <div class="my-6">
         <div class="flex-row flex-wrap grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 relative">
          {{#each ideas}}
            <a class="flex relative flex-col gap-1 items-start p-4 cursor-pointer group-item-btns overflow-hidden border rounded-md {{#if (eq this.status 'archived')}}archived-item{{else}}border-input/80{{/if}} hover:animate-rainbow-shadow"
              href="/projects/{{this.id}}" draggable="false" data-id="{{this.id}}"
             data-status="{{this.status}}" data-type="{{this.type}}" data-favorite="{{this.is_favorite}}">
             {{#if (eq this.status 'archived')}}
              <div class="absolute top-2 right-2 archived-badge text-xs px-2 py-1 rounded-md font-medium">
               Archived
             </div>
             {{/if}}
             <button onclick="redirectToPopulate('{{this.id}}'); return false;" class="absolute top-2 right-2 text-muted-foreground hover:text-primary cursor-pointer">
               {{{icon 'plus' size="16" class='w-4 h-4'}}}
             </button>
             <div class="w-full">
              <span
                class="text-ellipsis break-words line-clamp-2 text-sm text-foreground font-medium">{{this.name}}</span>
            </div>

            <div class="flex items-center gap-1.5 mb-1">
              <div class="text-muted-foreground text-[13px] leading-[18px] truncate">{{this.type}}</div>
            </div>

            <div class="text-xs text-muted-foreground mb-2 line-clamp-2">{{this.description}}</div>

            <div class="flex flex-wrap gap-1 mb-2">
              {{#if this.tags}}
              {{#each this.tags}}
              <span
                class="px-2 py-0.5 bg-secondary/10 text-secondary-foreground text-xs rounded-md border border-secondary/40">{{this}}</span>
              {{/each}}
              {{/if}}
            </div>

            <div class="flex items-center justify-between w-full mt-auto pt-2 border-t border-input/80">
              <div class="flex items-center">

                <div class="flex">
                  {{#each (range 1 5)}}
                  {{#if (lte @index ../rating)}}
                  {{{icon 'star' size="16" class='w-3.5 h-3.5 fill-yellow-400 text-yellow-400'}}}
                  {{else}}
                  {{{icon 'star' size="16" class='w-3.5 h-3.5 text-muted-foreground'}}}
                  {{/if}}
                  {{/each}}
   </div>

   <script>
     // Toggle ideas visibility
     window.toggleIdeasVisibility = function() {
       const ideasSection = document.getElementById('main-main-content');
       const button = document.querySelector('button[onclick="toggleIdeasVisibility()"]');
       if (ideasSection.style.display === 'none') {
         ideasSection.style.display = 'block';
         button.innerHTML = `{{{icon 'eye-off' size="16" class='w-4 h-4'}}} Hide ideas`;
       } else {
         ideasSection.style.display = 'none';
         button.innerHTML = `{{{icon 'eye' size="16" class='w-4 h-4'}}} Show ideas`;
       }
     };
   </script>
 </div>

              <div class="flex space-x-2">
                {{#if (eq this.status 'active')}}
                <button class="text-muted-foreground hover:text-orange-500 rounded-full hover:bg-accent unpublish-btn">
                  {{{icon 'eye-off' size="16" class='w-4 h-4'}}}
                </button>
                {{else}}
                <button class="text-muted-foreground hover:text-purple-500 rounded-full hover:bg-accent publish-btn">
                  {{{icon 'upload' size="16" class='w-4 h-4'}}}
                </button>
                {{/if}}

                <button class="text-muted-foreground rounded-full hover:text-green-500">
                  {{#if this.is_favorite}}
                  {{{icon 'heart' size="16" class='w-4 h-4 fill-red-500 text-red-500'}}}
                  {{else}}
                  {{{icon 'heart' size="16" class='w-4 h-4'}}}
                  {{/if}}
                </button>
                {{#if (eq this.status 'archived')}}
                <div class="flex space-x-1">
                  <button class="text-muted-foreground hover:text-blue-500 rounded-full hover:bg-accent">
                    {{{icon 'rotate-ccw' size="16" class='w-4 h-4'}}}
                  </button>
                  <button class="text-red-600 hover:text-red-700 rounded-full hover:bg-accent delete-btn">
                    {{{icon 'trash-2' size="16" class='w-4 h-4'}}}
                  </button>
                </div>
                {{else}}
                <button class="text-muted-foreground hover:text-red-500 rounded-full hover:bg-accent archive-btn">
                  {{{icon 'archive' size="16" class='w-4 h-4'}}}
                </button>
                {{/if}}
              </div>
            </div>
          </a>
          {{/each}}
        </div>
      </div>
      {{else}}
      <div class="text-center py-8">
        <div class="w-12 h-12 flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
         <h3 class="text-base font-normal mb-1 text-muted-foreground">No ideas to explore</h3>
         <p class="text-sm text-muted-foreground">Please wait while people upload their ideas.</p>
      </div>
       <!-- Create new idea -->
       <div class="text-center">
          <a href="/admin/other-pages/new-project?showCard=true" hx-get="/admin/other-pages/new-project?showCard=true" hx-target="#main-main-content" hx-swap="innerHTML" class="inline-flex items-center gap-2 px-4 py-2 text-sm text-primary hover:text-primary/80 rounded-md transition-colors">
           {{{icon 'plus' size="16" class='w-4 h-4'}}}
           Create new idea
         </a>
       </div>


    </div>
    {{/if}}


  </div>
</div>