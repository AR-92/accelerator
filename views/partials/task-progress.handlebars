        <div class="flex flex-col">
          <!-- Task Header -->
          <div class="bg-muted rounded-2xl p-4 mb-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3 gap-3">
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-sm font-bold flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <div class="min-w-0">
                  <h4 class="text-sm font-semibold text-foreground">{{title}}</h4>
                  <p class="text-sm text-muted-foreground">{{description}}</p>
                </div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <span
                  class="inline-flex items-center px-2 py-1 rounded-full text-xs bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {{status}}
                </span>
                <span class="text-xs text-muted-foreground">{{time}}</span>
              </div>
            </div>
            <div class="w-full bg-secondary rounded-full h-2">
              <div class="bg-primary h-2 rounded-full transition-all duration-300" style="width: {{progress}}%;"></div>
            </div>
          </div>


          <!-- Task Content with Steps -->
          <div class="flex">
            <div class="w-[60px] relative">
              <div class="absolute left-20 top-5 bottom-5 w-0 border-l border-dotted border-gray-500 z-0"></div>
            </div>
            <div class="flex flex-col flex-1 min-w-0 overflow-hidden pt-2">
              {{#each steps}}
              <div class="flex gap-4">
                <div class="flex-shrink-0 relative">
                  <div
                    class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-xs font-bold shadow-md relative z-10 ml-2">
                    {{number}}
                  </div>
                </div>
                <div class="flex-1 pb-6">
                  {{> step-header iconName=iconName title=title description=description time=time confidence=confidence}}
                </div>
              </div>
              {{/each}}

              <div class="text-xs text-muted-foreground mt-3">{{footerTime}}</div>
            </div>
          </div>
        </div>