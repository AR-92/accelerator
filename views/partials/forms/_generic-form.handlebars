{{!-- Generic form partial that handles all form types --}}
<form action="{{config.action}}" method="{{config.method}}" enctype="{{#if config.enctype}}{{config.enctype}}{{else}}application/x-www-form-urlencoded{{/if}}">
  {{#if config.csrfToken}}
    <input type="hidden" name="_csrf" value="{{config.csrfToken}}">
  {{/if}}

  {{#each config.fields}}
    {{#if (eq type "text")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
        <input type="text"
               id="{{name}}"
               name="{{name}}"
               value="{{#if value}}{{value}}{{/if}}"
               {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
               {{#if required}}required{{/if}}
               class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
               placeholder="{{placeholder}}">
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "textarea")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
        <textarea id="{{name}}"
                  name="{{name}}"
                  rows="{{#if rows}}{{rows}}{{else}}4{{/if}}"
                  {{#if required}}required{{/if}}
                  class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors{{#if resize}} resize-{{resize}}{{else}} resize-vertical{{/if}}"
                  placeholder="{{placeholder}}">{{#if value}}{{value}}{{/if}}</textarea>
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "select")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
        {{#if buttons}}
          <div class="flex flex-wrap gap-2 mb-2">
            {{#each buttons}}
              <button type="button"
                      class="px-3 py-2 bg-primary text-primary-foreground rounded-full text-sm hover:bg-primary/90 transition-colors">{{text}}</button>
            {{/each}}
          </div>
        {{/if}}
        <select id="{{name}}"
                name="{{name}}"
                {{#if required}}required{{/if}}
                class="w-full px-3 py-2 border border-border rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors">
          {{#if placeholder}}<option value="">{{placeholder}}</option>{{/if}}
          {{#each options}}
            <option value="{{value}}" {{#if ../value}} {{#if (eq ../value value)}}selected{{/if}} {{/if}}>{{text}}</option>
          {{/each}}
        </select>
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "dynamic-list")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2">{{label}}</label>
        <div id="{{containerId}}" class="space-y-3">
          {{#if initialItems}}
            {{#each initialItems}}
              <div class="flex gap-2 items-start {{#if ../subfields}}bg-background rounded-lg p-4 border border-border{{/if}}">
                {{#if ../subfields}}
                  <div class="flex-1 grid {{#if ../gridCols}}grid-cols-{{../gridCols}}{{else}}grid-cols-1{{/if}} gap-3">
                    {{#each ../subfields}}
                      {{#if (eq type "text")}}
                        <div>
                          <label class="block text-sm font-medium text-foreground mb-1" for="{{name}}-{{@../index}}">{{label}}</label>
                          <input type="text"
                                 id="{{name}}-{{@../index}}"
                                 name="{{../itemName}}[{{@../index}}][{{name}}]"
                                 value="{{#if value}}{{value}}{{/if}}"
                                 {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
                                 class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
                                 placeholder="{{placeholder}}">
                          {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
                        </div>
                      {{/if}}
                      {{#if (eq type "textarea")}}
                        <div>
                          <label class="block text-sm font-medium text-foreground mb-1">{{label}}</label>
                          <textarea name="{{../itemName}}[{{@../index}}][{{name}}]"
                                    rows="{{rows}}"
                                    class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary resize-vertical transition-colors"
                                    placeholder="{{placeholder}}">{{#if value}}{{value}}{{/if}}</textarea>
                        </div>
                      {{/if}}
                      {{#if (eq type "select")}}
                        <div>
                          <label class="block text-sm font-medium text-foreground mb-1">{{label}}</label>
                          {{#if buttons}}
                            <div class="flex gap-2 mb-2">
                              {{#each buttons}}
                                <button type="button" class="px-3 py-2 bg-primary text-primary-foreground rounded-full text-sm hover:bg-primary/90">{{text}}</button>
                              {{/each}}
                            </div>
                          {{/if}}
                          <select name="{{../itemName}}[{{@../index}}][{{name}}]"
                                  class="w-full px-3 py-2 border border-border rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-colors">
                            {{#each options}}
                              <option value="{{value}}">{{text}}</option>
                            {{/each}}
                          </select>
                        </div>
                      {{/if}}
                      {{#if (eq type "grid")}}
                        <div class="grid grid-cols-{{gridCols}} gap-4">
                          {{#each subfields}}
                            <div>
                              <label class="block text-sm font-medium text-foreground mb-1">{{label}}</label>
                              {{#if (eq inputType "textarea")}}
                                <textarea name="{{../itemName}}[{{@../index}}][{{name}}]"
                                          rows="{{rows}}"
                                          class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary resize-vertical transition-colors"
                                          placeholder="{{placeholder}}">{{#if value}}{{value}}{{/if}}</textarea>
                              {{else}}
                                <input type="{{inputType}}"
                                       name="{{../itemName}}[{{@../index}}][{{name}}]"
                                       {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
                                       class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
                                       placeholder="{{placeholder}}">
                              {{/if}}
                            </div>
                          {{/each}}
                        </div>
                      {{/if}}
                    {{/each}}
                  </div>
                  <button type="button"
                          class="px-3 py-2 bg-red-500 text-white rounded-md hover:bg-red-600 text-sm remove-btn transition-colors">Remove</button>
                {{else}}
                  <input type="text"
                         name="{{../itemName}}[]"
                         class="flex-1 px-3 py-2 border border-border rounded-md bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
                         placeholder="{{../placeholder}}">
                  <button type="button"
                          class="px-3 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 remove-btn transition-colors">-</button>
                {{/if}}
              </div>
            {{/each}}
          {{else}}
            <div class="flex gap-2 items-start">
              <input type="text"
                     name="{{itemName}}[]"
                     class="flex-1 px-3 py-2 border border-border rounded-md bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
                     placeholder="{{placeholder}}">
              <button type="button"
                      class="px-3 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 remove-btn transition-colors">-</button>
            </div>
          {{/if}}
        </div>
        <button type="button"
                class="w-full px-4 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 mt-2 add-btn transition-colors">
          Add Another {{itemName}}
        </button>
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
      </div>
    {{else if (eq type "grid")}}
      <div class="grid {{#if gridCols}}grid-cols-{{gridCols}}{{else}}grid-cols-2{{/if}} gap-4 mb-4">
        {{#each subfields}}
          <div>
            <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
            {{#if (eq inputType "textarea")}}
              <textarea id="{{name}}"
                        name="{{name}}"
                        rows="{{#if rows}}{{rows}}{{else}}4{{/if}}"
                        {{#if required}}required{{/if}}
                        class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary resize-vertical transition-colors"
                        placeholder="{{placeholder}}">{{#if value}}{{value}}{{/if}}</textarea>
            {{else}}
              <input type="{{#if inputType}}{{inputType}}{{else}}text{{/if}}"
                     id="{{name}}"
                     name="{{name}}"
                     value="{{#if value}}{{value}}{{/if}}"
                     {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
                     {{#if required}}required{{/if}}
                     class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary transition-colors"
                     placeholder="{{placeholder}}">
            {{/if}}
            {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
            {{#if ../../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../../errors.[name]}}</div>{{/if}}
          </div>
        {{/each}}
      </div>
    {{else if (eq type "checkbox-group")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2">{{label}}</label>
        <div class="flex flex-wrap gap-3">
          {{#each options}}
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox"
                     name="{{../name}}"
                     value="{{value}}"
                     {{#if ../value}} {{#if (eq ../value value)}}checked{{/if}} {{/if}}
                     class="rounded text-primary focus:ring-primary">
              <span class="text-sm text-foreground">{{text}}</span>
            </label>
          {{/each}}
        </div>
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "upload")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2">{{label}}</label>
        <div class="bg-background/50 rounded-lg p-3 mb-3 border border-border/50">
          <p class="text-foreground m-0">{{description}}</p>
        </div>
        <input type="file"
               id="file-input-{{@index}}"
               class="hidden"
               name="{{name}}"
               accept="{{accept}}"
               {{#if multiple}}multiple{{/if}}>
        <div class="upload-area relative group mb-3 rounded-lg overflow-hidden border-2 border-dashed border-border bg-background hover:border-primary/50 transition-colors cursor-pointer">
          <div class="w-full h-32 sm:h-48 flex items-center justify-center">
            <div class="text-center">
              <svg class="w-10 h-10 sm:w-12 sm:h-12 text-muted-foreground mx-auto mb-2 sm:mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
              <p class="text-sm font-medium text-foreground mb-1">{{uploadTitle}}</p>
              <p class="text-xs text-muted-foreground">{{supportedFormats}}</p>
            </div>
          </div>
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
            <button type="button"
                    class="upload-button bg-primary text-primary-foreground rounded-full p-3 hover:bg-primary/90 transition-colors"
                    data-accept="{{accept}}"
                    data-input-id="file-input-{{@index}}"
                    {{#if multiple}}data-multiple{{/if}}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
            </button>
          </div>
        </div>
        <div id="file-previews-{{@index}}" class="file-previews-container"></div>
        {{#if hasUploadedFile}}
        <div class="bg-muted rounded-2xl p-4 mt-3">
          <div class="flex items-start gap-3">
            <div class="p-3 bg-{{iconColor}}-100 rounded-lg">
              <svg class="w-8 h-8 text-{{iconColor}}-600">{{{iconSvg}}}</svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <h4 class="text-sm font-semibold text-foreground truncate">{{fileName}}</h4>
                <span class="text-xs text-muted-foreground bg-background px-2 py-1 rounded">{{fileType}}</span>
              </div>
              <div class="grid grid-cols-2 gap-4 text-xs text-muted-foreground mb-3">
                <div>
                  <span class="font-medium">{{fileInfoLabel}}:</span> {{fileInfoValue}}
                </div>
                <div>
                  <span class="font-medium">Size:</span> {{fileSize}}
                </div>
                <div>
                  <span class="font-medium">Uploaded:</span> {{uploadedDate}}
                </div>
                <div>
                  <span class="font-medium">Status:</span> {{status}}
                </div>
              </div>
              <div class="space-y-2">
                <div class="flex justify-between text-xs">
                  <span class="text-muted-foreground">Upload Progress</span>
                  <span class="text-foreground font-medium">{{progress}}%</span>
                </div>
                <div class="w-full bg-secondary rounded-full h-2">
                  <div class="bg-green-500 h-2 rounded-full transition-all duration-300" style="width: {{progress}}%;"></div>
                </div>
                <div class="text-xs text-muted-foreground">{{progress}} MB of {{totalSize}} MB uploaded</div>
              </div>
            </div>
          </div>
          <div class="flex gap-2 mt-4">
            <button class="flex-1 text-sm px-3 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 font-medium transition-colors">
              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Download
            </button>
            <button class="px-3 py-2 text-sm bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
              </svg>
            </button>
            <button class="px-3 py-2 text-sm bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </div>
        {{/if}}
        <div class="space-y-2">
          <h4 class="text-sm font-semibold text-foreground">{{sectionTitle}}</h4>
          <p class="text-sm text-muted-foreground">{{sectionDescription}}</p>
          <div class="flex flex-wrap items-center justify-between text-xs text-muted-foreground">
            <span>{{supportedLabel}}</span>
            <span>{{maxSizeLabel}}</span>
          </div>
        </div>
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "radio-group")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2">{{label}}</label>
        <div class="flex flex-wrap gap-3">
          {{#each options}}
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio"
                     name="{{../name}}"
                     value="{{value}}"
                     {{#if ../value}} {{#if (eq ../value value)}}checked{{/if}} {{/if}}
                     class="text-primary focus:ring-primary">
              <span class="text-sm text-foreground">{{text}}</span>
            </label>
          {{/each}}
        </div>
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "email")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
        <input type="email"
               id="{{name}}"
               name="{{name}}"
               value="{{#if value}}{{value}}{{/if}}"
               {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
               {{#if required}}required{{/if}}
               class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
               placeholder="{{placeholder}}">
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "password")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
        <input type="password"
               id="{{name}}"
               name="{{name}}"
               {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
               {{#if required}}required{{/if}}
               class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
               placeholder="{{placeholder}}">
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "number")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
        <input type="number"
               id="{{name}}"
               name="{{name}}"
               value="{{#if value}}{{value}}{{/if}}"
               {{#if min}}min="{{min}}"{{/if}}
               {{#if max}}max="{{max}}"{{/if}}
               {{#if step}}step="{{step}}"{{/if}}
               {{#if required}}required{{/if}}
               class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
               placeholder="{{placeholder}}">
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{else if (eq type "date")}}
      <div class="mb-4">
        <label class="block text-sm font-medium text-foreground mb-2" for="{{name}}">{{label}}</label>
        <input type="date"
               id="{{name}}"
               name="{{name}}"
               value="{{#if value}}{{value}}{{/if}}"
               {{#if required}}required{{/if}}
               class="w-full px-3 py-2 border border-border rounded-md bg-muted text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
               placeholder="{{placeholder}}">
        {{#if helper}}<div class="text-xs text-muted-foreground mt-1">{{helper}}</div>{{/if}}
        {{#if ../errors.[name]}}<div class="text-xs text-red-500 mt-1">{{../errors.[name]}}</div>{{/if}}
      </div>
    {{/if}}
  {{/each}}

  {{#unless config.noSubmit}}
  <div class="flex flex-wrap gap-2">
    {{#if config.aiFill}}
    <button type="button"
            class="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 font-medium transition-colors">
      Auto-Fill with AI
    </button>
    {{/if}}
    <button type="submit"
            class="flex-1 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 font-medium transition-colors">
      {{#if config.submitText}}{{config.submitText}}{{else}}Submit{{/if}}
    </button>
    {{#if config.saveDraft}}
    <button type="button"
            class="px-4 py-2 bg-secondary text-secondary-foreground rounded-md hover:bg-secondary/80 transition-colors">
      Save Draft
    </button>
    {{/if}}
  </div>
  {{/unless}}
</form>