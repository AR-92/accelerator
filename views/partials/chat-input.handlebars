<div class="mx-auto w-full">
  <form id="chat-form" class="">
    <div
      class="flex items-center gap-2 bg-muted rounded-xl px-6 py-2 shadow-sm focus-within:ring-2 focus-within:ring-primary/30 transition-all duration-200">
      <!-- Text input area -->
      <div class="flex-1 min-w-0">
        <input type="text" placeholder="Send a message about your idea model..."
          class="w-full bg-transparent border-0 outline-none text-base text-foreground placeholder:text-muted-foreground resize-none focus:outline-none focus:ring-0 min-h-[24px] max-h-32 overflow-y-auto"
          id="message-input" autocomplete="off">
      </div>

      <!-- Send button -->
      <button type="submit"
        class="h-9 w-9 flex items-center justify-center hover:bg-primary/10 rounded-lg transition-colors group disabled:opacity-50"
        aria-label="Send message" id="send-button" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-send h-5 w-5 text-muted-foreground group-hover:text-primary transition-colors">
          <path d="m22 2-7 20-4-9-9-4Z"></path>
          <path d="M22 2 11 13"></path>
        </svg>
      </button>
    </div>
  </form>


</div>

<script src="/js/chat-input.js"></script>