<!-- Top Navigation Bar -->
<nav
  class="navbar-bg text-card-foreground px-2 sm:px-4 border-b border-input/80 flex items-center justify-between min-h-12">
  <div class="flex items-center gap-2 sm:gap-4">
    <div class="h-6 w-6 ml-1 mr-4 sm:mr-6 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="33" height="36"
        viewBox="0 0 33 36" fill="none" class="h-full w-full">
        <path
          d="M31.6035 7.28044C31.1951 7.03803 30.7235 7.06833 30.3421 7.35872L26.4519 10.3182C25.9036 10.7348 25.5764 11.4317 25.5764 12.1868V21.1636C25.5764 24.2695 23.7757 26.9638 21.1966 27.7138L6.895 31.8726V14.5099C6.895 11.7171 8.5129 9.29549 10.8326 8.62128L31.4004 2.64179C31.9126 2.4928 32.2714 1.9701 32.2714 1.37165C32.2714 1.01561 32.1405 0.672189 31.9149 0.424727C31.687 0.177265 31.3823 0.0510083 31.0777 0.0611088L27.8352 0.177265C26.7972 0.215142 25.7615 0.3818 24.7551 0.674714L7.27635 5.75527C3.11314 6.9648 0.206787 11.2853 0.206787 16.2598V32.8423C0.206787 33.7033 0.716752 34.4508 1.44785 34.6629L5.68553 35.8876C5.8164 35.9255 5.95405 35.9457 6.09169 35.9457C6.22934 35.9457 6.36698 35.9255 6.49786 35.8876L24.8792 30.5444C29.2342 29.2793 32.2759 24.7594 32.2759 19.5526V8.52785C32.2759 8.00263 32.0209 7.52538 31.6103 7.28297L31.6035 7.28044Z"
          fill="currentColor" />
      </svg></div>

     <div class="hidden md:flex items-center gap-2 sm:gap-4">
        {{> nav-item section="home" text="Home" href="/"}}
        {{> nav-item section="dashboard" text="Dashboard" href="/dashboard/overview"}}
      {{> nav-item section="portfolio" text="Portfolio" href="/portfolio"}}
       {{> nav-item section="voting" text="Voting & Rewards" href="/voting-reward"}}
    </div>
  </div>
   <div class="flex items-center">
     {{#unless showSearch}}
     <div class="h-12 w-px bg-border"></div>
     <div class="self-center">
       <label class="relative block">
         <span class="sr-only">Search</span>
         <input
           class="max-w-36 pl-3 sm:pl-4 pr-3 sm:pr-4 py-1.5 rounded-md placeholder:text-xs sm:placeholder:text-sm text-foreground bg-transparent focus:outline-none border-0"
           placeholder="Search here..." aria-label="Search" id="navSearchInput" name="search" value="{{query.search}}" />
       </label>
     </div>
     {{/unless}}
    <!-- Credit Balance -->
    <div class="hidden md:flex items-center gap-2 px-3 py-2 ml-4">
      {{{icon 'coins' size="16" class="w-5 h-5 text-primary"}}}
      <span id="nav-credit-balance" class="text-sm font-medium">0 Credits</span>
    </div>

    <!-- Theme Toggle Button -->
     <button id="theme-toggle"
       class="ml-4 self-center w-6 h-6 text-muted-foreground hover:text-primary hover:bg-primary/10 rounded-full p-2 cursor-pointer font-medium border-0"
       onclick="toggleTheme()">
      <span id="theme-icon">{{{icon 'sun-dim' size="16" class='h-4 w-4'}}}</span>
    </button>

    {{> grid-menu}}

    <!-- User Menu -->
    <div class="relative self-center" id="admin-user-menu">
       <button onclick="toggleUserMenu()"
         class="flex items-center gap-3 h-10 px-3 rounded-md transition-all duration-200 hover:text-primary hover:bg-primary/10 cursor-pointer border-0"
         id="admin-user-menu-button">
        <img src="/images/avatar.png" class="h-6 w-6 rounded-full object-cover shrink-0 user-avatar"
          alt="User Avatar" />

         <div
           class="flex items-center justify-center w-5 h-5 rounded-md hover:bg-primary/10 transition-colors duration-200"
           id="admin-user-menu-arrow">

          {{{icon 'chevron-down' size="16" class='w-3 h-3 text-muted-foreground'}}}

        </div>
      </button>

      <!-- User Dropdown -->
      <div
        class="absolute right-0 mt-2 w-64 bg-popover border border-input/80 rounded-md shadow-lg z-30 transition-all duration-200 opacity-0 invisible hidden"
        id="admin-user-dropdown">
        <div class="p-2">

          <!-- User profile section -->
           <a href="/pages/settings"
             class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-primary/10 hover:text-primary">
            <div class="grid flex-1 text-left text-sm leading-tight">
              <div class="flex flex-1">
                <div>

                  <span class="truncate font-medium user-name">Loading...</span>
                  <span class="truncate text-xs text-muted-foreground user-email"></span>
                </div>
                {{{icon 'settings' size="16" class="h-4 w-4 shrink-0"}}}
              </div>
              <!-- Separator -->
              <div class="bg-border -mx-1 my-1 h-px"></div>
              <div class="flex items-center justify-between text-sm flex-1">
                <span class="truncate text-xs text-muted-foreground self-center flex-1 nav-current-plan-name"></span>
                <span class="truncate text-xs text-muted-foreground self-center nav-current-plan-details"></span>
              </div>
            </div>
          </a>




          <!-- Separator -->
          <div class="bg-border -mx-1 my-1 h-px"></div>






          <!-- Log out item -->
          <a onclick="handleLogout()"
            class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors text-destructive hover:bg-destructive/10">
            {{{icon 'log-out' size="16" class="h-4 w-4 shrink-0"}}}
            Log out
          </a>


        </div>
      </div>
    </div>
  </div>
</nav>