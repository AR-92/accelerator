{{!-- create idea main card --}}
<div class="flex flex-col max-w-3xl w-full px-4 mx-auto my-14">
  <!-- Header -->
  <header class="w-full flex flex-col items-center gap-2 mb-2">
    <h1 class="text-4xl font-sans font-light text-foreground mb-2">
      What problem are you trying to solve?
    </h1>
  </header>

  <!-- Form / Input area -->
   <style>
     .new-project-form:hover {
       animation: rainbow-shadow 20s infinite linear;
     }
     @keyframes rainbow-shadow {
       0% { box-shadow: 0 0 70px 55px rgba(255,0,0,0.15); }
       2.5% { box-shadow: 0 0 70px 55px rgba(255,32,0,0.15); }
       5% { box-shadow: 0 0 70px 55px rgba(255,64,0,0.15); }
       7.5% { box-shadow: 0 0 70px 55px rgba(255,96,0,0.15); }
       10% { box-shadow: 0 0 70px 55px rgba(255,128,0,0.15); }
       12.5% { box-shadow: 0 0 70px 55px rgba(255,160,0,0.15); }
       15% { box-shadow: 0 0 70px 55px rgba(255,192,0,0.15); }
       17.5% { box-shadow: 0 0 70px 55px rgba(255,224,0,0.15); }
       20% { box-shadow: 0 0 70px 55px rgba(255,255,0,0.15); }
       22.5% { box-shadow: 0 0 70px 55px rgba(224,255,0,0.15); }
       25% { box-shadow: 0 0 70px 55px rgba(192,255,0,0.15); }
       27.5% { box-shadow: 0 0 70px 55px rgba(160,255,0,0.15); }
       30% { box-shadow: 0 0 70px 55px rgba(128,255,0,0.15); }
       32.5% { box-shadow: 0 0 70px 55px rgba(96,255,0,0.15); }
       35% { box-shadow: 0 0 70px 55px rgba(64,255,0,0.15); }
       37.5% { box-shadow: 0 0 70px 55px rgba(32,255,0,0.15); }
       40% { box-shadow: 0 0 70px 55px rgba(0,255,0,0.15); }
       42.5% { box-shadow: 0 0 70px 55px rgba(0,255,32,0.15); }
       45% { box-shadow: 0 0 70px 55px rgba(0,255,64,0.15); }
       47.5% { box-shadow: 0 0 70px 55px rgba(0,255,96,0.15); }
       50% { box-shadow: 0 0 70px 55px rgba(0,255,128,0.15); }
       52.5% { box-shadow: 0 0 70px 55px rgba(0,255,160,0.15); }
       55% { box-shadow: 0 0 70px 55px rgba(0,255,192,0.15); }
       57.5% { box-shadow: 0 0 70px 55px rgba(0,224,255,0.15); }
       60% { box-shadow: 0 0 70px 55px rgba(0,192,255,0.15); }
       62.5% { box-shadow: 0 0 70px 55px rgba(0,160,255,0.15); }
       65% { box-shadow: 0 0 70px 55px rgba(0,128,255,0.15); }
       67.5% { box-shadow: 0 0 70px 55px rgba(0,96,255,0.15); }
       70% { box-shadow: 0 0 70px 55px rgba(0,64,255,0.15); }
       72.5% { box-shadow: 0 0 70px 55px rgba(0,32,255,0.15); }
       75% { box-shadow: 0 0 70px 55px rgba(0,0,255,0.15); }
       77.5% { box-shadow: 0 0 70px 55px rgba(32,0,255,0.15); }
       80% { box-shadow: 0 0 70px 55px rgba(64,0,255,0.15); }
       82.5% { box-shadow: 0 0 70px 55px rgba(96,0,255,0.15); }
       85% { box-shadow: 0 0 70px 55px rgba(128,0,255,0.15); }
       87.5% { box-shadow: 0 0 70px 55px rgba(160,0,255,0.15); }
       90% { box-shadow: 0 0 70px 55px rgba(192,0,255,0.15); }
       92.5% { box-shadow: 0 0 70px 55px rgba(224,0,255,0.15); }
       95% { box-shadow: 0 0 70px 55px rgba(255,0,224,0.15); }
       97.5% { box-shadow: 0 0 70px 55px rgba(255,0,192,0.15); }
       100% { box-shadow: 0 0 70px 55px rgba(255,0,0,0.15); }
     }
   </style>
   <form id="new-project-form" class="flex flex-col gap-1 w-full" method="post" action="/projects/new">
     <!-- CSRF Token (Important for security) -->
     <input type="hidden" name="_csrf" value="{{csrfToken}}">

    <div class="flex flex-col w-full">
      <div class="">
        <div
          class="new-project-form flex flex-col gap-2 rounded-2xl relative py-2 max-h-[220px] border border-input/80 bg-background shadow-sm">
          <!-- Title wrapper -->
          <div class="pl-4 pr-2">
            <div class="flex flex-wrap gap-1">
              <span
                class="inline-flex items-center gap-1 px-2 py-1 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full focus:outline-none focus:bg-accent">
                <i contenteditable="true" id="title">Untitled</i> {{{icon 'edit' size="12" class='w-3 h-3'}}}</span>
              <span
                class="inline-flex items-center gap-1 px-2 py-1 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full focus:outline-none focus:bg-accent">
                <i contenteditable="true" id="category">Category</i> {{{icon 'edit' size="12" class='w-3 h-3'}}}</span>
            </div>
          </div>

           <!-- Description wrapper -->
           <div class="overflow-y-auto pl-4 pr-2 relative">
            <label for="assistant-prompt" class="sr-only">Describe your
              project requirements</label>
             <textarea id="assistant-prompt" name="prompt" rows="2" placeholder="Describe your project requirements..."
               aria-label="Describe your project requirements" aria-describedby="prompt-help char-counter"
               class="flex w-full rounded-md border-0 bg-transparent p-0 pt-[1px] text-base placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-0 focus-visible:ring-offset-0 overflow-hidden resize-none min-h-[40px] max-h-32"
               required=""></textarea>
             <p id="prompt-help" class="sr-only">Enter your project
               description or requirements</p>
          </div>

          <!-- Tags wrapper -->
          <div class="pl-4 pr-2">
            <div id="tagslist" class="flex flex-wrap gap-1">

              <!-- Add more -->
              <span id="addOneTag" class="inline-flex items-center gap-1 px-2 py-0.5
                 bg-success/5
                 text-success
                  border border-success/40 cursor-pointer
               text-xs rounded-full">
                {{{icon 'plus' size="12" class='w-3 h-3'}}} Add more
              </span>

              <!-- Remove all -->
              <span id="removeAllTags" class="inline-flex items-center gap-1 px-2 py-0.5
                 bg-destructive/10
                 text-destructive
                  border border-destructive/40
                text-xs rounded-full cursor-pointer">
                {{{icon 'trash' size="12" class='w-3 h-3'}}} Remove all
              </span>

            </div>
          </div>


          <!-- toolbar -->
          <div class="px-3 flex gap-2 items-center">
             <div class="flex gap-2 items-center flex-shrink-0">
                <!-- Generate title with AI -->
                <button type="button" aria-label="Generate title with AI" title="Generate title with AI"
                  class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                  {{{icon 'type' size="16" class='w-4 h-4'}}}
                  <span class="hidden group-hover:inline transition-all duration-200">Generate Title with AI</span>
                </button>

               <!-- Add category with AI -->
               <button type="button" aria-label="Add category with AI" title="Add category with AI"
                 class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                 {{{icon 'folder' size="16" class='w-4 h-4'}}}
                 <span class="hidden group-hover:inline transition-all duration-200">Add Category with AI</span>
               </button>

                <!-- Improve with AI -->
                <button type="button" aria-label="Improve with AI" title="Improve with AI"
                  class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                  {{{icon 'lightbulb' size="16" class='w-4 h-4'}}}
                  <span class="hidden group-hover:inline transition-all duration-200">Improve Description with AI</span>
                </button>

               <!-- Add tags with AI -->
               <button type="button" aria-label="Add tags with AI" title="Add tags with AI"
                 class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                 {{{icon 'tag' size="16" class='w-4 h-4'}}}
                 <span class="hidden group-hover:inline transition-all duration-200">Add Tags with AI</span>
               </button>

               <!-- Auto fill with AI -->
               <button type="button" aria-label="Auto fill with AI" title="Auto fill with AI"
                 class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                 {{{icon 'wand2' size="16" class='w-4 h-4'}}}
                 <span class="hidden group-hover:inline transition-all duration-200">Auto Fill with AI</span>
               </button>

                <!-- Generate random idea -->
                <button type="button" aria-label="Generate random idea" title="Generate random idea"
                  class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                  {{{icon 'shuffle' size="16" class='w-4 h-4'}}}
                  <span class="hidden group-hover:inline transition-all duration-200">Random Idea with AI</span>
                </button>

                <!-- Reset form -->
                <button type="button" aria-label="Reset form" title="Reset form"
                  class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                  {{{icon 'rotate-ccw' size="16" class='w-4 h-4'}}}
                  <span class="hidden group-hover:inline transition-all duration-200">Reset Form</span>
                </button>
             </div>

             <!-- Submit button on the right -->
             <div class="min-w-0 flex gap-2 ml-auto flex-shrink items-center">
               <span id="char-counter" class="text-xs text-muted/60 mr-2" aria-live="polite">Characters: 0 / 400</span>
               <button type="submit" aria-label="Create project" title="Create project"
                 class="rounded-full border border-input/80 inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-accent px-2 py-1 shrink-0 transition-all duration-300 group">
                 {{{icon 'plus' size="16" class='w-4 h-4'}}}
                 <span class="hidden group-hover:inline transition-all duration-200">Create Project</span>
               </button>
             </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    console.log('DOMContentLoaded fired for create-idea-card');
    // Initialize form elements
    const form = document.getElementById('new-project-form');
    const titleSpan = document.getElementById('title');
    const categorySpan = document.getElementById('category'); // Second contenteditable
    const descriptionTextarea = document.getElementById('assistant-prompt');
    const tagsContainer = document.getElementById('tagslist');
     const submitButton = document.querySelector('button[type="submit"]');

     // Character counter
     function updateCharCounter() {
       const length = descriptionTextarea.value.length;
       const counter = document.getElementById('char-counter');
       counter.textContent = `Characters: ${length} / 400`;
       if (length < 100 || length > 400) {
         counter.className = 'text-xs text-red-500/60 mr-2';
       } else {
         counter.className = 'text-xs text-green-500/60 mr-2';
       }
     }
     descriptionTextarea.addEventListener('input', updateCharCounter);
     updateCharCounter();

     // Toast helper
    function showToastMessage(message, type) {
      if (typeof showToast !== 'undefined') {
        showToast(message, type);
      } else {
        alert(message);
      }
    }

    const addOneTagBtn = document.getElementById('addOneTag');
    if (addOneTagBtn) {
      addOneTagBtn.addEventListener('click', function (e) {
        const tagSpan = document.createElement('span');
        tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full tag-lskjsdb';
        tagSpan.innerHTML = `<span contenteditable="true">Click and type to edit</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
        const addMoreBtn = tagsContainer.querySelector('[class*="bg-success/5"]');
        if (addMoreBtn) {
          addMoreBtn.after(tagSpan);
        }
        tagSpan.querySelector('button').addEventListener('click', function () {
          tagSpan.remove();
          showToastMessage('Tag removed', 'success');
          updateRemoveAllVisibility();
        });
        showToastMessage('Tag added successfully', 'success');
        updateRemoveAllVisibility();
      });
    }

    const removeAllTagsBtn = document.getElementById('removeAllTags');
    removeAllTagsBtn.style.display = 'none';

    function updateRemoveAllVisibility() {
      const tagCount = document.querySelectorAll('.tag-lskjsdb').length;
      removeAllTagsBtn.style.display = tagCount > 1 ? 'inline-flex' : 'none';
    }

     removeAllTagsBtn.addEventListener('click', function (e) {
       removeAllTags();
     });

     // Tag management functions
     function addTag(tagText) {
       if (!tagText.trim()) return;
       const tagSpan = document.createElement('span');
       tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full tag-lskjsdb';
       tagSpan.innerHTML = `<span contenteditable="true">${tagText}</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
       const addMoreBtn = tagsContainer.querySelector('[class*="bg-success/5"]');
       if (addMoreBtn) {
         addMoreBtn.after(tagSpan);
       }
       tagSpan.querySelector('button').addEventListener('click', function () {
         tagSpan.remove();
         showToastMessage('Tag removed', 'success');
         updateRemoveAllVisibility();
       });
       updateRemoveAllVisibility();
     }

     function addTagsFromArray(tagsArray) {
       if (Array.isArray(tagsArray)) {
         tagsArray.forEach(tag => addTag(tag));
       }
     }

     function removeAllTags() {
       const tagElements = document.querySelectorAll('.tag-lskjsdb');
       const count = tagElements.length;
       if (count === 0) {
         showToastMessage('No tags to remove', 'warning');
       } else {
         tagElements.forEach(tag => tag.remove());
         showToastMessage(`${count} tags removed`, 'success');
         updateRemoveAllVisibility();
       }
     }

     // AI button handlers
    async function callAIApi(endpoint, data) {
      try {
        const response = await fetch(`/api/ai/${endpoint}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
        return await response.json();
      } catch (error) {
        console.error('AI API error:', error);
        return { error: 'Network error' };
      }
    }


    // Generate random idea
    const randomIdeaBtn = document.querySelector('[aria-label="Generate random idea"]');
    console.log('Random idea button found:', randomIdeaBtn);
    randomIdeaBtn.addEventListener('click', async function (e) {
      e.preventDefault();


      const result = await callAIApi('random-idea', {});
      if (result.error) {
        if (typeof showToast !== 'undefined') {
          showToast('AI error: ' + result.error, 'error');
        }
      } else {
         titleSpan.innerHTML = result.title || '';
         categorySpan.innerHTML = result.category || '';
         descriptionTextarea.value = result.description || '';
         updateCharCounter();
         removeAllTags();
         if (result.tags) {
           addTagsFromArray(result.tags);
         }
         if (result.title) addTag(result.title);
         if (result.category) addTag(result.category);
         if (typeof showToast !== 'undefined') {
           showToast('Random idea generated successfully', 'success');
         }
      }
     });

     // Generate title with AI
     const generateTitleBtn = document.querySelector('[aria-label="Generate title with AI"]');
     if (generateTitleBtn) {
       generateTitleBtn.addEventListener('click', async function (e) {
         e.preventDefault();
         const description = descriptionTextarea.value;
         if (!description.trim()) {
           showToastMessage('Please enter a description first', 'warning');
           return;
         }
         showToastMessage('Generating title with AI...', 'info');
         const result = await callAIApi('suggest-title', { description });
         if (result.error) {
           showToastMessage('AI error: ' + result.error, 'error');
         } else {
           titleSpan.innerHTML = result.title || '';
           showToastMessage('Title generated successfully', 'success');
         }
       });
     }

     // Add category with AI
     const addCategoryBtn = document.querySelector('[aria-label="Add category with AI"]');
     if (addCategoryBtn) {
       addCategoryBtn.addEventListener('click', async function (e) {
         e.preventDefault();
         const description = descriptionTextarea.value;
         if (!description.trim()) {
           showToastMessage('Please enter a description first', 'warning');
           return;
         }
         showToastMessage('Categorizing with AI...', 'info');
         const result = await callAIApi('add-category', { description });
         if (result.error) {
           showToastMessage('AI error: ' + result.error, 'error');
         } else {
           categorySpan.innerHTML = result.category || '';
           showToastMessage('Category set successfully', 'success');
         }
       });
      }

      // Add tags with AI
      const addTagsBtn = document.querySelector('[aria-label="Add tags with AI"]');
      if (addTagsBtn) {
        addTagsBtn.addEventListener('click', async function (e) {
          e.preventDefault();
          const description = descriptionTextarea.value;
          if (!description.trim()) {
            showToastMessage('Please enter a description first', 'warning');
            return;
          }
          showToastMessage('Generating tags with AI...', 'info');
          const result = await callAIApi('add-tags', { description });
          if (result.error) {
            showToastMessage('AI error: ' + result.error, 'error');
          } else if (result.tags) {
            addTagsFromArray(result.tags);
            showToastMessage(`${result.tags.length} tags added successfully`, 'success');
          }
        });
      }

      // Reset form
      const resetFormBtn = document.querySelector('[aria-label="Reset form"]');
      if (resetFormBtn) {
        resetFormBtn.addEventListener('click', function (e) {
          titleSpan.innerHTML = 'Untitled';
          categorySpan.innerHTML = 'Category';
          descriptionTextarea.value = '';
          removeAllTags();
          updateCharCounter();
          showToastMessage('Form reset successfully', 'info');
        });
      }

      // Auto fill with AI
      const autoFillBtn = document.querySelector('[aria-label="Auto fill with AI"]');
      if (autoFillBtn) {
        autoFillBtn.addEventListener('click', async function (e) {
          e.preventDefault();
          const description = descriptionTextarea.value;
          if (!description.trim()) {
            showToastMessage('Please enter a description first', 'warning');
            return;
          }
          showToastMessage('Auto filling with AI...', 'info');
          const result = await callAIApi('auto-fill', { description });
          if (result.error) {
            showToastMessage('AI error: ' + result.error, 'error');
          } else {
            const currentTitle = titleSpan.textContent.trim();
            if (!currentTitle || currentTitle === 'Untitled') {
              titleSpan.innerHTML = result.title || '';
            }
            const currentCategory = categorySpan.textContent.trim();
            if (!currentCategory || currentCategory === 'Category') {
              categorySpan.innerHTML = result.category || '';
            }
            if (descriptionTextarea.value.length < 100) {
              descriptionTextarea.value = result.description || '';
              updateCharCounter();
            }
            const currentTags = document.querySelectorAll('.tag-lskjsdb').length;
            if (currentTags === 0) {
              removeAllTags();
              if (result.tags) {
                addTagsFromArray(result.tags);
              }
            }
            showToastMessage('Form auto filled successfully', 'success');
          }
        });
      }

      // Improve with AI
      const improveBtn = document.querySelector('[aria-label="Improve with AI"]');
      if (improveBtn) {
        improveBtn.addEventListener('click', async function (e) {
          e.preventDefault();
          const description = descriptionTextarea.value;
          if (!description.trim()) {
            showToastMessage('Please enter a description first', 'warning');
            return;
          }
          showToastMessage('Improving description with AI...', 'info');
          const result = await callAIApi('improve', { description });
          if (result.error) {
            showToastMessage('AI error: ' + result.error, 'error');
          } else {
            descriptionTextarea.value = result.improved_description;
            updateCharCounter();
            showToastMessage('Description improved successfully', 'success');
          }
        });
      }

      // Form submission
     form.addEventListener('submit', async function (e) {
       e.preventDefault();

       // Client-side validation
       if (!descriptionTextarea.value.trim()) {
         if (typeof showToast !== 'undefined') {
           showToast('Please enter a project description', 'warning');
         }
         return;
       }
       const descLength = descriptionTextarea.value.length;
       if (descLength < 100 || descLength > 400) {
         if (typeof showToast !== 'undefined') {
           showToast('Description must be between 100 and 400 characters', 'warning');
         }
         return;
       }

       // Collect form data
       const title = titleSpan.textContent.trim() || 'Untitled';
       const category = categorySpan.textContent.trim() || 'Category';
       const description = descriptionTextarea.value;
       const tags = Array.from(document.querySelectorAll('.tag-lskjsdb span[contenteditable]')).map(span => span.textContent.trim()).filter(tag => tag);

       // Show loading state
       submitButton.disabled = true;
       submitButton.innerHTML = '<span>Creating...</span>';

       if (typeof showToast !== 'undefined') {
         showToast('Creating your idea...', 'info');
       }

       try {
         const response = await fetch(form.action, {
           method: 'POST',
           headers: {
             'Content-Type': 'application/json',
             'Accept': 'application/json'
           },
           body: JSON.stringify({
             _csrf: document.querySelector('input[name="_csrf"]').value,
             prompt: description,
             title,
             category,
             tags: JSON.stringify(tags)
           })
         });

         if (response.ok) {
           if (typeof showToast !== 'undefined') {
             showToast('Idea created successfully!', 'success');
           }
           // Success - redirect after a short delay to show toast
           setTimeout(() => {
             window.location.href = '/projects/all-projects?success=created';
           }, 1000);
         } else {
           const errorData = await response.json();
           if (typeof showToast !== 'undefined') {
             showToast('Error: ' + (errorData.error || 'Failed to create project'), 'error');
           }
         }
       } catch (error) {
         console.error('Submission error:', error);
         if (typeof showToast !== 'undefined') {
           showToast('Network error. Please try again.', 'error');
         }
       } finally {
         // Reset loading state
         submitButton.disabled = false;
         submitButton.innerHTML = `{{{icon "plus" size="16" class="w-4 h-4"}}} <span class="hidden group-hover:inline transition-all duration-200">Create Project</span>`;
       }
     });
  });
</script>