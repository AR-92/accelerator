<div class="flex flex-col gap-4 lg:gap-6 mt-6">
  <div class="flex items-center justify-between">
    <div class="flex gap-4">
      <div>
        <img src="{{userProfile.avatar}}" alt="Avatar"
          class="w-12 h-12 rounded-full border-2 border-border object-cover">
      </div>
      <div>

        <h1 class="font-heading text-3xl font-semibold text-foreground">
          {{userProfile.name}}'s Settings
        </h1>
        <p class="text-sm text-muted-foreground">Level {{userProfile.level}} • Joined {{formatDate
          userProfile.joinDate 'long'}}</p>
        <p class="text-lg text-muted-foreground">
          Manage your account preferences and configuration
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button class="btn btn-primary">
        {{{icon 'save' size='16'}}}
        Save All Changes
      </button>
    </div>
  </div>

  <!-- Key Metrics Grid -->
  <div class="grid grid-cols-4 gap-4">

    <!-- Account Status -->
    <div class="rounded-lg  px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Account Status</h3>
          <p class="text-2xl font-semibold text-foreground">Active</p>
        </div>
        <div>
          <div class="bg-green-500/20 rounded-lg">
            <div class="w-10 h-10 bg-green-500/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-green-500 rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'check-circle' size="16" class='w-4 h-4 text-green-500-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">Verified</span>
        Since signup
      </p>
    </div>

    <!-- Current Plan -->
    <div class="rounded-lg  px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Current Plan</h3>
          <p class="text-2xl font-semibold text-foreground">Pro</p>
        </div>
        <div>
          <div class="bg-primary/20 rounded-lg">
            <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'crown' size="16" class='w-4 h-4 text-primary-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">$29.99/mo</span>
        Next billing
      </p>
    </div>

    <!-- Credits Balance -->
    <div class="rounded-lg  px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Credits Balance</h3>
          <p class="text-2xl font-semibold text-foreground">150</p>
        </div>
        <div>
          <div class="bg-amber-500/20 rounded-lg">
            <div class="w-10 h-10 bg-amber-500/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-amber-500 rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'coins' size="16" class='w-4 h-4 text-amber-500-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">+25</span>
        This month
      </p>
    </div>

    <!-- Security Status -->
    <div class="rounded-lg  px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Security Status</h3>
          <p class="text-2xl font-semibold text-foreground">Good</p>
        </div>
        <div>
          <div class="bg-blue-500/20 rounded-lg">
            <div class="w-10 h-10 bg-blue-500/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-blue-500 rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'shield' size="16" class='w-4 h-4 text-blue-500-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">2FA Enabled</span>
        Last updated
      </p>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <!-- Profile Settings -->
    <div class=" border border-border rounded-lg p-6 mb-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center">
          {{{icon 'user' size="16" class='w-4 h-4 text-primary'}}}
        </div>
        <h2 class="text-xl font-semibold text-foreground">Profile Settings</h2>
      </div>

      <form class="space-y-6">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label for="firstName" class="block text-sm font-medium text-foreground mb-2">First Name</label>
            <input type="text" id="firstName" name="firstName"
              class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
              value="John">
          </div>
          <div>
            <label for="lastName" class="block text-sm font-medium text-foreground mb-2">Last Name</label>
            <input type="text" id="lastName" name="lastName"
              class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
              value="Doe">
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-foreground mb-2">Email Address</label>
          <input type="email" id="email" name="email"
            class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
            value="john.doe@example.com">
        </div>

        <div>
          <label for="bio" class="block text-sm font-medium text-foreground mb-2">Bio</label>
          <textarea id="bio" name="bio" rows="3"
            class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary resize-none"
            placeholder="Tell us about yourself...">Experienced project manager with a passion for innovation.</textarea>
        </div>

        <div class="flex gap-3">
          <button type="submit" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">Save
            Changes</button>
          <button type="button"
            class="px-4 py-2 border border-border text-foreground rounded-md hover:bg-muted">Cancel</button>
        </div>
      </form>
    </div>
    <!-- Security & Privacy Section -->
    <div class=" border border-border rounded-lg p-6 mb-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 bg-success/10 rounded-lg flex items-center justify-center">
          {{{icon 'shield' size="16" class='w-4 h-4 text-success'}}}
        </div>
        <h2 class="text-xl font-semibold text-foreground">Security & Privacy</h2>
      </div>

      <!-- Security Settings -->
      <div class="mb-6">
        <h3 class="font-semibold text-foreground mb-4">Security</h3>
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-foreground">Two-Factor Authentication</p>
              <p class="text-sm text-muted-foreground">Add an extra layer of security to your account</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer">
              <div
                class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary">
              </div>
            </label>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-foreground">Login Notifications</p>
              <p class="text-sm text-muted-foreground">Get notified of new sign-ins to your account</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer" checked>
              <div
                class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary">
              </div>
            </label>
          </div>
          <div>
            <p class="font-medium text-foreground mb-2">Change Password</p>
            <button class="px-4 py-2 border border-border text-foreground rounded-md hover:bg-muted">Change
              Password</button>
          </div>
        </div>
      </div>

      <!-- Privacy Settings -->
      <div class="mb-6">
        <h3 class="font-semibold text-foreground mb-4">Privacy</h3>
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-foreground">Profile Visibility</p>
              <p class="text-sm text-muted-foreground">Control who can see your profile information</p>
            </div>
            <select class="px-3 py-1 border border-border rounded text-sm">
              <option>Public</option>
              <option>Team Only</option>
              <option>Private</option>
            </select>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-foreground">Activity Status</p>
              <p class="text-sm text-muted-foreground">Show when you're active on the platform</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer" checked>
              <div
                class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary">
              </div>
            </label>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-foreground">Data Collection</p>
              <p class="text-sm text-muted-foreground">Allow analytics and usage data collection</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer" checked>
              <div
                class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary">
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class=" border border-border rounded-lg p-6 mb-6 grid gap-4  grid-cols-4">
    <!-- Buy Credits Section -->
    <div class=" col-span-3">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 bg-amber-500/10 rounded-lg flex items-center justify-center">
          {{{icon 'coins' size="16" class='w-4 h-4 text-amber-600'}}}
        </div>
        <h2 class="text-xl font-semibold text-foreground">Buy Credits</h2>
      </div>

      <p class="text-muted-foreground mb-6">Purchase credits to unlock premium features and accelerate your startup
        journey.</p>

      <!-- Credit Packages -->
      <div id="credit-packages" class="grid grid-cols-3 gap-4 mb-6">
        <!-- Packages will be loaded dynamically -->
      </div>

      <!-- Current Balance -->
      <div id="current-balance" class="p-4 bg-muted/50 rounded-lg">
        <!-- Balance will be loaded dynamically -->
      </div>
    </div>
    <!-- Billing History -->
    <div id="billing-history" class="mb-6 p-4 bg-muted/50 rounded-lg">
      <!-- Billing history will be loaded dynamically -->
    </div>
  </div>
  <div class=" border border-border rounded-lg p-6 mb-6 grid gap-4  grid-cols-4">
    <div class="flex flex-col col-span-3 gap-4">
      <!-- Upgrade Plan Section -->
      <div class="">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 bg-green-500/10 rounded-lg flex items-center justify-center">
            {{{icon 'trending-up' size="16" class='w-4 h-4 text-green-600'}}}
          </div>
          <h2 class="text-xl font-semibold text-foreground">Upgrade Your Plan</h2>
        </div>

        <p class="text-muted-foreground mb-6">Choose the plan that best fits your needs.</p>

        <!-- Subscription Plans -->
        <div id="subscription-plans" class="grid grid-cols-3 gap-4">
          <!-- Plans will be loaded dynamically -->
        </div>
      </div>
      <!-- Current Subscription Details -->
      <div id="current-plan" class="mb-6 p-4 bg-muted/50 rounded-lg">
        <!-- Subscription details will be loaded dynamically -->
      </div>
    </div>

    <!-- Current Subscription Details -->
    <div class="mb-6 p-4 bg-muted/50 rounded-lg">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold text-foreground">Current Subscription</h3>
        <span class="px-3 py-1 bg-primary text-primary-foreground text-sm rounded-md">Pro Plan</span>
      </div>
      <div class="grid grid-cols-1 gap-4">
        <div>
          <p class="text-sm text-muted-foreground">Monthly Cost</p>
          <p class="text-2xl font-semibold text-foreground">$29.99</p>
        </div>
        <div>
          <p class="text-sm text-muted-foreground">Next Billing Date</p>
          <p class="text-lg font-medium text-foreground">December 15, 2024</p>
        </div>
        <div>
          <p class="text-sm text-muted-foreground">Status</p>
          <p class="text-lg font-medium text-green-600">Active</p>
        </div>
      </div>

      <!-- Billing History -->
      <div>
        <h3 class="font-semibold text-foreground mb-4">Recent Transactions</h3>
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 border border-border rounded-lg">
            <div>
              <p class="font-medium text-foreground">Pro Plan - November 2024</p>
              <p class="text-sm text-muted-foreground">Auto-payment</p>
            </div>
            <div class="text-right">
              <p class="font-medium text-foreground">$29.99</p>
              <span class="text-xs text-green-600 bg-green-50 px-2 py-1 rounded">Paid</span>
            </div>
          </div>
          <div class="flex items-center justify-between p-3 border border-border rounded-lg">
            <div>
              <p class="font-medium text-foreground">Credit Purchase</p>
              <p class="text-sm text-muted-foreground">100 Credits</p>
            </div>
            <div class="text-right">
              <p class="font-medium text-foreground">$9.99</p>
              <span class="text-xs text-green-600 bg-green-50 px-2 py-1 rounded">Paid</span>
            </div>
          </div>





        </div>
      </div>
    </div>
  </div>




  <!-- Data Management -->
  <div>
    <h3 class="font-semibold text-foreground mb-4">Data Management</h3>
    <div class="grid grid-cols-3 gap-4">
      <div class="grid grid-cols-1 gap-4">

        <div class="p-4 border border-border rounded-lg">
          <p class="font-medium text-foreground mb-2">Export Your Data</p>
          <p class="text-sm text-muted-foreground mb-3">Download a copy of all your data</p>
          <button class="w-full px-4 py-2 border border-border text-foreground rounded-md hover:bg-muted">Export
            Data</button>
        </div>
        <div class="p-4 border border-destructive/20 rounded-lg">
          <p class="font-medium text-destructive mb-2">Delete Account</p>
          <p class="text-sm text-muted-foreground mb-3">Permanently delete your account and all associated data</p>
          <button
            class="w-full px-4 py-2 border border-destructive text-destructive rounded-md hover:bg-destructive/10">Delete
            Account</button>
        </div>
      </div>

      <!-- Credits Section -->
      <div class=" border border-border rounded-lg p-6 mb-6">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 bg-amber-500/10 rounded-lg flex items-center justify-center">
            {{{icon 'coins' size="16" class='w-4 h-4 text-amber-600'}}}
          </div>
          <h2 class="text-xl font-semibold text-foreground">Credits</h2>
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 border border-border rounded-lg">
            <div class="flex items-center gap-3">
              {{{icon 'coins' size="20" class="w-5 h-5 text-amber-600"}}}
              <div>
                <p class="font-medium">Current Balance</p>
                <p class="text-sm text-muted-foreground">Credits available for use</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold text-amber-600">150</p>
              <p class="text-sm text-muted-foreground">Credits</p>
            </div>
          </div>

          <div class="flex items-center justify-between p-4 border border-border rounded-lg">
            <div class="flex items-center gap-3">
              {{{icon 'history' size="20" class="w-5 h-5 text-primary"}}}
              <div>
                <p class="font-medium">Transaction History</p>
                <p class="text-sm text-muted-foreground">View your credit transactions</p>
              </div>
            </div>
            <button onclick="showTransactionHistory()"
              class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">View
              History</button>
          </div>
        </div>
      </div>

      <!-- Quick Settings -->
      <div class=" border border-border rounded-lg p-6 mb-6">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 bg-purple-500/10 rounded-lg flex items-center justify-center">
            {{{icon 'zap' size="16" class='w-4 h-4 text-purple-600'}}}
          </div>
          <h2 class="text-xl font-semibold text-foreground">Quick Settings</h2>
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-foreground">Email Notifications</p>
              <p class="text-sm text-muted-foreground">Receive email updates about your projects</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer">
              <div
                class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary">
              </div>
            </label>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-foreground">Dark Mode</p>
              <p class="text-sm text-muted-foreground">Toggle between light and dark themes</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="theme-toggle" class="sr-only peer" {{#if (eq userTheme "dark")}}checked{{/if}}
                hx-post="/htmx/user/theme"
                hx-vals='js:{theme: document.documentElement.classList.contains("dark") ? "light" : "dark"}'
                hx-target="#theme-icon"
                hx-swap="innerHTML"
                hx-on:htmx:after-request="this.checked = !this.checked; document.documentElement.classList.toggle('dark')">

              <span id="theme-icon">
                <span class="sun-icon{{#if (eq userTheme "dark")}} hidden{{/if}}">{{{icon 'sun-dim' size="16" class='h-4 w-4'}}}</span>
                <span class="moon-icon{{#unless (eq userTheme "dark")}} hidden{{/unless}}">{{{icon 'moon' size="16" class='h-4 w-4'}}}</span>
              </span>
              <div
                class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary">
              </div>
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>


