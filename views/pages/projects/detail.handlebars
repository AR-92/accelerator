<main class="flex w-full flex-col p-4 mx-auto max-w-7xl">
  <!-- Quick Stats -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-12">
    <div class="bg-card border border-border rounded-lg p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        {{icon "bar-chart-3" class="text-primary" size=20}}
        <span class="text-sm font-medium text-foreground">Models</span>
      </div>
      <p class="text-2xl font-bold text-foreground">{{#if project.idea_model}}1{{else}}0{{/if}}{{#if
        project.business_model}}+1{{/if}}{{#if project.financial_model}}+1{{/if}}{{#if
        project.funding_model}}+1{{/if}}{{#if project.legal_model}}+1{{/if}}{{#if
        project.marketing_model}}+1{{/if}}{{#if project.team_model}}+1{{/if}} / 7</p>
      <p class="text-xs text-muted-foreground">Completed</p>
    </div>
    <div class="bg-card border border-border rounded-lg p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        {{icon "check-square" class="text-success" size=20}}
        <span class="text-sm font-medium text-foreground">Tasks</span>
      </div>
      <p class="text-2xl font-bold text-foreground">{{#if project.tasks}}{{project.tasks.length}}{{else}}0{{/if}}</p>
      <p class="text-xs text-muted-foreground">Total</p>
    </div>
    <div class="bg-card border border-border rounded-lg p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        {{icon "users" class="text-info" size=20}}
        <span class="text-sm font-medium text-foreground">Team</span>
      </div>
      <p class="text-2xl font-bold text-foreground">{{#if project.team}}{{project.team.length}}{{else}}0{{/if}}</p>
      <p class="text-xs text-muted-foreground">Members</p>
    </div>
    <div class="bg-card border border-border rounded-lg p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        {{icon "eye" class="text-purple-500" size=20}}
        <span class="text-sm font-medium text-foreground">Views</span>
      </div>
      <p class="text-2xl font-bold text-foreground">{{project.views}}</p>
      <p class="text-xs text-muted-foreground">Total</p>
    </div>
    <div class="bg-card border border-border rounded-lg p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        {{icon "star" class="text-yellow-500" size=20}}
        <span class="text-sm font-medium text-foreground">Rating</span>
      </div>
      <p class="text-2xl font-bold text-foreground">{{project.rating}}</p>
      <p class="text-xs text-muted-foreground">Average</p>
    </div>
    <div class="bg-card border border-border rounded-lg p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        {{icon "trending-up" class="text-warning" size=20}}
        <span class="text-sm font-medium text-foreground">Progress</span>
      </div>
      <p class="text-2xl font-bold text-foreground">{{#if project.idea_model}}14{{else}}0{{/if}}{{#if
        project.business_model}}+14{{/if}}{{#if project.financial_model}}+14{{/if}}{{#if
        project.funding_model}}+14{{/if}}{{#if project.legal_model}}+14{{/if}}{{#if
        project.marketing_model}}+14{{/if}}{{#if project.team_model}}+14{{/if}}%</p>
      <p class="text-xs text-muted-foreground">Overall</p>
    </div>
  </div>
  <div class="grid grid-cols-4">
    <!-- Header -->
    <header class="col-span-3 w-full mb-12">
      <div class="bg-card border border-border rounded-lg p-6 shadow-sm mb-8">
        <div class="flex items-center gap-3 mb-4">
          {{icon "briefcase" class="text-primary" size=32}}
          <h1 class="text-3xl font-semibold text-foreground">
            {{project.name}}
          </h1>
        </div>
        <p class="text-muted-foreground text-base ml-11 mb-4">
          {{project.description}}
        </p>
        <div class="flex flex-wrap items-center gap-4 ml-11 mb-4">
          {{#if project.category}}
          <div class="flex items-center gap-2">
            {{icon "folder" class="text-muted-foreground" size=14}}
            <span class="text-sm text-muted-foreground">{{project.category}}</span>
          </div>
          {{/if}}
          {{#if project.tags}}
          <div class="flex items-center gap-2">
            {{icon "tag" class="text-muted-foreground" size=14}}
            {{#each project.tags}}
            <span class="px-2 py-0.5 bg-secondary/10 text-secondary-foreground text-xs rounded-full">{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
        </div>
        <div class="flex items-center gap-6 ml-11">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-primary rounded-full"></div>
            <span class="text-sm text-muted-foreground">Active Project</span>
          </div>
          <div class="flex items-center gap-2">
            {{icon "clock" class="text-muted-foreground" size=14}}
            <span class="text-sm text-muted-foreground" id="creation-time">Created {{project.created_at}}</span>
          </div>
        </div>
      </div>
      <!-- Back to All Projects -->
      <section class="mt-20">
        <a href="/admin/other-pages/new-project?showCard=true"
          class="inline-flex items-center gap-2 text-primary text-sm font-medium hover:text-primary/80 transition-colors">
          {{icon "arrow-left" size=16}}
          Back to All Projects
        </a>
      </section>
    </header>


    <div class="mb-8 col-span-1 px-4 gap-4">
      <!-- Project Models Section -->
      <section class="">
        <div class="flex items-center gap-2 mb-6">
          {{icon "bar-chart-3" class="text-primary" size=20}}
          <h2 class="text-lg font-semibold text-foreground">Project Models</h2>
        </div>
        <div class="space-y-3">
          <!-- Idea Model -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "lightbulb" class="{{#if project.idea_model}}text-success{{else}}text-muted-foreground{{/if}}"
              size=18}}
              <span class="text-sm font-medium text-foreground">Idea Model</span>
            </div>
            {{#if project.idea_model}}
            {{icon "check-circle" class="text-success" size=18}}
            {{else}}
            <a href="/projects/idea-model" class="text-primary hover:text-primary/80">
              {{icon "plus" size=18}}
            </a>
            {{/if}}
          </div>

          <!-- Business Model -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "building-2" class="{{#if project.business_model}}text-success{{else}}text-muted-foreground{{/if}}"
              size=18}}
              <span class="text-sm font-medium text-foreground">Business Model</span>
            </div>
            {{#if project.business_model}}
            {{icon "check-circle" class="text-success" size=18}}
            {{else}}
            <a href="/projects/business-model" class="text-primary hover:text-primary/80">
              {{icon "plus" size=18}}
            </a>
            {{/if}}
          </div>

          <!-- Financial Model -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "dollar-sign" class="{{#if
              project.financial_model}}text-success{{else}}text-muted-foreground{{/if}}"
              size=18}}
              <span class="text-sm font-medium text-foreground">Financial Model</span>
            </div>
            {{#if project.financial_model}}
            {{icon "check-circle" class="text-success" size=18}}
            {{else}}
            <a href="/projects/financial-model" class="text-primary hover:text-primary/80">
              {{icon "plus" size=18}}
            </a>
            {{/if}}
          </div>

          <!-- Funding Model -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "wallet" class="{{#if project.funding_model}}text-success{{else}}text-muted-foreground{{/if}}"
              size=18}}
              <span class="text-sm font-medium text-foreground">Funding Model</span>
            </div>
            {{#if project.funding_model}}
            {{icon "check-circle" class="text-success" size=18}}
            {{else}}
            <a href="/projects/funding-model" class="text-primary hover:text-primary/80">
              {{icon "plus" size=18}}
            </a>
            {{/if}}
          </div>

          <!-- Legal Model -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "file-text" class="{{#if project.legal_model}}text-success{{else}}text-muted-foreground{{/if}}"
              size=18}}
              <span class="text-sm font-medium text-foreground">Legal Model</span>
            </div>
            {{#if project.legal_model}}
            {{icon "check-circle" class="text-success" size=18}}
            {{else}}
            <a href="/projects/legal-model" class="text-primary hover:text-primary/80">
              {{icon "plus" size=18}}
            </a>
            {{/if}}
          </div>

          <!-- Marketing Model -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "megaphone" class="{{#if project.marketing_model}}text-success{{else}}text-muted-foreground{{/if}}"
              size=18}}
              <span class="text-sm font-medium text-foreground">Marketing Model</span>
            </div>
            {{#if project.marketing_model}}
            {{icon "check-circle" class="text-success" size=18}}
            {{else}}
            <a href="/projects/marketing-model" class="text-primary hover:text-primary/80">
              {{icon "plus" size=18}}
            </a>
            {{/if}}
          </div>

          <!-- Team Model -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "users" class="{{#if project.team_model}}text-success{{else}}text-muted-foreground{{/if}}"
              size=18}}
              <span class="text-sm font-medium text-foreground">Team Model</span>
            </div>
            {{#if project.team_model}}
            {{icon "check-circle" class="text-success" size=18}}
            {{else}}
            <a href="/projects/team-model" class="text-primary hover:text-primary/80">
              {{icon "plus" size=18}}
            </a>
            {{/if}}
          </div>
        </div>
      </section>

      <!-- Reports Section -->
      <section class="mt-6">
        <div class="flex items-center gap-2 mb-6">
          {{icon "file-bar-chart" class="text-primary" size=20}}
          <h2 class="text-lg font-semibold text-foreground">Reports</h2>
        </div>
        <div class="space-y-3">
          <!-- Pitch Deck -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "presentation" class="text-muted-foreground" size=18}}
              <span class="text-sm font-medium text-foreground">Pitch Deck</span>
            </div>
            <span class="text-xs text-muted-foreground">Coming soon</span>
          </div>

          <!-- Business Plan -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "clipboard-list" class="text-muted-foreground" size=18}}
              <span class="text-sm font-medium text-foreground">Business Plan</span>
            </div>
            <span class="text-xs text-muted-foreground">Coming soon</span>
          </div>

          <!-- Valuation -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {{icon "trending-up" class="text-muted-foreground" size=18}}
              <span class="text-sm font-medium text-foreground">Valuation</span>
            </div>
            <span class="text-xs text-muted-foreground">Coming soon</span>
          </div>
        </div>
      </section>
    </div>
  </div>



</main>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const timeSpan = document.getElementById('creation-time');
    if (timeSpan) {
      const text = timeSpan.textContent.replace('Created ', '');
      const date = new Date(text);
      if (!isNaN(date.getTime())) {
        timeSpan.textContent = 'Created ' + date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });
      }
    }
  });
</script>