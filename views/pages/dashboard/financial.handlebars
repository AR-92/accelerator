    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Financial Management
          </h1>
          <p class="text-lg text-muted-foreground">
            Create detailed financial projections
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-primary">
            {{{icon 'plus' size='16'}}}
            New Financial Model
          </button>
        </div>
      </div>

      <!-- Financial Overview Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Net Income</h3>
              <p class="text-lg font-semibold {{#if (gt incomeStatement.netIncome 0)}}text-success{{else}}text-destructive{{/if}}">
                ${{incomeStatement.netIncome}}
              </p>
            </div>
            <div class="bg-step-revenue/20 rounded-lg">
              <div class="w-10 h-10 bg-step-revenue/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-revenue rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'dollar-sign' size="16" class='w-4 h-4 text-step-revenue-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Cash Position</h3>
              <p class="text-lg font-semibold text-step-kpi">${{cashFlow.endingCash}}</p>
            </div>
            <div class="bg-step-kpi/20 rounded-lg">
              <div class="w-10 h-10 bg-step-kpi/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-kpi rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'wallet' size="16" class='w-4 h-4 text-step-kpi-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Total Assets</h3>
              <p class="text-lg font-semibold text-step-streams">${{balanceSheet.totalAssets}}</p>
            </div>
            <div class="bg-step-streams/20 rounded-lg">
              <div class="w-10 h-10 bg-step-streams/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-streams rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'building' size="16" class='w-4 h-4 text-step-streams-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Funding Allocated</h3>
              <p class="text-lg font-semibold text-step-cogs">${{fundingAllocation.total}}</p>
            </div>
            <div class="bg-step-cogs/20 rounded-lg">
              <div class="w-10 h-10 bg-step-cogs/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-cogs rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'pie-chart' size="16" class='w-4 h-4 text-step-cogs-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Income Statement -->
        <div class="bg-card rounded-lg border border-border p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-foreground">Income Statement</h2>
            <button class="btn btn-ghost text-sm">
              View Details
              {{{icon 'arrow-right' size='14'}}}
            </button>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Revenue</span>
              <span class="text-sm font-semibold text-success">${{incomeStatement.revenue}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Cost of Revenue</span>
              <span class="text-sm font-semibold text-destructive">${{incomeStatement.costOfRevenue}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Gross Profit</span>
              <span class="text-sm font-semibold text-step-revenue">${{incomeStatement.grossProfit}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Operating Expenses</span>
              <span class="text-sm font-semibold text-step-cogs">${{incomeStatement.operatingExpenses}}</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-sm font-bold text-foreground">Net Income</span>
              <span class="text-sm font-bold {{#if (gt incomeStatement.netIncome 0)}}text-success{{else}}text-destructive{{/if}}">
                ${{incomeStatement.netIncome}}
              </span>
            </div>
          </div>
        </div>

        <!-- Cash Flow Statement -->
        <div class="bg-card rounded-lg border border-border p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-foreground">Cash Flow</h2>
            <button class="btn btn-ghost text-sm">
              View Details
              {{{icon 'arrow-right' size='14'}}}
            </button>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Operating Cash Flow</span>
              <span class="text-sm font-semibold text-step-kpi">${{cashFlow.operatingCashFlow}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Investing Cash Flow</span>
              <span class="text-sm font-semibold text-step-capex">${{cashFlow.investingCashFlow}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Financing Cash Flow</span>
              <span class="text-sm font-semibold text-step-opex">${{cashFlow.financingCashFlow}}</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-sm font-bold text-foreground">Net Cash Flow</span>
              <span class="text-sm font-bold {{#if (gt cashFlow.netCashFlow 0)}}text-success{{else}}text-destructive{{/if}}">
                ${{cashFlow.netCashFlow}}
              </span>
            </div>
            <div class="flex items-center justify-between py-2 border-t border-border">
              <span class="text-sm font-medium text-foreground">Ending Cash Balance</span>
              <span class="text-sm font-semibold text-step-kpi">${{cashFlow.endingCash}}</span>
            </div>
          </div>
        </div>

        <!-- Balance Sheet -->
        <div class="bg-card rounded-lg border border-border p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-foreground">Balance Sheet</h2>
            <button class="btn btn-ghost text-sm">
              View Details
              {{{icon 'arrow-right' size='14'}}}
            </button>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Total Assets</span>
              <span class="text-sm font-semibold text-step-streams">${{balanceSheet.totalAssets}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Current Assets</span>
              <span class="text-sm font-semibold text-step-revenue">${{balanceSheet.currentAssets}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Total Liabilities</span>
              <span class="text-sm font-semibold text-destructive">${{balanceSheet.totalLiabilities}}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <span class="text-sm font-medium text-foreground">Current Liabilities</span>
              <span class="text-sm font-semibold text-step-cogs">${{balanceSheet.currentLiabilities}}</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <span class="text-sm font-bold text-foreground">Total Equity</span>
              <span class="text-sm font-bold text-step-kpi">${{balanceSheet.totalEquity}}</span>
            </div>
          </div>
        </div>

        <!-- Funding Allocation -->
        <div class="bg-card rounded-lg border border-border p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-foreground">Funding Allocation</h2>
            <button class="btn btn-ghost text-sm">
              Manage Funds
              {{{icon 'settings' size='14'}}}
            </button>
          </div>
          <div class="space-y-4">
            <div class="text-center">
              <div class="text-2xl font-bold text-step-cogs mb-1">${{fundingAllocation.total}}</div>
              <p class="text-sm text-muted-foreground">Total Allocated</p>
            </div>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-foreground">Product Development</span>
                <span class="text-sm font-semibold text-step-revenue">${{fundingAllocation.categories.product}}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-foreground">Marketing</span>
                <span class="text-sm font-semibold text-step-streams">${{fundingAllocation.categories.marketing}}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-foreground">Operations</span>
                <span class="text-sm font-semibold text-step-cogs">${{fundingAllocation.categories.operations}}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-foreground">R&D</span>
                <span class="text-sm font-semibold text-step-capex">${{fundingAllocation.categories.rAndD}}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Revenue Models & Projections -->
      <div class="bg-card rounded-lg border border-border p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-foreground">Revenue Models & Projections</h2>
          <button class="btn btn-ghost text-sm">
            Add Model
            {{{icon 'plus' size='14'}}}
          </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <div class="text-center p-4 bg-step-revenue/10 rounded-lg">
            <div class="text-xl font-bold text-step-revenue mb-1">${{revenueModels.projections.monthly}}</div>
            <p class="text-sm text-muted-foreground">Monthly Projection</p>
          </div>
          <div class="text-center p-4 bg-step-revenue/10 rounded-lg">
            <div class="text-xl font-bold text-step-revenue mb-1">${{revenueModels.projections.quarterly}}</div>
            <p class="text-sm text-muted-foreground">Quarterly Projection</p>
          </div>
          <div class="text-center p-4 bg-step-revenue/10 rounded-lg">
            <div class="text-xl font-bold text-step-revenue mb-1">${{revenueModels.projections.annual}}</div>
            <p class="text-sm text-muted-foreground">Annual Projection</p>
          </div>
        </div>
        {{#if revenueModels.models.length}}
          <div class="space-y-3">
            {{#each revenueModels.models}}
            <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg border border-border/50">
              <div>
                <h4 class="font-medium text-foreground text-sm">{{name}}</h4>
                <p class="text-xs text-muted-foreground">{{type}}</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-medium text-success">${{monthly_projection}}</p>
                <p class="text-xs text-muted-foreground">monthly</p>
              </div>
            </div>
            {{/each}}
          </div>
        {{else}}
          <div class="text-center py-8">
            <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
              {{{icon 'trending-up' size='24' class='text-muted-foreground'}}}
            </div>
            <h3 class="text-lg font-medium text-foreground mb-2">No revenue models defined</h3>
            <p class="text-muted-foreground mb-4">Create revenue projections and models</p>
            <button class="btn btn-primary">Create Revenue Model</button>
          </div>
        {{/if}}
      </div>

      <!-- Enterprise/Corporate Specific Sections -->
      {{#if features.enterprise}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Enterprise Pricing</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">$45K</div>
            <p class="text-sm text-muted-foreground">Avg Contract Value</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">18</div>
            <p class="text-sm text-muted-foreground">Pricing Tiers</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">92%</div>
            <p class="text-sm text-muted-foreground">Pricing Optimization</p>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if features.corporate}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Consolidated Financials</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">$125M</div>
            <p class="text-sm text-muted-foreground">Consolidated Revenue</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">$89M</div>
            <p class="text-sm text-muted-foreground">M&A Value Created</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-cogs mb-2">15</div>
            <p class="text-sm text-muted-foreground">Business Units</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">96%</div>
            <p class="text-sm text-muted-foreground">Reporting Compliance</p>
          </div>
        </div>
      </div>
      {{/if}}
