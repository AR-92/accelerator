<div class="flex flex-col gap-4 lg:gap-6 mt-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-3xl font-semibold text-foreground">
        Business Management
      </h1>
      <p class="text-lg text-muted-foreground">
        Build comprehensive business models
      </p>
    </div>
  </div>

  <!-- Business Overview Cards -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Business Model</h3>
          <p class="text-lg font-semibold text-foreground">{{businessModel.type}}</p>
        </div>
        <div class="bg-step-revenue/20 rounded-lg">
          <div class="w-10 h-10 bg-step-revenue/20 rounded-lg relative">
            <div class="flex items-center justify-center w-9 h-9 bg-step-revenue rounded-lg absolute top-0.5 left-0.5">
              {{{icon 'briefcase' size="16" class='w-4 h-4 text-step-revenue-foreground'}}}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Monthly Revenue</h3>
          <p class="text-lg font-semibold text-success">${{revenueStreams.totals.monthly}}</p>
        </div>
        <div class="bg-success/20 rounded-lg">
          <div class="w-10 h-10 bg-success/20 rounded-lg relative">
            <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
              {{{icon 'trending-up' size="16" class='w-4 h-4 text-success-foreground'}}}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Monthly Costs</h3>
          <p class="text-lg font-semibold text-destructive">${{costStructure.totals.monthly}}</p>
        </div>
        <div class="bg-destructive/20 rounded-lg">
          <div class="w-10 h-10 bg-destructive/20 rounded-lg relative">
            <div class="flex items-center justify-center w-9 h-9 bg-destructive rounded-lg absolute top-0.5 left-0.5">
              {{{icon 'trending-down' size="16" class='w-4 h-4 text-destructive-foreground'}}}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Active Partnerships</h3>
          <p class="text-lg font-semibold text-step-streams">{{partnerships.stats.active}}</p>
        </div>
        <div class="bg-step-streams/20 rounded-lg">
          <div class="w-10 h-10 bg-step-streams/20 rounded-lg relative">
            <div class="flex items-center justify-center w-9 h-9 bg-step-streams rounded-lg absolute top-0.5 left-0.5">
              {{{icon 'users' size="16" class='w-4 h-4 text-step-streams-foreground'}}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Value Propositions & Revenue Streams -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Value Propositions -->
      <div class="bg-card rounded-lg border border-border p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-foreground">Value Propositions</h2>
          <button class="btn btn-ghost text-sm">
            Add New
            {{{icon 'plus' size='14'}}}
          </button>
        </div>
        <div class="space-y-4">
          {{#if valuePropositions.length}}
          {{#each valuePropositions}}
          <div class="p-4 bg-muted/50 rounded-lg border border-border/50">
            <h3 class="font-medium text-foreground mb-2">{{title}}</h3>
            <p class="text-sm text-muted-foreground mb-3">{{description}}</p>
            <div class="flex items-center gap-2">
              <span class="tag tag-primary">{{target}}</span>
              <span class="text-xs text-muted-foreground">{{benefits}}</span>
            </div>
          </div>
          {{/each}}
          {{else}}
          <div class="text-center py-8">
            <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
              {{{icon 'target' size='24' class='text-muted-foreground'}}}
            </div>
            <h3 class="text-lg font-medium text-foreground mb-2">No value propositions defined</h3>
            <p class="text-muted-foreground mb-4">Define what makes your solution valuable</p>
            <button class="btn btn-primary">Create Value Proposition</button>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Revenue Streams -->
      <div class="bg-card rounded-lg border border-border p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-foreground">Revenue Streams</h2>
          <button class="btn btn-ghost text-sm">
            Add Stream
            {{{icon 'plus' size='14'}}}
          </button>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="text-center p-3 bg-step-revenue/10 rounded-lg">
            <div class="text-lg font-bold text-step-revenue">${{revenueStreams.totals.monthly}}</div>
            <p class="text-xs text-muted-foreground">Monthly Revenue</p>
          </div>
          <div class="text-center p-3 bg-step-revenue/10 rounded-lg">
            <div class="text-lg font-bold text-step-revenue">${{revenueStreams.totals.annual}}</div>
            <p class="text-xs text-muted-foreground">Annual Revenue</p>
          </div>
        </div>
        <div class="space-y-3">
          {{#if revenueStreams.streams.length}}
          {{#each revenueStreams.streams}}
          <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg">
            <div>
              <h4 class="font-medium text-foreground text-sm">{{name}}</h4>
              <p class="text-xs text-muted-foreground">{{type}}</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-medium text-success">${{monthly_revenue}}</p>
              <p class="text-xs text-muted-foreground">monthly</p>
            </div>
          </div>
          {{/each}}
          {{else}}
          <div class="text-center py-4">
            <p class="text-sm text-muted-foreground">No revenue streams defined</p>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- Cost Structure & Market Analysis -->
    <div class="space-y-6">
      <!-- Cost Structure -->
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Cost Structure</h2>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="text-center p-3 bg-step-cogs/10 rounded-lg">
            <div class="text-lg font-bold text-step-cogs">${{costStructure.totals.monthly}}</div>
            <p class="text-xs text-muted-foreground">Monthly Costs</p>
          </div>
          <div class="text-center p-3 bg-step-cogs/10 rounded-lg">
            <div class="text-lg font-bold text-step-cogs">${{costStructure.totals.annual}}</div>
            <p class="text-xs text-muted-foreground">Annual Costs</p>
          </div>
        </div>
        <div class="space-y-3">
          {{#if costStructure.costs.length}}
          {{#each costStructure.costs}}
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-foreground">{{name}}</span>
            <span class="text-sm text-step-cogs">${{monthly_cost}}</span>
          </div>
          {{/each}}
          {{else}}
          <div class="text-center py-4">
            <p class="text-sm text-muted-foreground">No costs defined</p>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Market Analysis -->
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Market Analysis</h2>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-muted-foreground">Market Size</span>
            <span class="text-sm font-medium text-foreground">{{marketAnalysis.marketSize}}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-muted-foreground">Growth Rate</span>
            <span class="text-sm font-medium text-success">{{marketAnalysis.growthRate}}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-muted-foreground">Competition</span>
            <span class="text-sm font-medium text-foreground">{{marketAnalysis.competition}}</span>
          </div>
        </div>
      </div>

      <!-- Partnerships -->
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Partnerships</h2>
        <div class="grid grid-cols-3 gap-2 mb-4">
          <div class="text-center">
            <div class="text-lg font-bold text-step-streams">{{partnerships.stats.active}}</div>
            <p class="text-xs text-muted-foreground">Active</p>
          </div>
          <div class="text-center">
            <div class="text-lg font-bold text-warning">{{partnerships.stats.pending}}</div>
            <p class="text-xs text-muted-foreground">Pending</p>
          </div>
          <div class="text-center">
            <div class="text-lg font-bold text-success">{{partnerships.stats.completed}}</div>
            <p class="text-xs text-muted-foreground">Completed</p>
          </div>
        </div>
        {{#if partnerships.partnerships.length}}
        <div class="space-y-2">
          {{#each partnerships.partnerships}}
          <div class="text-xs p-2 bg-muted/50 rounded">
            <span class="font-medium">{{partner_name}}</span>
            <span class="text-muted-foreground"> - {{type}}</span>
          </div>
          {{/each}}
        </div>
        {{else}}
        <p class="text-xs text-muted-foreground text-center">No partnerships</p>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<!-- Enterprise/Corporate Specific Sections -->
{{#if features.enterprise}}
<div class="bg-card rounded-lg border border-border p-6">
  <h2 class="text-xl font-semibold text-foreground mb-4">Enterprise Contracts</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="text-center">
      <div class="text-3xl font-bold text-step-revenue mb-2">24</div>
      <p class="text-sm text-muted-foreground">Active Contracts</p>
    </div>
    <div class="text-center">
      <div class="text-3xl font-bold text-step-streams mb-2">$2.1M</div>
      <p class="text-sm text-muted-foreground">Contract Value</p>
    </div>
    <div class="text-center">
      <div class="text-3xl font-bold text-step-kpi mb-2">96%</div>
      <p class="text-sm text-muted-foreground">Satisfaction Rate</p>
    </div>
  </div>
</div>
{{/if}}

{{#if features.corporate}}
<div class="bg-card rounded-lg border border-border p-6">
  <h2 class="text-xl font-semibold text-foreground mb-4">Corporate Unit Management</h2>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="text-center">
      <div class="text-3xl font-bold text-step-kpi mb-2">12</div>
      <p class="text-sm text-muted-foreground">Business Units</p>
    </div>
    <div class="text-center">
      <div class="text-3xl font-bold text-step-revenue mb-2">$45M</div>
      <p class="text-sm text-muted-foreground">Synergy Value</p>
    </div>
    <div class="text-center">
      <div class="text-3xl font-bold text-step-cogs mb-2">8</div>
      <p class="text-sm text-muted-foreground">Diversification Areas</p>
    </div>
    <div class="text-center">
      <div class="text-3xl font-bold text-step-streams mb-2">94%</div>
      <p class="text-sm text-muted-foreground">Portfolio Efficiency</p>
    </div>
  </div>
  {{/if}}
</div>