<!-- User Management Content -->
<div id="user-management-content" class="max-w-7xl mx-auto rounded-xl overflow-hidden flex flex-col mx-4 my-4">

    <!-- Page Header -->
    {{> page-header title="User Management" description="Manage user accounts, roles, and permissions across the platform" border=true}}

    <div class="p-6 space-y-8">
       <!-- User Statistics Overview -->
       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Total Users -->
          <div class="bg-card rounded-md border border-input/80 p-6">
             <div class="flex items-center justify-between">
                <div>
                   <p class="text-sm font-medium text-muted-foreground">Total Users</p>
                   <p class="text-2xl font-bold text-blue-600">{{stats.total}}</p>
                   <p class="text-xs text-muted-foreground">{{stats.active}} active</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-md flex items-center justify-center">
                   {{{icon 'users' size="16" class='text-blue-600'}}}
                </div>
             </div>
          </div>

          <!-- Startup Users -->
          <div class="bg-card rounded-md border border-input/80 p-6">
             <div class="flex items-center justify-between">
                <div>
                   <p class="text-sm font-medium text-muted-foreground">Startup Users</p>
                   <p class="text-2xl font-bold text-green-600">{{stats.startup}}</p>
                   <p class="text-xs text-muted-foreground">Basic tier</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-md flex items-center justify-center">
                   {{{icon 'rocket' size="16" class='text-green-600'}}}
                </div>
             </div>
          </div>

          <!-- Enterprise Users -->
          <div class="bg-card rounded-md border border-input/80 p-6">
             <div class="flex items-center justify-between">
                <div>
                   <p class="text-sm font-medium text-muted-foreground">Enterprise Users</p>
                   <p class="text-2xl font-bold text-purple-600">{{stats.enterprise}}</p>
                   <p class="text-xs text-muted-foreground">Advanced tier</p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-md flex items-center justify-center">
                   {{{icon 'building' size="16" class='text-purple-600'}}}
                </div>
             </div>
          </div>

          <!-- Corporate Users -->
          <div class="bg-card rounded-md border border-input/80 p-6">
             <div class="flex items-center justify-between">
                <div>
                   <p class="text-sm font-medium text-muted-foreground">Corporate Users</p>
                   <p class="text-2xl font-bold text-orange-600">{{stats.corporate}}</p>
                   <p class="text-xs text-muted-foreground">Premium tier</p>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-md flex items-center justify-center">
                   {{{icon 'building-2' size="16" class='text-orange-600'}}}
                </div>
             </div>
          </div>
       </div>

       <!-- User Management Actions -->
       <div class="bg-card rounded-md border border-input/80 p-6">
          <div class="flex items-center justify-between">
             <div>
                <h3 class="text-lg font-semibold text-card-foreground">User Management Actions</h3>
                <p class="text-sm text-muted-foreground">Quick actions for user administration</p>
             </div>
             <div class="flex items-center space-x-4">
                {{#each quickActions}}
                <a href="{{href}}" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors inline-flex items-center">
                   {{{icon icon size="16" class='mr-2'}}}
                   {{text}}
                </a>
                {{/each}}
             </div>
          </div>
       </div>

       <!-- Users by Role -->
       <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Startup Users -->
          <div class="bg-card rounded-md border border-input/80">
             <div class="p-6 border-b border-input/80">
                <h3 class="text-lg font-semibold text-card-foreground flex items-center">
                   {{{icon 'rocket' size="16" class='mr-2 text-green-600'}}}
                   Startup Users ({{usersByRole.startup.length}})
                </h3>
             </div>
             <div class="p-6 space-y-3 max-h-96 overflow-y-auto">
                {{#each usersByRole.startup}}
                <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg">
                   <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                         {{{icon 'user' size="16" class='text-green-600'}}}
                      </div>
                      <div>
                         <p class="text-sm font-medium text-card-foreground">{{email}}</p>
                         <p class="text-xs text-muted-foreground">Role: {{role}}</p>
                      </div>
                   </div>
                   <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium {{#eq status "active"}}bg-success/10 text-success{{else}}bg-muted text-muted-foreground{{/eq}}">
                     {{status}}
                   </span>
                </div>
                {{/each}}
                {{#if (eq usersByRole.startup.length 0)}}
                <div class="text-center py-8">
                   <p class="text-sm text-muted-foreground">No startup users found</p>
                </div>
                {{/if}}
             </div>
          </div>

          <!-- Enterprise Users -->
          <div class="bg-card rounded-md border border-input/80">
             <div class="p-6 border-b border-input/80">
                <h3 class="text-lg font-semibold text-card-foreground flex items-center">
                   {{{icon 'building' size="16" class='mr-2 text-purple-600'}}}
                   Enterprise Users ({{usersByRole.enterprise.length}})
                </h3>
             </div>
             <div class="p-6 space-y-3 max-h-96 overflow-y-auto">
                {{#each usersByRole.enterprise}}
                <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg">
                   <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                         {{{icon 'user' size="16" class='text-purple-600'}}}
                      </div>
                      <div>
                         <p class="text-sm font-medium text-card-foreground">{{email}}</p>
                         <p class="text-xs text-muted-foreground">Role: {{role}}</p>
                      </div>
                   </div>
                   <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium {{#eq status "active"}}bg-success/10 text-success{{else}}bg-muted text-muted-foreground{{/eq}}">
                     {{status}}
                   </span>
                </div>
                {{/each}}
                {{#if (eq usersByRole.enterprise.length 0)}}
                <div class="text-center py-8">
                   <p class="text-sm text-muted-foreground">No enterprise users found</p>
                </div>
                {{/if}}
             </div>
          </div>

          <!-- Corporate Users -->
          <div class="bg-card rounded-md border border-input/80">
             <div class="p-6 border-b border-input/80">
                <h3 class="text-lg font-semibold text-card-foreground flex items-center">
                   {{{icon 'building-2' size="16" class='mr-2 text-orange-600'}}}
                   Corporate Users ({{usersByRole.corporate.length}})
                </h3>
             </div>
             <div class="p-6 space-y-3 max-h-96 overflow-y-auto">
                {{#each usersByRole.corporate}}
                <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg">
                   <div class="flex items-center space-x-3">
                      <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center">
                         {{{icon 'user' size="16" class='text-orange-600'}}}
                      </div>
                      <div>
                         <p class="text-sm font-medium text-card-foreground">{{email}}</p>
                         <p class="text-xs text-muted-foreground">Role: {{role}}</p>
                      </div>
                   </div>
                   <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium {{#eq status "active"}}bg-success/10 text-success{{else}}bg-muted text-muted-foreground{{/eq}}">
                     {{status}}
                   </span>
                </div>
                {{/each}}
                {{#if (eq usersByRole.corporate.length 0)}}
                <div class="text-center py-8">
                   <p class="text-sm text-muted-foreground">No corporate users found</p>
                </div>
                {{/if}}
             </div>
          </div>
       </div>

       <!-- Recent User Activity -->
       <div class="bg-card rounded-md border border-input/80">
          <div class="p-6 border-b border-input/80">
             <h3 class="text-lg font-semibold text-card-foreground flex items-center">
                {{{icon 'activity' size="16" class='mr-2'}}}
                Recent User Activity
             </h3>
             <p class="text-sm text-muted-foreground mt-1">Latest user registrations and status changes</p>
          </div>
          <div class="p-6">
             <div class="space-y-4">
                {{#each users}}
                {{#if (gt @index 4)}}
                {{else}}
                <div class="flex items-center justify-between p-4 bg-muted/50 rounded-lg">
                   <div class="flex items-center space-x-3">
                      <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                         {{{icon 'user' size="16" class='text-primary'}}}
                      </div>
                      <div>
                         <p class="text-sm font-medium text-card-foreground">{{email}}</p>
                         <p class="text-xs text-muted-foreground">Role: {{role}} • Status: {{status}}</p>
                      </div>
                   </div>
                   <div class="text-right">
                      <p class="text-sm text-muted-foreground">{{created_at}}</p>
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium {{#eq status "active"}}bg-success/10 text-success{{else}}bg-muted text-muted-foreground{{/eq}}">
                        {{status}}
                      </span>
                   </div>
                </div>
                {{/if}}
                {{/each}}
             </div>
          </div>
       </div>
    </div>
</div>