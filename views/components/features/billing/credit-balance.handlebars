{{!-- HTMX Credit Balance Component --}}
<div class="credit-balance flex items-center justify-between text-sm flex-1"
     {{#if user}}
     hx-get="/htmx/user/credit-balance"
     hx-trigger="credit-updated"
     hx-swap="innerHTML"
     hx-target="this"
     {{/if}}>
  <span class="text-sm font-medium">{{balance}} Credits</span>
</div>