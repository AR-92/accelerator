<!-- Transaction History Modal -->
<div id="transaction-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-card rounded-lg shadow-xl max-w-2xl w-full max-h-[80vh] overflow-hidden">
      <div class="flex items-center justify-between p-6 border-b">
        <h3 class="text-lg font-semibold text-foreground">Credit Transaction History</h3>
        <button onclick="closeTransactionModal()" class="text-muted-foreground hover:text-foreground">
          {{{icon 'x' size="20"}}}
        </button>
      </div>

      <div id="transaction-list" class="p-6 overflow-y-auto max-h-96">
        <!-- Transactions will be loaded here -->
      </div>
    </div>
  </div>
</div>