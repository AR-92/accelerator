<article class="flex" role="region" aria-label="AI message">
  <div class="w-auto max-w-full">
    <div class="bg-muted rounded-2xl p-4 shadow-lg border border-input/80 hover:shadow-xl transition-all duration-300 w-fit">
      <header class="flex items-center gap-2 mb-3">
        <div class="relative">
          <div class="text-primary-foreground flex aspect-square size-8 items-center justify-center rounded-md flex-shrink-0" aria-label="AI avatar">
            <img src="/images/favcon.svg" alt="Logo" class="size-6">
          </div>
        </div>
        <div>
          <div class="text-sm font-semibold text-foreground">iGate Accelerator</div>
          <div class="text-xs text-muted-foreground">AI Assistant</div>
        </div>
      </header>
      <div class="mb-2">
        <h3 class="text-sm font-semibold text-primary bg-primary/10 rounded-md px-2 py-1 inline-block">{{title}}</h3>
      </div>
      <section class="bg-background/50 rounded-md p-3 mb-2 border border-input/80/50 relative" aria-label="Message content">
        <p class="text-foreground m-0">{{message}}</p>
      </section>
      <footer class="flex items-center justify-between mt-2">
        <div class="text-xs text-muted-foreground font-medium flex items-center gap-1">
          <svg class="w-3 h-3 lucide lucide-clock" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6v6l4 2"></path>
            <circle cx="12" cy="12" r="10"></circle>
          </svg>
          <time datetime="{{time}}">{{time}}</time>
        </div>
        <button class="h-8 w-8 flex items-center justify-center hover:bg-muted rounded-md transition-colors" title="Translate to Spanish" aria-label="Translate message">
          <svg class="w-4 h-4 lucide lucide-languages" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5 8 6 6"></path>
            <path d="m4 14 6-6 2-3"></path>
            <path d="M2 5h12"></path>
            <path d="M7 2h1"></path>
            <path d="m22 22-5-10-5 10"></path>
            <path d="M14 18h6"></path>
          </svg>
        </button>
      </footer>
    </div>
  </div>
</article>