{{!-- HTMX Project List Component --}}
<div class="project-list space-y-3"
     hx-get="/htmx/projects/recent"
      hx-trigger="project-created, project-updated"
     hx-swap="innerHTML"
     hx-target="this">
  {{#each projects}}
  <div class="project-item bg-card border border-input/80 rounded-lg p-4 hover:shadow-md transition-shadow">
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <h3 class="font-medium text-sm text-foreground">{{title}}</h3>
        {{#if description}}
        <p class="text-xs text-muted-foreground mt-1 line-clamp-2">{{description}}</p>
        {{/if}}
         <div class="flex items-center gap-2 mt-2">
           <span class="text-xs text-muted-foreground">
             Updated {{updated_at}}
           </span>
         </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 text-xs rounded-full bg-primary/10 text-primary">
          {{status}}
        </span>
      </div>
    </div>
  </div>
  {{else}}
  <div class="text-center py-8 text-muted-foreground">
    <p class="text-sm">No projects yet</p>
    <p class="text-xs mt-1">Create your first project to get started</p>
  </div>
  {{/each}}
</div>