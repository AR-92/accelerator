<div id="{{id}}"
  class="bg-gradient-to-r {{bgGradient}} rounded-md border {{border}} p-4 mb-6">
  <div class="flex items-center gap-3 mb-3">
    <div class="w-8 h-8 rounded-md {{circleBg}} flex items-center justify-center">
      <span class="text-sm font-bold {{circleText}}">{{number}}</span>
    </div>
    <h3 class="text-lg font-semibold {{titleText}}">{{title}}</h3>
  </div>
  <p class="text-sm {{descText}} mb-3">{{description}}</p>
  <div class="text-xs {{topicsText}}">
    <strong>Topics covered:</strong> {{topics}}
  </div>
</div>