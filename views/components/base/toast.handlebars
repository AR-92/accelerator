<script>
let toastConfirmCallback = null;
let toastCancelCallback = null;

function showToast(message, type = 'info', options = {}) {
  const { confirmText, cancelText, onConfirm, onCancel, persistent = false } = options;

  const toast = document.createElement('div');
  toast.className = `fixed top-4 right-4 z-50 max-w-sm w-full rounded-md border px-4 py-3 text-sm ${
    type === 'success'
      ? 'bg-green-50 text-green-800 border-green-200'
      : type === 'error'
        ? 'bg-red-50 text-red-800 border-red-200'
        : type === 'warning'
          ? 'bg-yellow-50 text-yellow-800 border-yellow-200'
          : 'bg-blue-50 text-blue-800 border-blue-200'
  }`;

  const hasConfirmation = confirmText && onConfirm;

  if (hasConfirmation) {
    toastConfirmCallback = onConfirm;
    toastCancelCallback = onCancel;
  }

  toast.innerHTML = `
    <div class="flex items-start gap-3">
      <svg class="w-4 h-4 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${
          type === 'success'
            ? 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
            : type === 'error'
              ? 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
              : type === 'warning'
                ? 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z'
                : 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
        }"></path>
      </svg>
      <div class="flex-1">${message}</div>
      ${hasConfirmation ? `
        <div class="flex gap-2 ml-4">
          <button class="px-2 py-1 text-xs bg-red-600 text-white rounded hover:bg-red-700" onclick="handleToastConfirm()">${confirmText}</button>
          <button class="px-2 py-1 text-xs bg-gray-600 text-white rounded hover:bg-gray-700" onclick="handleToastCancel()">${cancelText || 'Cancel'}</button>
        </div>
      ` : ''}
    </div>
  `;

  document.body.appendChild(toast);

  // Auto-remove after 2 seconds if not persistent and not confirmation
  if (!persistent && !hasConfirmation) {
    setTimeout(() => {
      if (toast.parentNode) {
        toast.parentNode.removeChild(toast);
      }
    }, 2000);
  }
}

function handleToastConfirm() {
  if (toastConfirmCallback) {
    toastConfirmCallback();
    toastConfirmCallback = null;
    toastCancelCallback = null;
  }
  // Remove the toast
  const toast = document.querySelector('.fixed.top-4.right-4');
  if (toast) toast.remove();
}

function handleToastCancel() {
  if (toastCancelCallback) {
    toastCancelCallback();
    toastConfirmCallback = null;
    toastCancelCallback = null;
  }
  // Remove the toast
  const toast = document.querySelector('.fixed.top-4.right-4');
  if (toast) toast.remove();
}

// Auto-remove toasts observer
const toastObserver = new MutationObserver((mutations) => {
  mutations.forEach((mutation) => {
    mutation.addedNodes.forEach((node) => {
      if (node.nodeType === 1 && node.classList.contains('fixed')) {
        setTimeout(() => {
          if (node.parentNode) node.parentNode.removeChild(node);
        }, 2000);
      }
    });
  });
});
toastObserver.observe(document.body, { childList: true });
</script>