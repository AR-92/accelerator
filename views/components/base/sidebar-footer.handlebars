<div class="p-2 border-t border-input/80 relative">
  <a href="/settings"
    class="w-full relative flex cursor-default select-none items-center gap-2 rounded-sm px-2 py-2 text-sm text-left outline-none transition-colors hover:bg-accent hover:text-accent-foreground">
    <div class="grid flex-1 text-left text-sm leading-tight">
       <div class="flex justify-between">
         <span class="truncate text-xs text-muted-foreground user-email">{{#if user}}{{user.email}}{{/if}}</span>
          {{{icon 'coins' size="16" class="h-4 w-4 shrink-0"}}}
       </div>
      <!-- Separator -->
      <div class="bg-border -mx-1 my-1 h-px"></div>
       <div class="flex items-center justify-between text-sm flex-1">
         <span class="truncate text-xs text-muted-foreground self-center flex-1">{{credits}} Credits</span>
         <span class="truncate text-xs text-muted-foreground self-center">{{#if user}}{{user.firstName}} {{user.lastName}}{{/if}}</span>
       </div>
    </div>
  </a>
  <!-- Sidebar toggle button -->
  {{!-- <button onclick="toggleSidebar()"
    class="hidden md:flex w-full items-center justify-center py-2 text-muted-foreground hover:text-primary transition-colors"
    title="Toggle Sidebar">
    {{{icon 'chevron-left' size="16" class="h-4 w-4"}}}
  </button> --}}
</div>