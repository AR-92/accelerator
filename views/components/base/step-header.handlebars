<div class="bg-background rounded-md p-4 border border-input/80">
  <div class="flex items-center gap-2 mb-2">
    {{{icon iconName class="w-4 h-4 text-primary"}}}
    <h5 class="text-sm font-semibold text-foreground">{{title}}</h5>
  </div>
  <p class="text-sm text-muted-foreground mb-3">{{description}}</p>
  <div class="flex items-center gap-4 text-xs text-muted-foreground">
    <span class="flex items-center gap-1">
      {{{icon "clock" class="w-3 h-3"}}}
      {{time}}
    </span>
    <span class="flex items-center gap-1">
      {{{icon "circle-check-big" class="w-3 h-3"}}}
      {{confidence}} confidence
    </span>
  </div>
</div>