<div class="flex justify-end mb-4">
  <div class="bg-background rounded-2xl p-4 max-w-2xl border border-input/80 shadow-sm">
  <!-- FORM-CARD: {{title}} -->
    <div class="flex items-start gap-3 mb-3{{#if alignRight}} justify-end{{/if}}">
      <div class="flex-1{{#if alignRight}} text-right{{/if}}">
        <div class="text-sm font-semibold text-foreground">You</div>
        <div class="text-xs text-muted-foreground">Responding</div>
        <div class="mt-2">
          <h3 class="text-sm font-semibold text-primary bg-primary/10 rounded-md px-2 py-1 inline-block">{{title}}</h3>
        </div>
      </div>
      <div class="flex-shrink-0">
        <div class="w-8 h-8 rounded-md bg-primary flex items-center justify-center text-primary-foreground text-sm font-bold">{{#if avatar}}{{avatar}}{{else}}U{{/if}}</div>
      </div>
    </div>
     {{> @partial-block}}
  </div>
</div>