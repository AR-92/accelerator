 <div class="min-h-screen bg-background">
   <div class="container mx-auto px-4 py-8 max-w-4xl">
     <div class="space-y-8">
       <!-- Header -->
       <div class="text-center space-y-4">
         <h1 class="text-3xl font-bold text-foreground">Settings</h1>
         <p class="text-muted-foreground">Manage your account preferences and configuration.</p>
       </div>

       <!-- Profile Section -->
       <div class="bg-card border border-border rounded-lg p-6">
         <div class="flex items-center gap-3 mb-6">
           <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center">
{{{icon 'user' size="16" class='w-4 h-4 text-primary'}}}
           </div>
           <h2 class="text-xl font-semibold text-foreground">Profile Settings</h2>
         </div>

         <form class="space-y-6">
           <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
             <div>
               <label for="firstName" class="block text-sm font-medium text-foreground mb-2">First Name</label>
               <input type="text" id="firstName" name="firstName" class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary" value="John">
             </div>
             <div>
               <label for="lastName" class="block text-sm font-medium text-foreground mb-2">Last Name</label>
               <input type="text" id="lastName" name="lastName" class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary" value="Doe">
             </div>
           </div>

           <div>
             <label for="email" class="block text-sm font-medium text-foreground mb-2">Email Address</label>
             <input type="email" id="email" name="email" class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary" value="john.doe@example.com">
           </div>

           <div>
             <label for="bio" class="block text-sm font-medium text-foreground mb-2">Bio</label>
             <textarea id="bio" name="bio" rows="3" class="w-full px-3 py-2 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary resize-none" placeholder="Tell us about yourself...">Experienced project manager with a passion for innovation.</textarea>
           </div>

           <div class="flex gap-3">
             <button type="submit" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">Save Changes</button>
             <button type="button" class="px-4 py-2 border border-border text-foreground rounded-md hover:bg-muted">Cancel</button>
           </div>
         </form>
       </div>

       <!-- Billing Section -->
       <div class="bg-card border border-border rounded-lg p-6">
         <div class="flex items-center gap-3 mb-6">
           <div class="w-8 h-8 bg-secondary/10 rounded-lg flex items-center justify-center">
{{{icon 'credit-card' size="16" class='w-4 h-4 text-secondary'}}}
           </div>
           <h2 class="text-xl font-semibold text-foreground">Billing Settings</h2>
         </div>

         <!-- Current Plan -->
         <div class="mb-6 p-4 bg-muted/50 rounded-lg">
           <div class="flex items-center justify-between mb-3">
             <h3 class="font-semibold text-foreground">Current Plan</h3>
             <span class="px-3 py-1 bg-primary text-primary-foreground text-sm rounded-md">Pro Plan - $29.99/month</span>
           </div>
           <p class="text-sm text-muted-foreground mb-4">Your next billing date is December 15, 2024.</p>
           <div class="flex gap-3">
             <button class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">Change Plan</button>
             <button class="px-4 py-2 border border-destructive text-destructive rounded-md hover:bg-destructive/10">Cancel Subscription</button>
           </div>
         </div>

         <!-- Payment Methods -->
         <div class="mb-6">
           <h3 class="font-semibold text-foreground mb-4">Payment Methods</h3>
           <div class="space-y-3">
             <div class="flex items-center justify-between p-4 border border-border rounded-lg">
               <div class="flex items-center gap-3">
                 <div class="w-8 h-8 bg-primary/10 rounded-lg flex items-center justify-center">
{{{icon 'credit-card' size="14" class='w-3.5 h-3.5 text-primary'}}}
                 </div>
                 <div>
                   <p class="font-medium text-foreground">•••• •••• •••• 4242</p>
                   <p class="text-sm text-muted-foreground">Expires 12/26</p>
                 </div>
               </div>
               <div class="flex gap-2">
                 <button class="px-3 py-1 text-sm border border-border rounded hover:bg-muted">Edit</button>
                 <button class="px-3 py-1 text-sm text-destructive border border-destructive rounded hover:bg-destructive/10">Remove</button>
               </div>
             </div>
             <button class="w-full px-4 py-3 border-2 border-dashed border-border text-muted-foreground rounded-lg hover:bg-muted">
{{{icon 'plus' size="16" class='w-4 h-4 mr-2'}}}
               Add Payment Method
             </button>
           </div>
         </div>

         <!-- Billing History -->
         <div>
           <h3 class="font-semibold text-foreground mb-4">Billing History</h3>
           <div class="space-y-3">
             <div class="flex items-center justify-between py-3 border-b border-border">
               <div>
                 <p class="font-medium text-foreground">November 2024</p>
                 <p class="text-sm text-muted-foreground">Pro Plan</p>
               </div>
               <div class="text-right">
                 <p class="font-medium text-foreground">$29.99</p>
                 <a href="#" class="text-primary hover:underline text-sm">Download</a>
               </div>
             </div>
             <div class="flex items-center justify-between py-3">
               <div>
                 <p class="font-medium text-foreground">October 2024</p>
                 <p class="text-sm text-muted-foreground">Pro Plan</p>
               </div>
               <div class="text-right">
                 <p class="font-medium text-foreground">$29.99</p>
                 <a href="#" class="text-primary hover:underline text-sm">Download</a>
               </div>
             </div>
           </div>
         </div>
       </div>

       <!-- Security & Privacy Section -->
       <div class="bg-card border border-border rounded-lg p-6">
         <div class="flex items-center gap-3 mb-6">
           <div class="w-8 h-8 bg-success/10 rounded-lg flex items-center justify-center">
{{{icon 'shield' size="16" class='w-4 h-4 text-success'}}}
           </div>
           <h2 class="text-xl font-semibold text-foreground">Security & Privacy</h2>
         </div>

         <!-- Security Settings -->
         <div class="mb-6">
           <h3 class="font-semibold text-foreground mb-4">Security</h3>
           <div class="space-y-4">
             <div class="flex items-center justify-between">
               <div>
                 <p class="font-medium text-foreground">Two-Factor Authentication</p>
                 <p class="text-sm text-muted-foreground">Add an extra layer of security to your account</p>
               </div>
               <label class="relative inline-flex items-center cursor-pointer">
                 <input type="checkbox" class="sr-only peer">
                 <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
               </label>
             </div>
             <div class="flex items-center justify-between">
               <div>
                 <p class="font-medium text-foreground">Login Notifications</p>
                 <p class="text-sm text-muted-foreground">Get notified of new sign-ins to your account</p>
               </div>
               <label class="relative inline-flex items-center cursor-pointer">
                 <input type="checkbox" class="sr-only peer" checked>
                 <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
               </label>
             </div>
             <div>
               <p class="font-medium text-foreground mb-2">Change Password</p>
               <button class="px-4 py-2 border border-border text-foreground rounded-md hover:bg-muted">Change Password</button>
             </div>
           </div>
         </div>

         <!-- Privacy Settings -->
         <div class="mb-6">
           <h3 class="font-semibold text-foreground mb-4">Privacy</h3>
           <div class="space-y-4">
             <div class="flex items-center justify-between">
               <div>
                 <p class="font-medium text-foreground">Profile Visibility</p>
                 <p class="text-sm text-muted-foreground">Control who can see your profile information</p>
               </div>
               <select class="px-3 py-1 border border-border rounded text-sm">
                 <option>Public</option>
                 <option>Team Only</option>
                 <option>Private</option>
               </select>
             </div>
             <div class="flex items-center justify-between">
               <div>
                 <p class="font-medium text-foreground">Activity Status</p>
                 <p class="text-sm text-muted-foreground">Show when you're active on the platform</p>
               </div>
               <label class="relative inline-flex items-center cursor-pointer">
                 <input type="checkbox" class="sr-only peer" checked>
                 <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
               </label>
             </div>
             <div class="flex items-center justify-between">
               <div>
                 <p class="font-medium text-foreground">Data Collection</p>
                 <p class="text-sm text-muted-foreground">Allow analytics and usage data collection</p>
               </div>
               <label class="relative inline-flex items-center cursor-pointer">
                 <input type="checkbox" class="sr-only peer" checked>
                 <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
               </label>
             </div>
           </div>
         </div>

         <!-- Data Management -->
         <div>
           <h3 class="font-semibold text-foreground mb-4">Data Management</h3>
           <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
             <div class="p-4 border border-border rounded-lg">
               <p class="font-medium text-foreground mb-2">Export Your Data</p>
               <p class="text-sm text-muted-foreground mb-3">Download a copy of all your data</p>
               <button class="w-full px-4 py-2 border border-border text-foreground rounded-md hover:bg-muted">Export Data</button>
             </div>
             <div class="p-4 border border-destructive/20 rounded-lg">
               <p class="font-medium text-destructive mb-2">Delete Account</p>
               <p class="text-sm text-muted-foreground mb-3">Permanently delete your account and all associated data</p>
               <button class="w-full px-4 py-2 border border-destructive text-destructive rounded-md hover:bg-destructive/10">Delete Account</button>
             </div>
           </div>
         </div>
        </div>

        <!-- Credits Section -->
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 bg-amber-500/10 rounded-lg flex items-center justify-center">
{{{icon 'coins' size="16" class='w-4 h-4 text-amber-600'}}}
            </div>
            <h2 class="text-xl font-semibold text-foreground">Credits</h2>
          </div>

          <div class="space-y-4">
            <div class="flex items-center justify-between p-4 border border-border rounded-lg">
              <div class="flex items-center gap-3">
                {{{icon 'coins' size="20" class="w-5 h-5 text-amber-600"}}}
                <div>
                  <p class="font-medium">Current Balance</p>
                  <p id="settings-credit-balance" class="text-sm text-muted-foreground">Loading...</p>
                </div>
              </div>
              <a href="/pages/buy-credits" class="px-4 py-2 bg-amber-600 text-white rounded-md hover:bg-amber-700">Buy Credits</a>
            </div>

            <div class="flex items-center justify-between p-4 border border-border rounded-lg">
              <div class="flex items-center gap-3">
                {{{icon 'history' size="20" class="w-5 h-5 text-primary"}}}
                <div>
                  <p class="font-medium">Transaction History</p>
                  <p class="text-sm text-muted-foreground">View your credit transactions</p>
                </div>
              </div>
              <button onclick="showTransactionHistory()" class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">View History</button>
            </div>
          </div>
        </div>

        <!-- Quick Settings -->
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 bg-purple-500/10 rounded-lg flex items-center justify-center">
{{{icon 'zap' size="16" class='w-4 h-4 text-purple-600'}}}
            </div>
            <h2 class="text-xl font-semibold text-foreground">Quick Settings</h2>
          </div>

          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-medium text-foreground">Email Notifications</p>
                <p class="text-sm text-muted-foreground">Receive email updates about your projects</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" class="sr-only peer">
                <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>
            <div class="flex items-center justify-between">
              <div>
                <p class="font-medium text-foreground">Dark Mode</p>
                <p class="text-sm text-muted-foreground">Toggle between light and dark themes</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="theme-toggle" class="sr-only peer">
                <div class="w-11 h-6 bg-muted peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/25 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-background after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>