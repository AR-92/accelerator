
<div class="min-h-screen bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header -->
    <div class="flex flex-col gap-4 lg:gap-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Activity Log
          </h1>
          <p class="text-lg text-muted-foreground">
            Track activities and logs
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-primary">
            {{{icon 'download' size='16'}}}
            Export Logs
          </button>
        </div>
      </div>

      <!-- Activity Overview Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">User Activities</h3>
              <p class="text-2xl font-semibold text-step-revenue">{{userActivities.stats.total}}</p>
            </div>
            <div class="bg-step-revenue/20 rounded-lg">
              <div class="w-10 h-10 bg-step-revenue/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-revenue rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'user' size="16" class='w-4 h-4 text-step-revenue-foreground'}}}
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-step-revenue">{{userActivities.stats.today}}</span> today
          </p>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">System Activities</h3>
              <p class="text-2xl font-semibold text-step-kpi">{{systemActivities.stats.total}}</p>
            </div>
            <div class="bg-step-kpi/20 rounded-lg">
              <div class="w-10 h-10 bg-step-kpi/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-kpi rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'activity' size="16" class='w-4 h-4 text-step-kpi-foreground'}}}
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-destructive">{{systemActivities.stats.critical}}</span> critical
          </p>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Compliance Logs</h3>
              <p class="text-2xl font-semibold text-step-streams">{{complianceLogs.stats.total}}</p>
            </div>
            <div class="bg-step-streams/20 rounded-lg">
              <div class="w-10 h-10 bg-step-streams/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-streams rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'shield-check' size="16" class='w-4 h-4 text-step-streams-foreground'}}}
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-success">{{complianceLogs.stats.passed}}</span> passed
          </p>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Audit Trails</h3>
              <p class="text-2xl font-semibold text-step-cogs">{{auditTrails.stats.total}}</p>
            </div>
            <div class="bg-step-cogs/20 rounded-lg">
              <div class="w-10 h-10 bg-step-cogs/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-cogs rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'file-search' size="16" class='w-4 h-4 text-step-cogs-foreground'}}}
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-step-cogs">{{auditTrails.stats.security}}</span> security
          </p>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- User Activities & System Activities -->
        <div class="space-y-6">
          <!-- User Activities -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">User Activities</h2>
              <div class="flex items-center gap-2">
                <button class="btn btn-ghost text-sm">
                  Filter
                  {{{icon 'filter' size='14'}}}
                </button>
                <button class="btn btn-ghost text-sm">
                  Export
                  {{{icon 'download' size='14'}}}
                </button>
              </div>
            </div>
            <div class="space-y-3">
              {{#if userActivities.activities.length}}
                {{#each userActivities.activities}}
                <div class="flex items-start gap-3 p-3 bg-muted/50 rounded-lg border border-border/50">
                  <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                    {{{icon 'user' size='14' class='text-primary'}}}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-foreground">{{action}}</p>
                    <p class="text-xs text-muted-foreground">{{description}}</p>
                    <p class="text-xs text-muted-foreground mt-1">{{created_at}}</p>
                  </div>
                  <div class="flex-shrink-0">
                    <span class="tag tag-primary">{{category}}</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-8">
                  <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                    {{{icon 'user' size='24' class='text-muted-foreground'}}}
                  </div>
                  <h3 class="text-lg font-medium text-foreground mb-2">No user activities</h3>
                  <p class="text-muted-foreground">User activities will appear here</p>
                </div>
              {{/if}}
            </div>
          </div>

          <!-- System Activities -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">System Activities</h2>
              <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">Last updated: {{lastUpdated}}</span>
              </div>
            </div>
            <div class="space-y-3">
              {{#if systemActivities.activities.length}}
                {{#each systemActivities.activities}}
                <div class="flex items-start gap-3 p-3 {{#if (eq severity 'critical')}}bg-destructive/10{{else if (eq severity 'warning')}}bg-warning/10{{else}}bg-muted/50{{/if}} rounded-lg border border-border/50">
                  <div class="w-8 h-8 {{#if (eq severity 'critical')}}bg-destructive/20{{else if (eq severity 'warning')}}bg-warning/20{{else}}bg-step-kpi/20{{/if}} rounded-full flex items-center justify-center flex-shrink-0">
                    {{{icon 'activity' size='14' class='{{#if (eq severity 'critical')}}text-destructive{{else if (eq severity 'warning')}}text-warning{{else}}text-step-kpi{{/if}}'}}}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-foreground">{{message}}</p>
                    <p class="text-xs text-muted-foreground">{{details}}</p>
                    <p class="text-xs text-muted-foreground mt-1">{{created_at}}</p>
                  </div>
                  <div class="flex-shrink-0">
                    <span class="tag {{#if (eq severity 'critical')}}tag-destructive{{else if (eq severity 'warning')}}tag-warning{{else}}tag-info{{/if}}">{{severity}}</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-8">
                  <p class="text-sm text-muted-foreground">No system activities</p>
                </div>
              {{/if}}
            </div>
          </div>
        </div>

        <!-- Compliance Logs & Audit Trails -->
        <div class="space-y-6">
          <!-- Compliance Logs -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">Compliance Monitoring</h2>
              <button class="btn btn-ghost text-sm">
                View Report
                {{{icon 'file-text' size='14'}}}
              </button>
            </div>
            <div class="grid grid-cols-3 gap-4 mb-4">
              <div class="text-center p-3 bg-success/10 rounded-lg">
                <div class="text-lg font-bold text-success">{{complianceLogs.stats.passed}}</div>
                <p class="text-xs text-muted-foreground">Passed</p>
              </div>
              <div class="text-center p-3 bg-destructive/10 rounded-lg">
                <div class="text-lg font-bold text-destructive">{{complianceLogs.stats.failed}}</div>
                <p class="text-xs text-muted-foreground">Failed</p>
              </div>
              <div class="text-center p-3 bg-warning/10 rounded-lg">
                <div class="text-lg font-bold text-warning">{{complianceLogs.stats.pending}}</div>
                <p class="text-xs text-muted-foreground">Pending</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if complianceLogs.logs.length}}
                {{#each complianceLogs.logs}}
                <div class="flex items-center justify-between p-3 {{#if (eq status 'passed')}}bg-success/10{{else if (eq status 'failed')}}bg-destructive/10{{else}}bg-warning/10{{/if}} rounded-lg border border-border/50">
                  <div>
                    <h4 class="font-medium text-foreground text-sm">{{check_name}}</h4>
                    <p class="text-xs text-muted-foreground">{{category}} • {{created_at}}</p>
                  </div>
                  <div class="text-right">
                    <span class="tag {{#if (eq status 'passed')}}tag-success{{else if (eq status 'failed')}}tag-destructive{{else}}tag-warning{{/if}}">{{status}}</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No compliance logs</p>
                </div>
              {{/if}}
            </div>
          </div>

          <!-- Audit Trails -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">Audit Trails</h2>
              <button class="btn btn-ghost text-sm">
                Full Audit
                {{{icon 'search' size='14'}}}
              </button>
            </div>
            <div class="grid grid-cols-3 gap-4 mb-4">
              <div class="text-center p-3 bg-step-cogs/10 rounded-lg">
                <div class="text-lg font-bold text-step-cogs">{{auditTrails.stats.security}}</div>
                <p class="text-xs text-muted-foreground">Security</p>
              </div>
              <div class="text-center p-3 bg-step-cogs/10 rounded-lg">
                <div class="text-lg font-bold text-step-cogs">{{auditTrails.stats.data}}</div>
                <p class="text-xs text-muted-foreground">Data</p>
              </div>
              <div class="text-center p-3 bg-step-cogs/10 rounded-lg">
                <div class="text-lg font-bold text-step-cogs">{{auditTrails.stats.access}}</div>
                <p class="text-xs text-muted-foreground">Access</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if auditTrails.trails.length}}
                {{#each auditTrails.trails}}
                <div class="flex items-start gap-3 p-3 bg-muted/50 rounded-lg border border-border/50">
                  <div class="w-8 h-8 bg-step-cogs/20 rounded-full flex items-center justify-center flex-shrink-0">
                    {{{icon 'file-search' size='14' class='text-step-cogs'}}}
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-foreground">{{action}}</p>
                    <p class="text-xs text-muted-foreground">{{details}}</p>
                    <p class="text-xs text-muted-foreground mt-1">{{timestamp}}</p>
                  </div>
                  <div class="flex-shrink-0">
                    <span class="tag {{#if (eq category 'security')}}tag-destructive{{else if (eq category 'data')}}tag-warning{{else}}tag-info{{/if}}">{{category}}</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No audit trails</p>
                </div>
              {{/if}}
            </div>
          </div>
        </div>
      </div>

      <!-- Enterprise/Corporate Specific Sections -->
      {{#if features.enterprise}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Enterprise-Wide Tracking</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">1,247</div>
            <p class="text-sm text-muted-foreground">Total Activities</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">89%</div>
            <p class="text-sm text-muted-foreground">System Uptime</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">156</div>
            <p class="text-sm text-muted-foreground">Active Integrations</p>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if features.corporate}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Regulatory Compliance Logs</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">98.7%</div>
            <p class="text-sm text-muted-foreground">Compliance Rate</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">247</div>
            <p class="text-sm text-muted-foreground">Regulatory Filings</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-cogs mb-2">0</div>
            <p class="text-sm text-muted-foreground">Violations</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">12</div>
            <p class="text-sm text-muted-foreground">Active Audits</p>
          </div>
        </div>
      </div>
      {{/if}}
    </div>
  </div>
</div>
