    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Promotion Management
          </h1>
          <p class="text-lg text-muted-foreground">
            Create promotional materials
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-primary">
            {{{icon 'plus' size='16'}}}
            New Pitch Deck
          </button>
        </div>
      </div>

      <!-- Promotion Overview Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Pitch Decks</h3>
              <p class="text-2xl font-semibold text-step-revenue">{{pitchDecks.stats.total}}</p>
            </div>
            <div class="bg-step-revenue/20 rounded-lg">
              <div class="w-10 h-10 bg-step-revenue/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-revenue rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'presentation' size="16" class='w-4 h-4 text-step-revenue-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Presentations</h3>
              <p class="text-2xl font-semibold text-step-kpi">{{investorPresentations.stats.total}}</p>
            </div>
            <div class="bg-step-kpi/20 rounded-lg">
              <div class="w-10 h-10 bg-step-kpi/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-kpi rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'megaphone' size="16" class='w-4 h-4 text-step-kpi-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Communications</h3>
              <p class="text-2xl font-semibold text-step-streams">{{corporateCommunications.stats.total}}</p>
            </div>
            <div class="bg-step-streams/20 rounded-lg">
              <div class="w-10 h-10 bg-step-streams/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-streams rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'file-text' size="16" class='w-4 h-4 text-step-streams-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Investor Relations</h3>
              <p class="text-2xl font-semibold text-step-cogs">{{investorRelations.stats.totalInvestors}}</p>
            </div>
            <div class="bg-step-cogs/20 rounded-lg">
              <div class="w-10 h-10 bg-step-cogs/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-cogs rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'users' size="16" class='w-4 h-4 text-step-cogs-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Pitch Decks & Presentations -->
        <div class="space-y-6">
          <!-- Pitch Decks -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">Pitch Decks</h2>
              <button class="btn btn-ghost text-sm">
                Create New
                {{{icon 'plus' size='14'}}}
              </button>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="text-center p-3 bg-step-revenue/10 rounded-lg">
                <div class="text-lg font-bold text-step-revenue">{{pitchDecks.stats.published}}</div>
                <p class="text-xs text-muted-foreground">Published</p>
              </div>
              <div class="text-center p-3 bg-step-revenue/10 rounded-lg">
                <div class="text-lg font-bold text-step-revenue">{{pitchDecks.stats.views}}</div>
                <p class="text-xs text-muted-foreground">Total Views</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if pitchDecks.decks.length}}
                {{#each pitchDecks.decks}}
                <div class="flex items-center justify-between p-4 bg-muted/50 rounded-lg border border-border/50">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center">
                      {{{icon 'presentation' size='20' class='text-primary'}}}
                    </div>
                    <div>
                      <h3 class="font-medium text-foreground">{{title}}</h3>
                      <p class="text-sm text-muted-foreground">{{version}} • {{view_count}} views</p>
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="tag {{#if (eq status 'published')}}tag-success{{else}}tag-secondary{{/if}}">{{status}}</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-8">
                  <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                    {{{icon 'presentation' size='24' class='text-muted-foreground'}}}
                  </div>
                  <h3 class="text-lg font-medium text-foreground mb-2">No pitch decks yet</h3>
                  <p class="text-muted-foreground mb-4">Create your first pitch deck</p>
                  <button class="btn btn-primary">Create Pitch Deck</button>
                </div>
              {{/if}}
            </div>
          </div>

          <!-- Investor Presentations -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">Investor Presentations</h2>
              <button class="btn btn-ghost text-sm">
                Schedule New
                {{{icon 'calendar' size='14'}}}
              </button>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="text-center p-3 bg-step-kpi/10 rounded-lg">
                <div class="text-lg font-bold text-step-kpi">{{investorPresentations.stats.completed}}</div>
                <p class="text-xs text-muted-foreground">Completed</p>
              </div>
              <div class="text-center p-3 bg-step-kpi/10 rounded-lg">
                <div class="text-lg font-bold text-step-kpi">{{investorPresentations.stats.avgRating}}</div>
                <p class="text-xs text-muted-foreground">Avg Rating</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if investorPresentations.presentations.length}}
                {{#each investorPresentations.presentations}}
                <div class="p-4 bg-muted/50 rounded-lg border border-border/50">
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="font-medium text-foreground">{{title}}</h3>
                    <span class="tag {{#if (eq status 'completed')}}tag-success{{else if (eq status 'scheduled')}}tag-warning{{else}}tag-secondary{{/if}}">{{status}}</span>
                  </div>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">{{investor_name}}</span>
                    <span class="text-muted-foreground">{{presentation_date}}</span>
                  </div>
                  {{#if investor_rating}}
                  <div class="mt-2">
                    <span class="text-xs text-muted-foreground">Rating: {{investor_rating}}/10</span>
                  </div>
                  {{/if}}
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No presentations scheduled</p>
                </div>
              {{/if}}
            </div>
          </div>
        </div>

        <!-- Corporate Communications & Investor Relations -->
        <div class="space-y-6">
          <!-- Corporate Communications -->
          <div class="bg-card rounded-lg border border-border p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Corporate Communications</h2>
            <div class="grid grid-cols-3 gap-4 mb-4">
              <div class="text-center p-3 bg-step-streams/10 rounded-lg">
                <div class="text-lg font-bold text-step-streams">{{corporateCommunications.stats.pressReleases}}</div>
                <p class="text-xs text-muted-foreground">Press Releases</p>
              </div>
              <div class="text-center p-3 bg-step-streams/10 rounded-lg">
                <div class="text-lg font-bold text-step-streams">{{corporateCommunications.stats.newsletters}}</div>
                <p class="text-xs text-muted-foreground">Newsletters</p>
              </div>
              <div class="text-center p-3 bg-step-streams/10 rounded-lg">
                <div class="text-lg font-bold text-step-streams">{{corporateCommunications.stats.reports}}</div>
                <p class="text-xs text-muted-foreground">Reports</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if corporateCommunications.communications.length}}
                {{#each corporateCommunications.communications}}
                <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg border border-border/50">
                  <div>
                    <h4 class="font-medium text-foreground text-sm">{{title}}</h4>
                    <p class="text-xs text-muted-foreground">{{type}} • {{publish_date}}</p>
                  </div>
                  <div class="text-right">
                    <span class="tag tag-primary">{{status}}</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No communications published</p>
                  <button class="btn btn-outline btn-sm mt-2">Create Communication</button>
                </div>
              {{/if}}
            </div>
          </div>

          <!-- Investor Relations -->
          <div class="bg-card rounded-lg border border-border p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Investor Relations</h2>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="text-center p-3 bg-step-cogs/10 rounded-lg">
                <div class="text-lg font-bold text-step-cogs">{{investorRelations.stats.active}}</div>
                <p class="text-xs text-muted-foreground">Active Investors</p>
              </div>
              <div class="text-center p-3 bg-step-cogs/10 rounded-lg">
                <div class="text-lg font-bold text-step-cogs">{{investorRelations.stats.meetings}}</div>
                <p class="text-xs text-muted-foreground">Meetings Held</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if investorRelations.relations.length}}
                {{#each investorRelations.relations}}
                <div class="p-3 bg-muted/50 rounded-lg border border-border/50">
                  <div class="flex items-center justify-between mb-2">
                    <h4 class="font-medium text-foreground text-sm">{{investor_name}}</h4>
                    <span class="tag {{#if (eq status 'active')}}tag-success{{else}}tag-secondary{{/if}}">{{status}}</span>
                  </div>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">{{investment_type}}</span>
                    <span class="text-muted-foreground">{{last_contact}}</span>
                  </div>
                  <div class="mt-2 flex items-center gap-4 text-xs text-muted-foreground">
                    <span>{{meeting_count}} meetings</span>
                    <span>{{update_count}} updates</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No investor relations</p>
                  <button class="btn btn-outline btn-sm mt-2">Add Investor</button>
                </div>
              {{/if}}
            </div>
          </div>
        </div>
      </div>

      <!-- Enterprise/Corporate Specific Sections -->
      {{#if features.enterprise}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Enterprise-Grade Decks</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">24</div>
            <p class="text-sm text-muted-foreground">Enterprise Decks</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">156</div>
            <p class="text-sm text-muted-foreground">Professional Reviews</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">94%</div>
            <p class="text-sm text-muted-foreground">Approval Rate</p>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if features.corporate}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Corporate Communications & IR</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">89</div>
            <p class="text-sm text-muted-foreground">Annual Reports</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">450</div>
            <p class="text-sm text-muted-foreground">Shareholder Meetings</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-cogs mb-2">12</div>
            <p class="text-sm text-muted-foreground">Regulatory Filings</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">98%</div>
            <p class="text-sm text-muted-foreground">Compliance Rate</p>
          </div>
        </div>
      </div>
      {{/if}}
