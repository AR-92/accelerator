    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Marketing Management
          </h1>
          <p class="text-lg text-muted-foreground">
            Develop marketing strategies
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="btn btn-primary">
            {{{icon 'plus' size='16'}}}
            New Campaign
          </button>
        </div>
      </div>

      <!-- Marketing Overview Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Target Audiences</h3>
              <p class="text-2xl font-semibold text-step-revenue">{{targetAudiences.stats.total}}</p>
            </div>
            <div class="bg-step-revenue/20 rounded-lg">
              <div class="w-10 h-10 bg-step-revenue/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-revenue rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'users' size="16" class='w-4 h-4 text-step-revenue-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Marketing Channels</h3>
              <p class="text-2xl font-semibold text-step-streams">{{marketingChannels.channels.length}}</p>
            </div>
            <div class="bg-step-streams/20 rounded-lg">
              <div class="w-10 h-10 bg-step-streams/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-streams rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'globe' size="16" class='w-4 h-4 text-step-streams-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Active Campaigns</h3>
              <p class="text-2xl font-semibold text-step-kpi">{{campaignPerformance.stats.active}}</p>
            </div>
            <div class="bg-step-kpi/20 rounded-lg">
              <div class="w-10 h-10 bg-step-kpi/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-kpi rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'megaphone' size="16" class='w-4 h-4 text-step-kpi-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Total Reach</h3>
              <p class="text-2xl font-semibold text-step-cogs">{{marketingChannels.performance.totalReach}}</p>
            </div>
            <div class="bg-step-cogs/20 rounded-lg">
              <div class="w-10 h-10 bg-step-cogs/20 rounded-lg relative">
                <div class="flex items-center justify-center w-9 h-9 bg-step-cogs rounded-lg absolute top-0.5 left-0.5">
                  {{{icon 'eye' size="16" class='w-4 h-4 text-step-cogs-foreground'}}}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Target Audiences & Channels -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Target Audiences -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">Target Audiences</h2>
              <button class="btn btn-ghost text-sm">
                Add Audience
                {{{icon 'plus' size='14'}}}
              </button>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="text-center p-3 bg-step-revenue/10 rounded-lg">
                <div class="text-lg font-bold text-step-revenue">{{targetAudiences.stats.total}}</div>
                <p class="text-xs text-muted-foreground">Total Audiences</p>
              </div>
              <div class="text-center p-3 bg-step-revenue/10 rounded-lg">
                <div class="text-lg font-bold text-step-revenue">{{targetAudiences.stats.active}}</div>
                <p class="text-xs text-muted-foreground">Active Segments</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if targetAudiences.audiences.length}}
                {{#each targetAudiences.audiences}}
                <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg border border-border/50">
                  <div>
                    <h4 class="font-medium text-foreground text-sm">{{name}}</h4>
                    <p class="text-xs text-muted-foreground">{{segment}}</p>
                  </div>
                  <div class="text-right">
                    <span class="tag {{#if (eq status 'active')}}tag-success{{else}}tag-secondary{{/if}}">{{status}}</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No target audiences defined</p>
                </div>
              {{/if}}
            </div>
          </div>

          <!-- Marketing Channels -->
          <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-foreground">Marketing Channels</h2>
              <button class="btn btn-ghost text-sm">
                Add Channel
                {{{icon 'plus' size='14'}}}
              </button>
            </div>
            <div class="grid grid-cols-3 gap-4 mb-4">
              <div class="text-center p-3 bg-step-streams/10 rounded-lg">
                <div class="text-lg font-bold text-step-streams">{{marketingChannels.performance.totalReach}}</div>
                <p class="text-xs text-muted-foreground">Total Reach</p>
              </div>
              <div class="text-center p-3 bg-step-streams/10 rounded-lg">
                <div class="text-lg font-bold text-step-streams">{{marketingChannels.performance.totalEngagement}}</div>
                <p class="text-xs text-muted-foreground">Engagement</p>
              </div>
              <div class="text-center p-3 bg-step-streams/10 rounded-lg">
                <div class="text-lg font-bold text-step-streams">{{marketingChannels.performance.totalConversions}}</div>
                <p class="text-xs text-muted-foreground">Conversions</p>
              </div>
            </div>
            <div class="space-y-3">
              {{#if marketingChannels.channels.length}}
                {{#each marketingChannels.channels}}
                <div class="flex items-center justify-between p-3 bg-muted/50 rounded-lg border border-border/50">
                  <div>
                    <h4 class="font-medium text-foreground text-sm">{{name}}</h4>
                    <p class="text-xs text-muted-foreground">{{type}}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium text-step-kpi">{{reach}}</p>
                    <p class="text-xs text-muted-foreground">reach</p>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No marketing channels configured</p>
                </div>
              {{/if}}
            </div>
          </div>
        </div>

        <!-- Pricing Models & Competitive Analysis -->
        <div class="space-y-6">
          <!-- Pricing Models -->
          <div class="bg-card rounded-lg border border-border p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Pricing Models</h2>
            <div class="space-y-4">
              <div class="text-center">
                <div class="text-xl font-bold text-step-cogs mb-1">{{pricingModels.stats.total}}</div>
                <p class="text-sm text-muted-foreground">Total Models</p>
              </div>
              <div class="space-y-3">
                {{#if pricingModels.models.length}}
                  {{#each pricingModels.models}}
                  <div class="p-3 bg-muted/50 rounded-lg border border-border/50">
                    <h4 class="font-medium text-foreground text-sm">{{name}}</h4>
                    <p class="text-xs text-muted-foreground">{{type}}</p>
                    <p class="text-sm font-semibold text-success mt-1">${{price}}</p>
                  </div>
                  {{/each}}
                {{else}}
                  <div class="text-center py-4">
                    <p class="text-sm text-muted-foreground">No pricing models defined</p>
                    <button class="btn btn-outline btn-sm mt-2">Create Model</button>
                  </div>
                {{/if}}
              </div>
            </div>
          </div>

          <!-- Competitive Analysis -->
          <div class="bg-card rounded-lg border border-border p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Competitive Analysis</h2>
            <div class="space-y-3">
              {{#if competitiveAnalysis.length}}
                {{#each competitiveAnalysis}}
                <div class="p-3 bg-muted/50 rounded-lg border border-border/50">
                  <h4 class="font-medium text-foreground text-sm">{{competitor_name}}</h4>
                  <p class="text-xs text-muted-foreground">{{market_position}}</p>
                  <div class="flex items-center gap-2 mt-2">
                    <span class="text-xs text-muted-foreground">Strength:</span>
                    <span class="tag tag-primary">{{strength_score}}/10</span>
                  </div>
                </div>
                {{/each}}
              {{else}}
                <div class="text-center py-4">
                  <p class="text-sm text-muted-foreground">No competitive analysis</p>
                  <button class="btn btn-outline btn-sm mt-2">Start Analysis</button>
                </div>
              {{/if}}
            </div>
          </div>

          <!-- Campaign Performance -->
          <div class="bg-card rounded-lg border border-border p-6">
            <h2 class="text-xl font-semibold text-foreground mb-4">Campaign Performance</h2>
            <div class="grid grid-cols-2 gap-2 mb-4">
              <div class="text-center">
                <div class="text-lg font-bold text-step-kpi">{{campaignPerformance.stats.total}}</div>
                <p class="text-xs text-muted-foreground">Total Campaigns</p>
              </div>
              <div class="text-center">
                <div class="text-lg font-bold text-success">${{campaignPerformance.stats.totalBudget}}</div>
                <p class="text-xs text-muted-foreground">Total Budget</p>
              </div>
            </div>
            {{#if campaignPerformance.campaigns.length}}
              <div class="space-y-2">
                {{#each campaignPerformance.campaigns}}
                <div class="text-xs p-2 bg-muted/50 rounded">
                  <span class="font-medium">{{name}}</span>
                  <span class="text-muted-foreground"> - {{status}}</span>
                </div>
                {{/each}}
              </div>
            {{else}}
              <p class="text-xs text-muted-foreground text-center">No campaigns</p>
            {{/if}}
          </div>
        </div>
      </div>

      <!-- Enterprise/Corporate Specific Sections -->
      {{#if features.enterprise}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">B2B Targeting</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">45</div>
            <p class="text-sm text-muted-foreground">Enterprise Accounts</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">$2.1M</div>
            <p class="text-sm text-muted-foreground">Contract Value</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">89%</div>
            <p class="text-sm text-muted-foreground">Win Rate</p>
          </div>
        </div>
      </div>
      {{/if}}

      {{#if features.corporate}}
      <div class="bg-card rounded-lg border border-border p-6">
        <h2 class="text-xl font-semibold text-foreground mb-4">Global Campaigns</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-step-kpi mb-2">28</div>
            <p class="text-sm text-muted-foreground">Countries Targeted</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-revenue mb-2">$12M</div>
            <p class="text-sm text-muted-foreground">Global Budget</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-cogs mb-2">15</div>
            <p class="text-sm text-muted-foreground">Subsidiary Brands</p>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-step-streams mb-2">94%</div>
            <p class="text-sm text-muted-foreground">Brand Consistency</p>
          </div>
        </div>
      </div>
      {{/if}}
