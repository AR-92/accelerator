<main class="flex w-full flex-col px-4 mx-auto max-w-7xl mt-[100px]">
  <!-- Header -->
  <header class="w-full mb-8">
    <h1 class="text-3xl font-sans font-medium text-foreground mb-2">
      {{title}}
    </h1>
    <p class="text-muted-foreground">
      {{message}}
    </p>
  </header>

  <!-- Back Button -->
  <div class="flex justify-center">
    <a href="/projects/all-projects" class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Projects
    </a>
  </div>
</main>