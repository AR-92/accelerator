<!-- Header Section Start -->
<div class="flex flex-col gap-4 md:gap-6 mt-6">
  <div class="flex items-center justify-between">
    <div class="grid gap-1">
      <h1 class="font-heading text-3xl font-semibold text-foreground">
        Voting & Rewards Dashboard
      </h1>
      <p class="text-lg text-muted-foreground">
        Track your ideas' performance and rewards from community voting
      </p>
    </div>
    <div class="flex items-center gap-3">
      <!-- Time Period Selector -->
      <div class="relative">
        <select id="time-period"
          class="px-3 py-2 bg-card border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
          <option value="7d">Last 7 days</option>
          <option value="30d" selected>Last 30 days</option>
          <option value="90d">Last 90 days</option>
          <option value="all">All time</option>
        </select>
      </div>
      <button class="btn btn-primary">
        {{{icon 'plus' size='16'}}}
        Create New Idea
      </button>
    </div>

  </div>
<!-- Header Section End -->

  <!-- Stats Cards Section Start -->
  <div class="grid gap-4 grid-cols-5">
    <div
      class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Rewards Earned</h3>
          <p class="text-2xl font-semibold text-foreground">{{totalRewards}}</p>
        </div>
        <div>
          <div class="bg-success/20 rounded-lg">
            <div class="w-10 h-10 bg-success/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'gift' size="16" class='w-4 h-4 text-success-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <div class="flex justify-between text-xs text-muted-foreground mb-1">
          <span>Progress</span>
          <span>67%</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2">
          <div class="bg-success h-2 rounded-full" style="width: 67%"></div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">+8%</span>
        vs last period
      </p>
    </div>
    <div
      class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Current Credits</h3>
          <p class="text-2xl font-semibold text-foreground">{{currentCredits}}</p>
        </div>
        <div>
          <div class="bg-info/20 rounded-lg">
            <div class="w-10 h-10 bg-info/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-info rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'coins' size="16" class='w-4 h-4 text-info-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <div class="flex justify-between text-xs text-muted-foreground mb-1">
          <span>Available</span>
          <span>85%</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2">
          <div class="bg-info h-2 rounded-full" style="width: 85%"></div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">+15%</span>
        vs last period
      </p>
    </div>
    <div
      class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Overall Rating</h3>
          <p class="text-2xl font-semibold text-foreground">{{overallRating}}</p>
        </div>
        <div>
          <div class="bg-warning/20 rounded-lg">
            <div class="w-10 h-10 bg-warning/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-warning rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'star' size="16" class='w-4 h-4 text-warning-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <div class="flex justify-between text-xs text-muted-foreground mb-1">
          <span>Quality</span>
          <span>84%</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2">
          <div class="bg-warning h-2 rounded-full" style="width: 84%"></div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">+5%</span>
        vs last period
      </p>
    </div>
    <div
      class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Rewards Received</h3>
          <p class="text-2xl font-semibold text-foreground">{{totalRewardsReceived}}</p>
        </div>
        <div>
          <div class="bg-success/20 rounded-lg">
            <div class="w-10 h-10 bg-success/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'gift' size="16" class='w-4 h-4 text-success-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <div class="flex justify-between text-xs text-muted-foreground mb-1">
          <span>From Votes</span>
          <span>72%</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2">
          <div class="bg-success h-2 rounded-full" style="width: 72%"></div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">+10%</span>
        vs last period
      </p>
    </div>
    <div
      class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between px-3 py-1">
        <div class="flex flex-col gap-1">
          <h3 class="text-sm font-medium text-muted-foreground">Rewards Distributed</h3>
          <p class="text-2xl font-semibold text-foreground">{{rewardsGiven}}</p>
        </div>
        <div>
          <div class="bg-purple/20 rounded-lg">
            <div class="w-10 h-10 bg-purple/20 rounded-lg relative">
              <div class="flex items-center justify-center w-9 h-9 bg-purple rounded-lg absolute top-0.5 left-0.5">
                {{{icon 'gift' size="16" class='w-4 h-4 text-purple-foreground'}}}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <div class="flex justify-between text-xs text-muted-foreground mb-1">
          <span>Given Out</span>
          <span>{{rewardsGiven}}</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2">
          <div class="bg-purple h-2 rounded-full" style="width: 100%"></div>
        </div>
      </div>
      <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
        {{{icon 'trending-up' size="16" class='w-5 h-4'}}}
        <span class="text-success">Distributed</span>
        to voters
      </p>
    </div>
  </div>
<!-- Stats Cards Section End -->

  <!-- Profile and Achievements Section Start -->
  <div class="flex gap-4 flex-wrap">
    <!-- User Profile Summary -->
    <div class="bg-gradient-to-br from-card to-card/50 rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-4">
        <div class="relative flex-shrink-0">
          <img src="/images/avatar.png" alt="Avatar" class="w-16 h-16 rounded-full object-cover ring-2 ring-primary/20">
          <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-success rounded-full flex items-center justify-center ring-2 ring-background">
            {{{icon 'check-circle' size="12" class="text-success-foreground"}}}
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-lg font-semibold text-foreground truncate">{{userProfile.name}}</h3>
          <p class="text-sm text-muted-foreground">Level {{userProfile.level}} • Joined {{formatDate userProfile.joinDate}}</p>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-muted/50 rounded-lg p-3 text-center">
          <div class="text-2xl font-bold text-primary">{{userProfile.totalContributions}}</div>
          <div class="text-xs text-muted-foreground">Contributions</div>
        </div>
        <div class="bg-muted/50 rounded-lg p-3 text-center">
          <div class="text-2xl font-bold text-success">{{userProfile.reputation}}</div>
          <div class="text-xs text-muted-foreground">Reputation</div>
        </div>
      </div>

      <!-- Level Progress -->
      <div class="mt-4">
        <div class="flex justify-between text-xs text-muted-foreground mb-1">
          <span>Level Progress</span>
          <span>{{userProfile.level}}/10</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2">
          <div class="bg-primary h-2 rounded-full" style="width: {{multiply (divide userProfile.level 10) 100}}%"></div>
        </div>
      </div>
    </div>
    <!-- Best Performing Idea -->
    <div class="bg-card rounded-lg border border-border p-6">
      <h2 class="text-xl font-semibold text-foreground mb-4">Best Performing Idea</h2>
      <div class="flex items-center gap-4">
        <div class="flex-1">
          <h3 class="text-lg font-medium text-foreground">{{bestPerformingIdea.title}}</h3>
          <div class="flex items-center gap-4 mt-2">
            <div class="flex items-center gap-1">
              {{{icon 'heart' size="16" class="text-red-500"}}}
              <span class="text-sm text-muted-foreground">{{bestPerformingIdea.favorites}}</span>
            </div>
            <div class="flex items-center gap-1">
              {{{icon 'thumbs-up' size="16" class="text-blue-500"}}}
              <span class="text-sm text-muted-foreground">{{bestPerformingIdea.likes}}</span>
            </div>
            <div class="flex items-center gap-1">
              {{{icon 'eye' size="16" class="text-gray-500"}}}
              <span class="text-sm text-muted-foreground">{{bestPerformingIdea.views}}</span>
            </div>
            <div class="flex items-center gap-1">
              {{{icon 'star' size="16" class="text-yellow-500"}}}
              <span class="text-sm text-muted-foreground">{{bestPerformingIdea.rating}}</span>
            </div>
            <div class="flex items-center gap-1">
              {{{icon 'gift' size="16" class="text-green-600"}}}
              <span class="text-sm text-muted-foreground">{{bestPerformingIdea.rewards_received}}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid gap-4 grid-cols-2">
      {{#each achievements}}
      <div
        class="flex items-center gap-3 p-3 bg-muted/50 rounded-lg {{#if earned}}border border-{{color}}/20{{else}}opacity-60{{/if}}">
        <div class="p-2 bg-{{color}}/10 rounded-lg {{#if earned}}text-{{color}}{{else}}text-muted-foreground{{/if}}">
          {{{icon icon size="20"}}}
        </div>
        <div class="flex-1">
          <h4 class="font-medium text-foreground text-sm">{{title}}</h4>
          <p class="text-xs text-muted-foreground">{{description}}</p>
          {{#if earned}}
          <p class="text-xs text-{{color}} mt-1">Earned {{formatDate earned_date}}</p>
          {{else}}
          <div class="mt-2">
            <div class="flex justify-between text-xs text-muted-foreground mb-1">
              <span>Progress</span>
              <span>{{progress}}/{{target}}</span>
            </div>
            <div class="w-full bg-muted rounded-full h-1">
              <div class="bg-{{color}} h-1 rounded-full" style="width: {{multiply (divide progress target) 100}}%">
              </div>
            </div>
          </div>
          {{/if}}
        </div>
        {{#if earned}}
        <div class="text-{{color}}">
          {{{icon 'check-circle' size="16"}}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>

  </div>
<!-- Profile and Achievements Section End -->

  <!-- Goals & Targets Section Start -->
  <div class="bg-card rounded-lg border border-border p-6">
    <h2 class="text-xl font-semibold text-foreground mb-4">Goals & Targets</h2>
    <div class="grid gap-4 grid-cols-3">
      {{#each goals}}
      <div class="space-y-2">
        <div class="flex justify-between items-center">
          <span class="text-sm font-medium text-foreground">{{title}}</span>
          <span class="text-sm text-muted-foreground">{{current}}/{{target}} {{unit}}</span>
        </div>
        <div class="w-full bg-muted rounded-full h-2">
          <div class="bg-{{color}} h-2 rounded-full" style="width: {{multiply (divide current target) 100}}%"></div>
        </div>
        <div class="flex justify-between text-xs text-muted-foreground">
          <span>{{multiply (divide current target) 100}}% complete</span>
          <span>Due {{formatDate deadline}}</span>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
<!-- Goals & Targets Section End -->

  <!-- Leaderboard and Credits Section Start -->
  <div class="grid gap-4 grid-cols-2">

    <!-- Top Ideas Leaderboard -->
    <div class="bg-card rounded-lg border border-border p-6">
      <h2 class="text-xl font-semibold text-foreground mb-4">Top Ideas Leaderboard</h2>
      <div class="space-y-3">
        {{#each topIdeas}}
        <div class="flex items-center gap-4 p-3 bg-muted/50 rounded-lg">
          <div
            class="flex-shrink-0 w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-semibold">
            {{rank}}
          </div>
          <div class="flex-1">
            <h4 class="font-medium text-foreground">{{title}}</h4>
            <p class="text-sm text-muted-foreground">Rewards: {{rewards_received}} | Rating: {{rating}}</p>
          </div>
          <div class="text-right">
            <span class="text-sm font-medium text-success">{{rewards_received}} pts</span>
          </div>
        </div>
        {{/each}}
      </div>
    </div>


    <!-- Credits Given to Voters -->
    <div class="bg-card rounded-lg border border-border p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-foreground">Credits Given to Voters</h2>
        <div class="flex items-center gap-2 px-3 py-1 bg-success/10 text-success rounded-full text-sm font-medium">
          {{{icon 'gift' size="14"}}}
          {{creditsGiven.length}} distributions
        </div>
      </div>
      {{#if creditsGiven}}
      <div class="space-y-3 max-h-64 overflow-y-auto">
        {{#each creditsGiven}}
        <div class="flex items-center gap-3 p-3 bg-muted/50 rounded-lg hover:bg-muted/70 transition-colors">
          <div class="w-8 h-8 bg-success/10 rounded-full flex items-center justify-center">
            {{{icon 'gift' size='16' class='text-success'}}}
          </div>
          <div class="flex-1">
            <p class="text-sm font-medium text-foreground">{{voter}} voted on "{{idea}}"</p>
            <p class="text-xs text-muted-foreground">{{formatDate date 'relative'}}</p>
          </div>
          <div class="text-right">
            <span class="text-xs font-medium text-success">+{{credits}} credits</span>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="text-center py-8">
        <div class="w-12 h-12 bg-muted rounded-full flex items-center justify-center mx-auto mb-3">
          {{{icon 'gift' size='20' class='text-muted-foreground'}}}
        </div>
        <h3 class="text-sm font-medium text-foreground mb-1">No credits given yet</h3>
        <p class="text-xs text-muted-foreground">Credits given to voters will appear here</p>
      </div>
      {{/if}}
    </div>
  </div>
<!-- Leaderboard and Credits Section End -->

   <!-- Performance Chart Section Start -->
   <div class="bg-card rounded-lg border border-border p-6">
     <div class="flex items-center justify-between mb-4">
       <h2 class="text-xl font-semibold text-foreground">Performance Overview</h2>
       <div class="flex items-center gap-2">
         <div class="flex items-center gap-2">
           <div class="w-3 h-3 bg-primary rounded-full"></div>
           <span class="text-sm text-muted-foreground">Votes</span>
         </div>
         <div class="flex items-center gap-2">
           <div class="w-3 h-3 bg-success rounded-full"></div>
           <span class="text-sm text-muted-foreground">Rewards</span>
         </div>
       </div>
     </div>
     <div class="h-64">
       <canvas id="performanceChart"></canvas>
     </div>
   </div>
   <!-- Performance Chart Section End -->

  <!-- Activity and Notifications Section Start -->
  <div class="grid gap-4 grid-cols-2">
    <!-- Recent Voting Activity -->
    <div class="bg-card rounded-lg border border-border p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-foreground">Recent Activity</h2>
        <div class="flex items-center gap-2 px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium">
          {{{icon 'activity' size="14"}}}
          {{votes.length}} actions
        </div>
      </div>
      {{#if votes}}
      <div class="space-y-3 max-h-64 overflow-y-auto">
        {{#each votes}}
        <div
          class="flex items-center gap-3 p-3 bg-muted/50 rounded-lg hover:bg-muted/70 transition-colors cursor-pointer">
          <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
            {{{icon 'vote' size='16' class='text-primary'}}}
          </div>
          <div class="flex-1">
            <p class="text-sm font-medium text-foreground">{{idea_title}}</p>
            <p class="text-xs text-muted-foreground">{{formatDate created_at 'relative'}}</p>
          </div>
          <div class="text-right">
            <span class="text-xs font-medium text-success">+{{reward_earned}}</span>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="text-center py-8">
        <div class="w-12 h-12 bg-muted rounded-full flex items-center justify-center mx-auto mb-3">
          {{{icon 'activity' size='20' class='text-muted-foreground'}}}
        </div>
        <h3 class="text-sm font-medium text-foreground mb-1">No recent activity</h3>
        <p class="text-xs text-muted-foreground">Your voting activity will appear here</p>
      </div>
      {{/if}}
    </div>
    <!-- Notifications -->
    <div class="bg-card rounded-lg border border-border p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-foreground">Notifications</h2>
        <button class="text-sm text-primary hover:underline">Mark all read</button>
      </div>
      <div class="space-y-3 max-h-64 overflow-y-auto">
        {{#each notifications}}
        <div
          class="flex items-start gap-3 p-3 {{#if read}}bg-muted/30{{else}}bg-primary/5 border-l-4 border-primary{{/if}} rounded-lg">
          <div
            class="p-1.5 {{#if (eq type 'vote')}}bg-primary/10{{else if (eq type 'reward')}}bg-success/10{{else}}bg-warning/10{{/if}} rounded-lg mt-0.5">
            {{#if (eq type 'vote')}}
            {{{icon 'vote' size="14" class="text-primary"}}}
            {{else if (eq type 'reward')}}
            {{{icon 'gift' size="14" class="text-success"}}}
            {{else}}
            {{{icon 'trophy' size="14" class="text-warning"}}}
            {{/if}}
          </div>
          <div class="flex-1">
            <p class="text-sm text-foreground">{{message}}</p>
            <p class="text-xs text-muted-foreground mt-1">{{time}}</p>
          </div>
          {{#unless read}}
          <div class="w-2 h-2 bg-primary rounded-full mt-2"></div>
          {{/unless}}
        </div>
        {{/each}}
      </div>
    </div>

  </div>
<!-- Activity and Notifications Section End -->

  <!-- My Ideas Performance Section Start -->
  <div class="bg-card rounded-lg border border-border p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-semibold text-foreground">My Ideas Performance</h2>
      <div class="flex items-center gap-2">
        <!-- Search -->
        <div class="relative">
          <input type="text" id="idea-search" placeholder="Search ideas..."
            class="pl-9 pr-4 py-2 bg-muted border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 w-64">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center">
            {{{icon 'search' size="16" class="text-muted-foreground"}}}
          </div>
        </div>
        <!-- Filter -->
        <select id="idea-filter"
          class="px-3 py-2 bg-muted border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20">
          <option value="all">All Ideas</option>
          <option value="high-rating">High Rating (4.0+)</option>
          <option value="popular">Popular (100+ views)</option>
          <option value="recent">Recently Active</option>
        </select>
        <div class="flex items-center gap-2 px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium">
          {{{icon 'bar-chart-3' size="14"}}}
          <span id="ideas-count">{{ideas.length}}</span> ideas
        </div>
      </div>
    </div>
    {{#if ideas}}
    <div class="overflow-x-auto rounded-lg border border-border/50">
      <table id="ideas-table" class="w-full text-sm">
        <thead>
          <tr class="bg-muted/50 border-b border-border/50">
            <th class="text-left py-4 px-6 cursor-pointer hover:bg-muted/70 transition-colors rounded-tl-lg"
              onclick="sortTable(0)">
              <div class="flex items-center gap-2 font-semibold text-foreground">
                {{{icon 'lightbulb' size="16" class="text-primary"}}}
                Idea Title
                <span class="text-xs opacity-60">▼</span>
              </div>
            </th>
            <th class="text-center py-4 px-6 cursor-pointer hover:bg-muted/70 transition-colors" onclick="sortTable(1)">
              <div class="flex items-center justify-center gap-1 font-semibold text-foreground">
                {{{icon 'heart' size="16" class="text-red-500"}}}
                <span class="hidden md:inline">Favorites</span>
                <span class="text-xs opacity-60">▼</span>
              </div>
            </th>
            <th class="text-center py-4 px-6 cursor-pointer hover:bg-muted/70 transition-colors" onclick="sortTable(2)">
