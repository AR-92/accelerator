    </div>

     {{else}}
     <div class="text-center py-8">
       <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
         {{{icon 'lightbulb' size='24' class='text-muted-foreground'}}}
       </div>
       <h3 class="text-lg font-medium text-foreground mb-2">No ideas yet</h3>
       <p class="text-muted-foreground mb-4">Create your first idea to see performance stats</p>
       <button class="btn btn-primary">Create Idea</button>
     </div>
     {{/if}}
   </div>
 <!-- My Ideas Performance Section End -->

 <script>
   document.addEventListener('DOMContentLoaded', function() {
     const canvas = document.getElementById('performanceChart');
     if (!canvas) {
       console.error('Performance chart canvas not found');
       return;
     }

     const ctx = canvas.getContext('2d');

     // Get theme colors from CSS variables
     const computedStyle = getComputedStyle(document.documentElement);
     let primaryColor = computedStyle.getPropertyValue('--primary').trim();
     let successColor = computedStyle.getPropertyValue('--success').trim();

     // Convert HSL to hex if needed
     function hslToHex(hsl) {
       if (hsl.startsWith('#')) return hsl;
       // Parse HSL values
       const hslMatch = hsl.match(/(\d+)\s+(\d+)%\s+(\d+)%/);
       if (hslMatch) {
         const h = parseInt(hslMatch[1]);
         const s = parseInt(hslMatch[2]) / 100;
         const l = parseInt(hslMatch[3]) / 100;

         const c = (1 - Math.abs(2 * l - 1)) * s;
         const x = c * (1 - Math.abs((h / 60) % 2 - 1));
         const m = l - c/2;
         let r = 0, g = 0, b = 0;

         if (0 <= h && h < 60) {
           r = c; g = x; b = 0;
         } else if (60 <= h && h < 120) {
           r = x; g = c; b = 0;
         } else if (120 <= h && h < 180) {
           r = 0; g = c; b = x;
         } else if (180 <= h && h < 240) {
           r = 0; g = x; b = c;
         } else if (240 <= h && h < 300) {
           r = x; g = 0; b = c;
         } else if (300 <= h && h < 360) {
           r = c; g = 0; b = x;
         }

         r = Math.round((r + m) * 255);
         g = Math.round((g + m) * 255);
         b = Math.round((b + m) * 255);

         return "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
       }
       return '#3b82f6'; // fallback
     }

     primaryColor = hslToHex(primaryColor) || '#3b82f6';
     successColor = hslToHex(successColor) || '#10b981';

     // Helper function to convert hex to rgba
     function hexToRgba(hex, alpha) {
       const r = parseInt(hex.slice(1, 3), 16);
       const g = parseInt(hex.slice(3, 5), 16);
       const b = parseInt(hex.slice(5, 7), 16);
       return `rgba(${r}, ${g}, ${b}, ${alpha})`;
     }

     // Create gradients for better visual appeal
     const votesGradient = ctx.createLinearGradient(0, 0, 0, 400);
     votesGradient.addColorStop(0, hexToRgba(primaryColor, 0.6));
     votesGradient.addColorStop(0.7, hexToRgba(primaryColor, 0.2));
     votesGradient.addColorStop(1, hexToRgba(primaryColor, 0.0));

     const rewardsGradient = ctx.createLinearGradient(0, 0, 0, 400);
     rewardsGradient.addColorStop(0, hexToRgba(successColor, 0.6));
     rewardsGradient.addColorStop(0.7, hexToRgba(successColor, 0.2));
     rewardsGradient.addColorStop(1, hexToRgba(successColor, 0.0));

     const chart = new Chart(ctx, {
       type: 'line',
       data: {
         labels: {{{performanceData.labelsJson}}},
         datasets: [{
           label: 'Votes',
           data: {{{performanceData.votesJson}}},
           borderColor: primaryColor,
           backgroundColor: votesGradient,
           borderWidth: 3,
           tension: 0.4,
           fill: true,
           pointBackgroundColor: '#ffffff',
           pointBorderColor: primaryColor,
           pointBorderWidth: 3,
           pointRadius: 5,
           pointHoverRadius: 8,
           pointHoverBackgroundColor: primaryColor,
           pointHoverBorderColor: '#ffffff',
           pointHoverBorderWidth: 3
         }, {
           label: 'Rewards',
           data: {{{performanceData.rewardsJson}}},
           borderColor: successColor,
           backgroundColor: rewardsGradient,
           borderWidth: 3,
           tension: 0.4,
           fill: true,
           pointBackgroundColor: '#ffffff',
           pointBorderColor: successColor,
           pointBorderWidth: 3,
           pointRadius: 5,
           pointHoverRadius: 8,
           pointHoverBackgroundColor: successColor,
           pointHoverBorderColor: '#ffffff',
           pointHoverBorderWidth: 3
         }]
       },
       options: {
         responsive: true,
         maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false // Hide legend since we have custom legend above
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: 'rgba(0, 0, 0, 0.9)',
              titleColor: '#fff',
              bodyColor: '#fff',
              borderColor: 'rgba(255, 255, 255, 0.2)',
              borderWidth: 1,
              cornerRadius: 8,
              titleFont: {
                size: 14,
                weight: 'bold'
              },
              bodyFont: {
                size: 13
              },
              padding: 12,
              displayColors: true,
              boxWidth: 12,
              boxHeight: 12,
              usePointStyle: true
            }
          },
          scales: {
            x: {
              grid: {
                display: false
              },
              ticks: {
                color: 'rgba(0, 0, 0, 0.7)',
                font: {
                  size: 12,
                  weight: '500'
                },
                padding: 10
              },
              border: {
                display: false
              }
            },
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(0, 0, 0, 0.08)',
                lineWidth: 1,
                drawBorder: false
              },
              ticks: {
                color: 'rgba(0, 0, 0, 0.7)',
                font: {
                  size: 12,
                  weight: '500'
                },
                padding: 15,
                precision: 0
              },
              border: {
                display: false
              }
            }
          },
         interaction: {
           mode: 'nearest',
           axis: 'x',
           intersect: false
         }
       }
     });
   });
 </script>