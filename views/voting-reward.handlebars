          </tr>
        </thead>
        <tbody id="ideas-tbody">
          {{#each ideas}}
          <tr class="border-b border-border/30 hover:bg-muted/50 transition-all duration-200 group">
            <td class="py-4 px-6 font-medium text-foreground group-hover:text-primary transition-colors">{{title}}
            </td>
            <td class="text-center py-4 px-6">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 bg-destructive/10 text-destructive rounded-full text-sm font-medium">
                {{{icon 'heart' size="14" class="text-destructive"}}}
                {{favorites}}
              </div>
            </td>
            <td class="text-center py-4 px-6">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 bg-info/10 text-info rounded-full text-sm font-medium">
                {{{icon 'thumbs-up' size="14" class="text-info"}}}
                {{likes}}
              </div>
            </td>
            <td class="text-center py-4 px-6">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 bg-success/10 text-success rounded-full text-sm font-medium">
                {{{icon 'copy' size="14" class="text-success"}}}
                {{copies}}
              </div>
            </td>
            <td class="text-center py-4 px-6">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 bg-muted text-muted-foreground rounded-full text-sm font-medium">
                {{{icon 'eye' size="14" class="text-muted-foreground"}}}
                {{views}}
              </div>
            </td>
            <td class="text-center py-4 px-6">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 bg-warning/10 text-warning rounded-full text-sm font-medium">
                {{#if (gt rating 0)}}
                {{{icon 'star' size="14" class="text-warning"}}}
                {{/if}}
                {{rating}}
              </div>
            </td>
            <td class="text-center py-4 px-6">
              <div
                class="inline-flex items-center gap-2 px-3 py-1 bg-success/10 text-success rounded-full text-sm font-medium">
                {{{icon 'gift' size="14" class="text-success"}}}
                {{rewards_received}}
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between mt-6">
      <div class="text-sm text-muted-foreground">
        Showing <span id="showing-start">1</span> to <span id="showing-end">{{ideas.length}}</span> of
        {{ideas.length}} ideas
