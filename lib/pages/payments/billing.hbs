<main id="billing-main-content" class="flex-1 overflow-auto bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col gap-4 lg:gap-6 mt-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div class="grid gap-1">
          <h1 class="font-heading text-3xl font-semibold text-foreground">
            Billing & Transactions
          </h1>
          <p class="text-lg text-muted-foreground">
            Manage your subscription, view transaction history, and track credit usage
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button class="px-4 py-2 text-sm font-medium border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors">
            Export Transactions
          </button>
          <a href="/add-payment-method" class="px-4 py-2 text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors">
            Add Payment Method
          </a>
        </div>
      </div>

      <!-- Overview Cards -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Current Balance -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Current Balance</h3>
              <p class="text-2xl font-semibold text-foreground">{{billingStats.currentBalance}} credits</p>
            </div>
            <div>
              <div class="bg-success/20 rounded-lg">
                <div class="w-10 h-10 bg-success/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-success rounded-lg absolute top-0.5 left-0.5">
                    <svg class="lucide lucide-coins w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="8" cy="8" r="6"></circle>
                      <path d="M18.09 10.37A6 6 0 1 1 10.34 18"></path>
                      <path d="M7 6h1v4"></path>
                      <path d="m16.71 13.88.7.71-2.82 2.82"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-success">Available</span>
          </p>
        </div>

        <!-- Total Spent This Month -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Spent This Month</h3>
              <p class="text-2xl font-semibold text-foreground">{{billingStats.spentThisMonth}} credits</p>
            </div>
            <div>
              <div class="bg-primary/20 rounded-lg">
                <div class="w-10 h-10 bg-primary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-primary rounded-lg absolute top-0.5 left-0.5">
                    <svg class="lucide lucide-trending-up w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16 7h6v6"></path>
                      <path d="m22 7-8.5 8.5-5-5L2 17"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-muted-foreground">AI usage & reports</span>
          </p>
        </div>

        <!-- Current Package -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Current Package</h3>
              <p class="text-2xl font-semibold text-foreground capitalize">{{profile.package_type}}</p>
            </div>
            <div>
              <div class="bg-secondary/20 rounded-lg">
                <div class="w-10 h-10 bg-secondary/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-secondary rounded-lg absolute top-0.5 left-0.5">
                    <svg class="lucide lucide-package w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m7.5 4.27 9 5.15"></path>
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                      <path d="m3.3 7 8.7 5 8.7-5"></path>
                      <path d="M12 22V12"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-muted-foreground">
              {{#if (eq profile.package_type "free")}}
                Free Plan
              {{else}}
                ${{divide profile.package_price 100}}/month
              {{/if}}
            </span>
          </p>
        </div>

        <!-- Pending Transactions -->
        <div class="rounded-lg bg-card px-4 py-6 text-card-foreground shadow-sm border border-border">
          <div class="flex items-center justify-between px-3 py-1">
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-medium text-muted-foreground">Pending Items</h3>
              <p class="text-2xl font-semibold text-foreground">{{billingStats.pendingPayments}}</p>
            </div>
            <div>
              <div class="bg-warning/20 rounded-lg">
                <div class="w-10 h-10 bg-warning/20 rounded-lg relative">
                  <div class="flex items-center justify-center w-9 h-9 bg-warning rounded-lg absolute top-0.5 left-0.5">
                    <svg class="lucide lucide-clock w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12,6 12,12 16,14"></polyline>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="flex items-center gap-1 text-sm font-medium text-muted-foreground mt-2">
            <span class="text-warning">{{billingStats.pendingPayments}} transactions</span>
          </p>
        </div>
      </div>

      <!-- Transaction History Section -->
      <div class="bg-card rounded-lg border border-border overflow-hidden">
        <div class="px-6 py-4 border-b border-border">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold text-foreground">Transaction History</h2>
            <div class="flex items-center gap-2">
              <select id="transaction-filter" class="px-3 py-1.5 text-sm border border-input rounded-md bg-background">
                <option value="all">All Transactions</option>
                <option value="billing">Billing</option>
                <option value="credits">Credits</option>
                <option value="rewards">Rewards</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Transaction Table -->
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-muted/50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Amount</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-card divide-y divide-border">
              {{#each transactions}}
              <tr class="hover:bg-muted/50 transaction-row" data-type="{{transaction_type}}">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-foreground">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 w-8 h-8 {{#if (eq transaction_type "reward_earned")}}bg-yellow/10{{else if (eq transaction_type "credit_purchase")}}bg-green/10{{else if (eq transaction_type "ai_generation")}}bg-blue/10{{else if (eq transaction_type "report_generation")}}bg-purple/10{{else if (eq transaction_type "billing")}}bg-primary/10{{else}}bg-gray/10{{/if}} rounded-full flex items-center justify-center mr-3">
                      {{#if (eq transaction_type "reward_earned")}}
                        <svg class="w-4 h-4 text-yellow-600" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                      {{else if (eq transaction_type "credit_purchase")}}
                        <svg class="w-4 h-4 text-green-600" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="8" cy="8" r="6"></circle>
                          <path d="M18.09 10.37A6 6 0 1 1 10.34 18"></path>
                          <path d="M7 6h1v4"></path>
                          <path d="m16.71 13.88.7.71-2.82 2.82"></path>
                        </svg>
                      {{else if (eq transaction_type "billing")}}
                        <svg class="w-4 h-4 text-primary" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                          <line x1="16" x2="16" y1="2" y2="6"></line>
                          <line x1="8" x2="8" y1="2" y2="6"></line>
                          <line x1="3" x2="21" y1="10" y2="10"></line>
                        </svg>
                      {{else if (eq transaction_type "ai_generation")}}
                        <svg class="w-4 h-4 text-blue-600" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                        </svg>
                      {{else}}
                        <svg class="w-4 h-4 text-gray-600" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                      {{/if}}
                    </div>
                    <div>
                      <div class="text-sm font-medium text-foreground">{{formatDate created_at "short"}}</div>
                      <div class="text-sm text-muted-foreground">{{formatDate created_at "time"}}</div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex px-2 py-1 text-xs font-medium {{#if (eq transaction_type "reward_earned")}}bg-yellow/10 text-yellow-700{{else if (eq transaction_type "credit_purchase")}}bg-green/10 text-green-700{{else if (eq transaction_type "billing")}}bg-primary/10 text-primary{{else if (eq transaction_type "ai_generation")}}bg-blue/10 text-blue-700{{else}}bg-gray/10 text-gray-700{{/if}} rounded-full">
                    {{#if (eq transaction_type "reward_earned")}}
                      Reward
                    {{else if (eq transaction_type "credit_purchase")}}
                      Purchase
                    {{else if (eq transaction_type "billing")}}
                      Billing
                    {{else if (eq transaction_type "ai_generation")}}
                      AI Usage
                    {{else if (eq transaction_type "report_generation")}}
                      Report
                    {{else}}
                      {{transaction_type}}
                    {{/if}}
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-foreground">
                    {{#if (eq transaction_type "reward_earned")}}
                      Voting Reward
                    {{else if (eq transaction_type "credit_purchase")}}
                      Credit Purchase
                    {{else if (eq transaction_type "billing")}}
                      Subscription Payment
                    {{else if (eq transaction_type "ai_generation")}}
                      AI Generation
                    {{else if (eq transaction_type "report_generation")}}
                      Report Generation
                    {{else}}
                      {{transaction_type}}
                    {{/if}}
                  </div>
                  <div class="text-sm text-muted-foreground">
                    {{#if metadata.description}}
                      {{metadata.description}}
                    {{else if metadata.package_name}}
                      {{metadata.package_name}}
                    {{else if metadata.idea_title}}
                      "{{metadata.idea_title}}"
                    {{else}}
                      Transaction details
                    {{/if}}
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium {{#if (gt amount 0)}}text-success{{else}}text-foreground{{/if}}">
                  {{#if (gt amount 0)}}
                    +{{amount}} {{#if (eq transaction_type "billing")}}USD{{else}}credits{{/if}}
                  {{else}}
                    {{amount}} {{#if (eq transaction_type "billing")}}USD{{else}}credits{{/if}}
                  {{/if}}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex px-2 py-1 text-xs font-medium bg-success/10 text-success rounded-full">
                    Completed
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex items-center gap-2">
                    {{#if (eq transaction_type "billing")}}
                      <button class="text-primary hover:text-primary/80" title="Download Invoice">
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7,10 12,15 17,10"></polyline>
                          <line x1="12" x2="12" y1="15" y2="3"></line>
                        </svg>
                      </button>
                    {{/if}}
                    <button class="text-muted-foreground hover:text-foreground" title="View Details">
                      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="1"></circle>
                        <circle cx="12" cy="5" r="1"></circle>
                        <circle cx="12" cy="19" r="1"></circle>
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-sm text-muted-foreground">
                  No transactions found
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-border bg-card">
          <div class="flex items-center justify-between">
            <div class="text-sm text-muted-foreground">
              Showing <span class="font-medium">{{transactions.length}}</span> transactions
            </div>
            <div class="flex items-center gap-2">
              <button class="px-3 py-1.5 text-sm font-medium border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                Previous
              </button>
              <button class="px-3 py-1.5 text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors">1</button>
              <button class="px-3 py-1.5 text-sm font-medium border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors">
                Next
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Credit Usage Breakdown -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Credit Usage Chart -->
        <div class="bg-card rounded-lg border border-border p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-foreground">Credit Usage</h2>
            <select class="text-sm border border-input rounded-md px-3 py-1 bg-background">
              <option>Last 30 days</option>
              <option>Last 90 days</option>
              <option>All time</option>
            </select>
          </div>
          <div class="h-64 flex items-center justify-center bg-muted/20 rounded-lg">
            <div class="text-center">
              <svg class="w-12 h-12 text-muted-foreground mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"></path>
                <path d="m19 9-5 5-4-4-3 3"></path>
              </svg>
              <p class="text-muted-foreground">Usage chart visualization</p>
              <p class="text-sm text-muted-foreground mt-1">Integration with charting library needed</p>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-4">
            <div class="text-center">
              <div class="text-2xl font-bold text-foreground">{{billingStats.spentThisMonth}}</div>
              <div class="text-sm text-muted-foreground">Spent this month</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-foreground">{{billingStats.currentBalance}}</div>
              <div class="text-sm text-muted-foreground">Current balance</div>
            </div>
          </div>
        </div>

        <!-- Package & Billing Info -->
        <div class="bg-card rounded-lg border border-border p-6">
          <h2 class="text-xl font-semibold text-foreground mb-4">Package & Billing Information</h2>

          <div class="space-y-4">
            <!-- Current Package -->
            <div class="flex items-center justify-between p-4 border border-border rounded-lg">
              <div>
                <h3 class="font-medium text-foreground capitalize">{{profile.package_type}} Package</h3>
                <p class="text-sm text-muted-foreground">
                  {{#if (eq profile.package_type "free")}}
                    Basic features included
                  {{else}}
                    ${{divide profile.package_price 100}}/month • {{profile.package_credits}} credits
                  {{/if}}
                </p>
              </div>
              <div class="text-right">
                <span class="text-sm font-medium {{#if (eq profile.package_status "active")}}text-success{{else}}text-warning{{/if}} capitalize">
                  {{profile.package_status}}
                </span>
                {{#if profile.package_expires}}
                  <p class="text-xs text-muted-foreground">Renews {{formatDate profile.package_expires}}</p>
                {{/if}}
              </div>
            </div>

            <!-- Billing Address -->
            <div class="p-4 border border-border rounded-lg">
              <h3 class="font-medium text-foreground mb-2">Billing Address</h3>
              <p class="text-sm text-muted-foreground">
                {{#if profile.billing_address}}
                  {{profile.billing_address.street}}<br>
                  {{profile.billing_address.city}}, {{profile.billing_address.state}} {{profile.billing_address.zipCode}}<br>
                  {{profile.billing_address.country}}
                {{else}}
                  No billing address set
                {{/if}}
              </p>
            </div>

            <!-- Actions -->
            <div class="flex gap-2">
              <a href="/upgrade-package" class="flex-1 px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors text-center text-sm">
                {{#if (eq profile.package_type "free")}}
                  Upgrade Package
                {{else if (eq profile.package_type "student")}}
                  Upgrade to Enterprise
                {{else}}
                  Manage Package
                {{/if}}
              </a>
              <a href="/settings" class="px-4 py-2 border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-md transition-colors text-sm">
                Update Billing
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
// Transaction filtering
document.getElementById('transaction-filter').addEventListener('change', function() {
  const filter = this.value;
  const rows = document.querySelectorAll('.transaction-row');

  rows.forEach(row => {
    if (filter === 'all') {
      row.style.display = '';
    } else if (filter === 'billing' && row.dataset.type === 'billing') {
      row.style.display = '';
    } else if (filter === 'credits' && ['ai_generation', 'report_generation', 'credit_purchase'].includes(row.dataset.type)) {
      row.style.display = '';
    } else if (filter === 'rewards' && row.dataset.type === 'reward_earned') {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
});
</script>