<!-- AI Generation Modal -->
<div id="ai-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
    <div class="bg-card p-6 rounded-lg shadow-lg max-w-md w-full mx-4">
        <h3 class="text-lg font-bold ">AI Content Generation</h3>
        <textarea id="ai-prompt" class="w-full p-2 border rounded " rows="4"
            placeholder="Enter your prompt for AI generation..."></textarea>
        <div class="flex">
            <button id="generate-btn"
                class="bg-accent hover:bg-accent/90 text-accent-foreground px-4 py-2 rounded">Generate</button>
            <button id="close-modal"
                class="bg-muted hover:bg-muted/90 text-muted-foreground px-4 py-2 rounded">Close</button>
        </div>
    </div>
</div>

<script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
<script>
    // Helper function to generate star rating
    function generateStars(rating) {
        const fullStars = Math.floor(rating);
        const hasHalfStar = rating % 1 >= 0.5;
        const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
        return '★'.repeat(fullStars) + (hasHalfStar ? '☆' : '') + '☆'.repeat(emptyStars);
    }

    // Mode variables
    let masonryInstance = null;
    let activeSectionId = 'executive-summary-section';

    document.addEventListener('DOMContentLoaded', async () => {
        const ideaId = '{{ideaId}}';
        if (ideaId) {
            try {
                const response = await fetch(`/api/ideas/${ideaId}`);
                const idea = await response.json();
                if (response.ok) {


                    // Populate display elements
                    document.getElementById('display-title').textContent = idea.title || 'Untitled';
                    document.getElementById('display-category').textContent = idea.category || 'Uncategorized';
                    document.getElementById('display-description').textContent = idea.description || 'No description available';

                    // Populate rating and votes
                    document.getElementById('rating-stars').textContent = generateStars(idea.rating || 5.0);
                    document.getElementById('rating-value').textContent = (idea.rating || 5.0).toFixed(1);
                    document.getElementById('vote-count').textContent = `${idea.votes || 0} votes`;

                    // Populate display tags
                    const displayTagsContainer = document.getElementById('display-tags');
                    if (idea.tags && Array.isArray(idea.tags) && idea.tags.length > 0) {
                        idea.tags.forEach(tag => {
                            if (typeof tag === 'string' && tag.trim()) {
                                const tagElement = document.createElement('span');
                                tagElement.className = 'inline-flex items-center gap-1 px-2 py-1 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full';
                                tagElement.textContent = tag.trim();
                                displayTagsContainer.appendChild(tagElement);
                            }
                        });
                    } else {
                        displayTagsContainer.innerHTML = '<span class="text-muted-foreground text-sm">No tags</span>';
                    }

                    // const masonry = new Masonry('#masonry-container', {
                    //     itemSelector: '.bg-card',
                    //     columnWidth: 600,
                    //     gutter: 15,
                    //     percentPosition: true,
                    //     transitionDuration: 0
                    //});
                    console.log('Masonry items:', masonry.items.length, 'Columns:', masonry.cols);

                } else {
                    console.error('Error loading idea:', idea.error);
                    showToastMessage('Error loading idea details', 'error');
                    // Set default display values
                    document.getElementById('display-title').textContent = 'Error loading idea';
                    document.getElementById('display-description').textContent = 'Unable to load idea details';
                }
            } catch (error) {
                console.error('Error loading idea:', error);
                showToastMessage('Network error loading idea details', 'error');
                // Set default display values
                document.getElementById('display-title').textContent = 'Error loading idea';
                document.getElementById('display-description').textContent = 'Unable to load idea details';
            }
        }
    });



    // Report interactions
    document.addEventListener('DOMContentLoaded', () => {
        // Add smooth scroll to section headings for better navigation
        const reportSections = document.querySelectorAll('.report-section h2');

        reportSections.forEach(heading => {
            heading.style.cursor = 'pointer';
            heading.addEventListener('click', () => {
                heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    });

    // Section navigation
    const pills = document.querySelectorAll('.floating-step-pill');
    pills.forEach(pill => {
        pill.addEventListener('click', () => {
            // Remove active from all sections
            document.querySelectorAll('.report-section').forEach(sec => sec.classList.remove('active'));
            // Remove active styles from all pills
            document.querySelectorAll('.floating-step-pill').forEach(p => {
                p.classList.remove('bg-primary', 'text-primary-foreground');
                p.classList.add('bg-muted', 'text-muted-foreground');
            });
            // Add active styles to clicked pill
            pill.classList.remove('bg-muted', 'text-muted-foreground');
            pill.classList.add('bg-primary', 'text-primary-foreground');
            // Show corresponding section
            const sectionId = pill.getAttribute('data-section');
            document.getElementById(sectionId).classList.add('active');
            activeSectionId = sectionId;
        });
    });

    // Mode toggle
    document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const mode = btn.getAttribute('data-mode');
            // Remove active from all mode buttons
            document.querySelectorAll('.mode-btn').forEach(b => {
                b.classList.remove('bg-primary', 'text-primary-foreground');
                b.classList.add('bg-muted', 'text-muted-foreground');
            });
            // Add active to clicked button
            btn.classList.remove('bg-muted', 'text-muted-foreground');
            btn.classList.add('bg-primary', 'text-primary-foreground');

            // Switch modes
            if (mode === 'focus') {
                // Focus mode: show only active section, destroy masonry
                document.querySelectorAll('.report-section').forEach(sec => sec.classList.remove('active'));
                document.getElementById(activeSectionId).classList.add('active');
                if (masonryInstance) {
                    masonryInstance.destroy();
                    masonryInstance = null;
                }
            } else if (mode === 'total') {
                // Total mode: show all sections, init masonry
                document.querySelectorAll('.report-section').forEach(sec => sec.classList.add('active'));
                masonryInstance = new Masonry('#masonry-container', {
                    itemSelector: '.bg-card',
                    columnWidth: 300,
                    gutter: 10,
                    percentPosition: true,
                    transitionDuration: 0
                });
            }
        });
    });

    // Expand/Collapse buttons
    document.querySelectorAll('.expand-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const card = e.target.closest('.bg-card');
            const content = card.querySelector('.expandable');
            const isExpanded = content.style.display !== 'none';
            content.style.display = isExpanded ? 'none' : 'block';
            btn.textContent = isExpanded ? 'Expand' : 'Collapse';
            // Reload masonry after layout change
            setTimeout(() => {
                const masonry = new Masonry('#masonry-container', {
                    itemSelector: '.bg-card',
                    columnWidth: 600,
                    gutter: 15,
                    percentPosition: true,
                    transitionDuration: 0
                });
            }, 100);
        });
    });

    // Edit and AI buttons
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const card = e.target.closest('.bg-card');
            const content = card.querySelector('.content');
            const isEditable = content.contentEditable === 'true';
            content.contentEditable = !isEditable;
            btn.textContent = isEditable ? 'Edit' : 'Save';
        });
    });

    document.querySelectorAll('.ai-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const modal = document.getElementById('ai-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex', 'items-center', 'justify-center');
        });
    });

    document.getElementById('close-modal').addEventListener('click', () => {
        const modal = document.getElementById('ai-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex', 'items-center', 'justify-center');
    });

    document.getElementById('generate-btn').addEventListener('click', () => {
        const prompt = document.getElementById('ai-prompt').value;
        alert('AI Generation Mock: Generated content based on: ' + prompt);
        const modal = document.getElementById('ai-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex', 'items-center', 'justify-center');
    });

    // Toolbar AI buttons
    document.querySelectorAll('[aria-label="Improve with AI"]').forEach(btn => {
        btn.addEventListener('click', () => {
            const modal = document.getElementById('ai-modal');
            document.getElementById('ai-prompt').placeholder = 'Enter prompt to improve this section...';
            modal.classList.remove('hidden');
            modal.classList.add('flex', 'items-center', 'justify-center');
        });
    });

    document.querySelectorAll('[aria-label="Add tags with AI"]').forEach(btn => {
        btn.addEventListener('click', () => {
            const modal = document.getElementById('ai-modal');
            document.getElementById('ai-prompt').placeholder = 'Enter prompt to generate tags...';
            modal.classList.remove('hidden');
            modal.classList.add('flex', 'items-center', 'justify-center');
        });
    });

    document.querySelectorAll('[aria-label="Generate Content with AI"]').forEach(btn => {
        btn.addEventListener('click', () => {
            const modal = document.getElementById('ai-modal');
            document.getElementById('ai-prompt').placeholder = 'Enter prompt to generate content for this section...';
            modal.classList.remove('hidden');
            modal.classList.add('flex', 'items-center', 'justify-center');
        });
    });

    // Floating form script
    document.addEventListener('DOMContentLoaded', () => {
        console.log('DOMContentLoaded fired for floating create-idea-card');
        // Initialize form elements
        const floatingForm = document.getElementById('floating-new-project-form');
        const floatingDescriptionTextarea = document.getElementById('floating-assistant-prompt');
        const floatingTagsContainer = document.getElementById('floating-tagslist');
        const floatingSubmitButton = floatingForm.querySelector('button[type="submit"]');

        // Auto-expand textarea
        function floatingAutoExpandTextarea() {
            floatingDescriptionTextarea.style.height = 'auto';
            floatingDescriptionTextarea.style.height = floatingDescriptionTextarea.scrollHeight + 'px';
        }

        // Character counter
        function floatingUpdateCharCounter() {
            const length = floatingDescriptionTextarea.value.length;
            const counter = document.getElementById('floating-char-counter');
            counter.textContent = `Characters: ${length} / 2000`;
            if (length < 100 || length > 2000) {
                counter.className = 'text-xs text-red-500/60 mr-2';
            } else {
                counter.className = 'text-xs text-green-500/60 mr-2';
            }
            floatingAutoExpandTextarea();
        }

        // Initialize textarea height
        floatingDescriptionTextarea.style.minHeight = '2.5rem';
        floatingDescriptionTextarea.style.resize = 'none';
        floatingDescriptionTextarea.style.overflow = 'hidden';

        floatingDescriptionTextarea.addEventListener('input', floatingUpdateCharCounter);
        floatingUpdateCharCounter();

        // Ensure textarea height is adjusted for pre-filled content
        setTimeout(() => {
            floatingAutoExpandTextarea();
        }, 0);



        const floatingRemoveAllTagsBtn = document.getElementById('floating-removeAllTags');
        floatingRemoveAllTagsBtn.style.display = 'none';

        function floatingUpdateRemoveAllVisibility() {
            const tagCount = document.querySelectorAll('.floating-tag-lskjsdb').length;
            floatingRemoveAllTagsBtn.style.display = tagCount > 1 ? 'inline-flex' : 'none';
        }

        floatingRemoveAllTagsBtn.addEventListener('click', function (e) {
            floatingRemoveAllTags();
        });

        // Tag management functions
        function floatingAddTag(tagText) {
            console.log('floatingAddTag called with:', tagText);
            if (typeof tagText === 'object') {
                tagText = tagText.name || tagText.value || tagText.toString();
            }
            if (!tagText || !tagText.trim()) {
                console.log('Tag text is empty or invalid, skipping');
                return;
            }
            const tagSpan = document.createElement('span');
            tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full floating-tag-lskjsdb';
            tagSpan.innerHTML = `<span contenteditable="true">${tagText}</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
            const addMoreBtn = floatingTagsContainer.querySelector('[class*="bg-success/5"]');
            console.log('addMoreBtn found:', addMoreBtn);
            if (addMoreBtn) {
                addMoreBtn.after(tagSpan);
                console.log('Tag span added');
            } else {
                console.log('addMoreBtn not found, tag not added');
            }
            tagSpan.querySelector('button').addEventListener('click', function () {
                tagSpan.remove();
                showToastMessage('Tag removed', 'success');
                floatingUpdateRemoveAllVisibility();
            });
            floatingUpdateRemoveAllVisibility();
        }

        function floatingAddTagsFromArray(tagsArray) {
            if (Array.isArray(tagsArray)) {
                tagsArray.forEach(tag => floatingAddTag(tag));
            }
        }

        function floatingRemoveAllTags() {
            const tagElements = document.querySelectorAll('.floating-tag-lskjsdb');
            const count = tagElements.length;
            if (count === 0) {
                showToastMessage('No tags to remove', 'warning');
            } else {
                tagElements.forEach(tag => tag.remove());
                showToastMessage(`${count} tags removed`, 'success');
                floatingUpdateRemoveAllVisibility();
            }
        }

        // AI button handlers
        async function floatingCallAIApi(endpoint, data) {
            try {
                const response = await fetch(`/api/ai/${endpoint}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                return await response.json();
            } catch (error) {
                console.error('AI API error:', error);
                return { error: 'Network error' };
            }
        }

        // Helper function to set button loading state
        function floatingSetButtonLoading(button, loading) {
            if (!button) return;

            const icon = button.querySelector('svg');
            const textSpan = button.querySelector('span');

            if (loading) {
                button.disabled = true;
                button.classList.add('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Replace icon with loading spinner
                if (icon) {
                    icon.outerHTML = `
                        <svg class="lucide lucide-loader w-4 h-4 animate-spin text-warning" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                        </svg>
                    `;
                }

                // Show processing text
                if (textSpan) {
                    textSpan.textContent = 'Processing...';
                    textSpan.classList.remove('hidden', 'group-hover:inline');
                    textSpan.classList.add('inline', 'text-warning');
                }
            } else {
                button.disabled = false;
                button.classList.remove('cursor-not-allowed', 'bg-warning/20', 'border-warning/50');

                // Restore original icon
                const spinner = button.querySelector('.animate-spin');
                if (spinner) {
                    const ariaLabel = button.getAttribute('aria-label');
                    let originalIcon = '';

                    if (ariaLabel.includes('title')) {
                        originalIcon = `<svg class="lucide lucide-type w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg>`;
                    } else if (ariaLabel.includes('category')) {
                        originalIcon = `<svg class="lucide lucide-folder w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>`;
                    } else if (ariaLabel.includes('Improve')) {
                        originalIcon = `<svg class="lucide lucide-lightbulb w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>`;
                    } else if (ariaLabel.includes('tags')) {
                        originalIcon = `<svg class="lucide lucide-tag w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>`;
                    } else if (ariaLabel.includes('Auto fill')) {
                        originalIcon = `<svg class="lucide lucide-wand-sparkles w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"></path><path d="m14 7 3 3"></path><path d="M5 6v4"></path><path d="M19 14v4"></path><path d="M10 2v2"></path><path d="M7 8H3"></path><path d="M21 16h-4"></path><path d="M11 3H9"></path></svg>`;
                    } else if (ariaLabel.includes('random')) {
                        originalIcon = `<svg class="lucide lucide-shuffle w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 14 4 4-4 4"></path><path d="m18 2 4 4-4 4"></path><path d="M2 18h1.973a4 4 0 0 0 3.3-1.7l5.454-8.6a4 4 0 0 1 3.3-1.7H22"></path><path d="M2 6h1.972a4 4 0 0 1 3.6 2.2"></path><path d="M22 18h-6.041a4 4 0 0 1-3.3-1.8l-.359-.45"></path></svg>`;
                    }

                    spinner.outerHTML = originalIcon;
                }

                // Reset text to original state and restore hover behavior
                if (textSpan) {
                    // Reset to original text based on button type
                    const ariaLabel = button.getAttribute('aria-label');
                    if (ariaLabel.includes('title')) {
                        textSpan.textContent = 'Generate Title with AI';
                    } else if (ariaLabel.includes('category')) {
                        textSpan.textContent = 'Add Category with AI';
                    } else if (ariaLabel.includes('Improve')) {
                        textSpan.textContent = 'Improve Description with AI';
                    } else if (ariaLabel.includes('tags')) {
                        textSpan.textContent = 'Add Tags with AI';
                    } else if (ariaLabel.includes('Auto fill')) {
                        textSpan.textContent = 'Auto Fill with AI';
                    } else if (ariaLabel.includes('random')) {
                        textSpan.textContent = 'Random Idea with AI';
                    }

                    // Restore original classes for hover behavior
                    textSpan.classList.remove('inline', 'text-warning');
                    textSpan.classList.add('hidden', 'group-hover:inline');
                }
            }
        }







        // Reset form
        const floatingResetFormBtn = floatingForm.querySelector('[aria-label="Reset form"]');
        if (floatingResetFormBtn) {
            floatingResetFormBtn.addEventListener('click', function (e) {
                floatingDescriptionTextarea.value = '';
                floatingRemoveAllTags();
                floatingUpdateCharCounter();
                showToastMessage('Form reset successfully', 'info');
            });
        }

        // Auto fill with AI
        const floatingAutoFillBtn = floatingForm.querySelector('[aria-label="Auto fill with AI"]');
        if (floatingAutoFillBtn) {
            floatingAutoFillBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const currentDescription = floatingDescriptionTextarea.value.trim();
                if (!currentDescription) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                floatingSetButtonLoading(floatingAutoFillBtn, true);
                try {
                    showToastMessage('Auto filling with AI...', 'info');
                    const result = await floatingCallAIApi('auto-fill', { description: currentDescription });
                    if (result.error) {
                        showToastMessage('AI error: ' + result.error, 'error');
                    } else {
                        const currentTags = Array.from(document.querySelectorAll('.floating-tag-lskjsdb span[contenteditable]')).map(span => span.textContent.trim()).filter(tag => tag);

                        let filledCount = 0;

                        // Fill description if too small or missing
                        if (!currentDescription || currentDescription.length < 100) {
                            floatingDescriptionTextarea.value = result.description || '';
                            floatingUpdateCharCounter();
                            filledCount++;
                        }

                        // Fill tags if none exist
                        if (currentTags.length === 0) {
                            if (result.tags && result.tags.length > 0) {
                                floatingAddTagsFromArray(result.tags);
                                filledCount++;
                            }
                        }

                        showToastMessage(`Auto filled ${filledCount} fields successfully`, 'success');
                        showToastMessage('10 credits deducted for AI usage', 'warning');
                        if (typeof window.loadNavCreditBalance === 'function') {
                            window.loadNavCreditBalance();
                        }
                    }
                } catch (error) {
                    console.error('Auto fill error:', error);
                    showToastMessage('Network error. Please try again.', 'error');
                } finally {
                    floatingSetButtonLoading(floatingAutoFillBtn, false);
                }
            });
        }
    });

    // Pill text variations
    const pillFullTexts = [
        '1. Executive Summary',
        '2. Problem Analysis',
        '3. Solution Overview',
        '4. Market Analysis',
        '5. Product Concept',
        '6. Go-to-Market Strategy',
        '7. Brand Strategy',
        '8. Intellectual Property Protection'
    ];
    const pillNumbers = ['1.', '2.', '3.', '4.', '5.', '6.', '7.', '8.'];

    // Handle pill clicks for scrolling and highlighting
    document.querySelectorAll('.floating-step-pill').forEach((pill, index) => {
        pill.addEventListener('click', () => {
            const sectionIds = [
                'executive-summary-section',
                'problem-analysis-section',
                'solution-overview-section',
                'market-analysis-section',
                'product-concept-section',
                'go-to-market-strategy-section',
                'brand-strategy-section',
                'intellectual-property-protection-section'
            ];
            const targetSection = document.getElementById(sectionIds[index]);
            if (targetSection) {
                // Get and parse primary color
                const primaryValue = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
                let primaryHSL;
                if (primaryValue && primaryValue.includes(' ')) {
                    const parts = primaryValue.split(' ');
                    primaryHSL = parts.join(', ');
                } else {
                    primaryHSL = '290, 64%, 43%';
                }

                // Remove shadow from all sections and collapse their content
                document.querySelectorAll('[id$="-section"]').forEach(sec => {
                    sec.style.boxShadow = '';
                    const expandable = sec.querySelector('.expandable');
                    if (expandable) {
                        expandable.style.display = 'none';
                    }
                });
                // Add shadow to target and expand its content
                targetSection.style.boxShadow = `0 0 12px hsla(${primaryHSL}, 0.6), 0 0 24px hsla(${primaryHSL}, 0.3)`;
                const targetExpandable = targetSection.querySelector('.expandable');
                if (targetExpandable) {
                    targetExpandable.style.display = 'block';
                }

                // Update pill active states
                document.querySelectorAll('.floating-step-pill').forEach((p, i) => {
                    if (i === index) {
                        p.classList.remove('bg-muted', 'text-muted-foreground');
                        p.classList.add('bg-primary', 'text-primary-foreground');
                        p.textContent = pillFullTexts[i];
                    } else {
                        p.classList.remove('bg-primary', 'text-primary-foreground');
                        p.classList.add('bg-muted', 'text-muted-foreground');
                        p.textContent = pillNumbers[i];
                    }
                });

                // Scroll to section
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

                // Reload Masonry to fix layout after content changes
                setTimeout(() => {
                    // const masonry = new Masonry('#masonry-container', {
                    //     itemSelector: '.bg-card',
                    //     columnWidth: 600,
                    //     gutter: 15,
                    //     percentPosition: true,
                    //     transitionDuration: 0
                    //});
                }, 100);
            }
        });
    });

    // Initialize pill texts and shadow on load (first pill/section active)
    document.querySelectorAll('.floating-step-pill').forEach((p, i) => {
        if (i === 0) {
            p.textContent = pillFullTexts[i];
        } else {
            p.textContent = pillNumbers[i];
        }
    });

    // Initialize shadow and expand on first section (active by default)
    const firstSection = document.getElementById('executive-summary-section');
    if (firstSection) {
        const primaryValue = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
        let primaryHSL;
        if (primaryValue && primaryValue.includes(' ')) {
            const parts = primaryValue.split(' ');
            primaryHSL = parts.join(', ');
        } else {
            primaryHSL = '290, 64%, 43%';
        }
        firstSection.style.boxShadow = `0 0 12px hsla(${primaryHSL}, 0.6), 0 0 24px hsla(${primaryHSL}, 0.3)`;
        const firstExpandable = firstSection.querySelector('.expandable');
        if (firstExpandable) {
            firstExpandable.style.display = 'block';
        }
    }

    // Collapse all sections except the first
    document.querySelectorAll('[id$="-section"]').forEach(sec => {
        if (sec !== firstSection) {
            const expandable = sec.querySelector('.expandable');
            if (expandable) {
                expandable.style.display = 'none';
            }
        }
    });

    // Handle edit button clicks
    document.querySelectorAll('.bg-card .flex.items-center.justify-between button').forEach((btn, index) => {
        btn.addEventListener('click', () => {
            const sectionIds = [
                'executive-summary-section',
                'problem-analysis-section',
                'solution-overview-section',
                'market-analysis-section',
                'product-concept-section',
                'go-to-market-strategy-section',
                'brand-strategy-section',
                'intellectual-property-protection-section'
            ];
            const targetSection = document.getElementById(sectionIds[index]);
            if (targetSection) {
                const primaryValue = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
                let primaryHSL;
                if (primaryValue && primaryValue.includes(' ')) {
                    const parts = primaryValue.split(' ');
                    primaryHSL = parts.join(', ');
                } else {
                    primaryHSL = '290, 64%, 43%';
                }

                document.querySelectorAll('[id$="-section"]').forEach(sec => {
                    sec.style.boxShadow = '';
                    const expandable = sec.querySelector('.expandable');
                    if (expandable) {
                        expandable.style.display = 'none';
                    }
                });
                targetSection.style.boxShadow = `0 0 12px hsla(${primaryHSL}, 0.6), 0 0 24px hsla(${primaryHSL}, 0.3)`;
                const targetExpandable = targetSection.querySelector('.expandable');
                if (targetExpandable) {
                    targetExpandable.style.display = 'block';
                }

                document.querySelectorAll('.floating-step-pill').forEach((p, i) => {
                    if (i === index) {
                        p.classList.remove('bg-muted', 'text-muted-foreground');
                        p.classList.add('bg-primary', 'text-primary-foreground');
                        p.textContent = pillFullTexts[i];
                    } else {
                        p.classList.remove('bg-primary', 'text-primary-foreground');
                        p.classList.add('bg-muted', 'text-muted-foreground');
                        p.textContent = pillNumbers[i];
                    }
                });

                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

                setTimeout(() => {
                    // const masonry = new Masonry('#masonry-container', {
                    //     itemSelector: '.bg-card',
                    //     columnWidth: 600,
                    //     gutter: 15,
                    //     percentPosition: true,
                    //     transitionDuration: 0
                    //});
                }, 100);
            }
        });
    });
</script>