<style>
    .rainbow-shadow {
        /* No default shadow */
    }

    .rainbow-shadow:hover {
        animation: rainbow-shadow 20s infinite linear;
    }

    @keyframes rainbow-shadow {
        0% {
            box-shadow: 0 0 20px 10px rgba(255, 0, 0, 0.15);
        }

        2.5% {
            box-shadow: 0 0 20px 10px rgba(255, 32, 0, 0.15);
        }

        5% {
            box-shadow: 0 0 20px 10px rgba(255, 64, 0, 0.15);
        }

        7.5% {
            box-shadow: 0 0 20px 10px rgba(255, 96, 0, 0.15);
        }

        10% {
            box-shadow: 0 0 20px 10px rgba(255, 128, 0, 0.15);
        }

        12.5% {
            box-shadow: 0 0 20px 10px rgba(255, 160, 0, 0.15);
        }

        15% {
            box-shadow: 0 0 20px 10px rgba(255, 192, 0, 0.15);
        }

        17.5% {
            box-shadow: 0 0 20px 10px rgba(255, 224, 0, 0.15);
        }

        20% {
            box-shadow: 0 0 20px 10px rgba(255, 255, 0, 0.15);
        }

        22.5% {
            box-shadow: 0 0 20px 10px rgba(224, 255, 0, 0.15);
        }

        25% {
            box-shadow: 0 0 20px 10px rgba(192, 255, 0, 0.15);
        }

        27.5% {
            box-shadow: 0 0 20px 10px rgba(160, 255, 0, 0.15);
        }

        30% {
            box-shadow: 0 0 20px 10px rgba(128, 255, 0, 0.15);
        }

        32.5% {
            box-shadow: 0 0 20px 10px rgba(96, 255, 0, 0.15);
        }

        35% {
            box-shadow: 0 0 20px 10px rgba(64, 255, 0, 0.15);
        }

        37.5% {
            box-shadow: 0 0 20px 10px rgba(32, 255, 0, 0.15);
        }

        40% {
            box-shadow: 0 0 20px 10px rgba(0, 255, 0, 0.15);
        }

        42.5% {
            box-shadow: 0 0 20px 10px rgba(0, 255, 32, 0.15);
        }

        45% {
            box-shadow: 0 0 20px 10px rgba(0, 255, 64, 0.15);
        }

        47.5% {
            box-shadow: 0 0 20px 10px rgba(0, 255, 96, 0.15);
        }

        50% {
            box-shadow: 0 0 20px 10px rgba(0, 255, 128, 0.15);
        }

        52.5% {
            box-shadow: 0 0 20px 10px rgba(0, 255, 160, 0.15);
        }

        55% {
            box-shadow: 0 0 20px 10px rgba(0, 255, 192, 0.15);
        }

        57.5% {
            box-shadow: 0 0 20px 10px rgba(0, 224, 255, 0.15);
        }

        60% {
            box-shadow: 0 0 20px 10px rgba(0, 192, 255, 0.15);
        }

        62.5% {
            box-shadow: 0 0 20px 10px rgba(0, 160, 255, 0.15);
        }

        65% {
            box-shadow: 0 0 20px 10px rgba(0, 128, 255, 0.15);
        }

        67.5% {
            box-shadow: 0 0 20px 10px rgba(0, 96, 255, 0.15);
        }

        70% {
            box-shadow: 0 0 20px 10px rgba(0, 64, 255, 0.15);
        }

        72.5% {
            box-shadow: 0 0 20px 10px rgba(0, 32, 255, 0.15);
        }

        75% {
            box-shadow: 0 0 20px 10px rgba(0, 0, 255, 0.15);
        }

        77.5% {
            box-shadow: 0 0 20px 10px rgba(32, 0, 255, 0.15);
        }

        80% {
            box-shadow: 0 0 20px 10px rgba(64, 0, 255, 0.15);
        }

        82.5% {
            box-shadow: 0 0 20px 10px rgba(96, 0, 255, 0.15);
        }

        85% {
            box-shadow: 0 0 20px 10px rgba(128, 0, 255, 0.15);
        }

        87.5% {
            box-shadow: 0 0 20px 10px rgba(160, 0, 255, 0.15);
        }

        90% {
            box-shadow: 0 0 20px 10px rgba(192, 0, 255, 0.15);
        }

        92.5% {
            box-shadow: 0 0 20px 10px rgba(224, 0, 255, 0.15);
        }

        95% {
            box-shadow: 0 0 20px 10px rgba(255, 0, 224, 0.15);
        }

        97.5% {
            box-shadow: 0 0 20px 10px rgba(255, 0, 192, 0.15);
        }

        100% {
            box-shadow: 0 0 20px 10px rgba(255, 0, 0, 0.15);
        }
    }

    .report-section {
        display: none;
    }

    .report-section.active {
        display: block;
    }

    .floating-step-pill {
        cursor: pointer;
    }
</style>

<!-- Stages Progress Bar -->
<div class="progress-bar w-1/2  mx-auto my-6">
    <div class="flex items-center justify-between flex-wrap">
        <!-- Step 1: Idea (active) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-primary"></div>
            <span class="text-primary text-xs mt-2 group-hover:text-primary">Idea</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 2: Business (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Business</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 3: Financial (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Financial</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 4: Funding (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Funding</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 5: Legal (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Legal</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 6: Team (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Team</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 7: Marketing (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Marketing</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 8: Pitch Deck (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Pitch Deck</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 9: Business Plan (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Business Plan</span>
        </div>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 10: Valuation (inactive) -->
        <div class="group flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-muted group-hover:bg-primary"></div>
            <span class="text-muted-foreground text-xs mt-2 group-hover:text-primary">Valuation</span>
        </div>
    </div>
</div>



<main class="flex flex-col mx-auto items-center justify-center">

    <!-- Back Button -->
    <div class="px-6 py-4">
        <a href="/new-idea"
            class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors">
            {{{ icon 'arrow-left' class='w-4 h-4' }}}
            <span>Back to New Idea</span>
        </a>
    </div>

    <!-- Business Plan Dashboard -->
    <div class="business-plan-dashboard w-full ">
        <!-- Report Header -->
        <div class="px-6 py-8">
            <div class="flex flex-col items-center text-center">
                <!-- Title Section -->
                <div class="text-center">
                    <h1 class="text-4xl font-bold text-foreground mb-2">Idea Model Report</h1>
                    <p class="text-muted-foreground text-lg">Comprehensive idea development and validation overview</p>
                    <div class="mt-4 h-1 bg-primary w-24 mx-auto mb-2"></div>
                </div>

                <!-- Rating Section -->
                <div class="flex flex-row items-center gap-6 min-w-0 mb-4">
                    <div class="flex items-center gap-1 mb-1">
                        <span id="rating-stars" class="text-yellow-400 text-lg">★★★★★</span>
                        <span id="rating-value" class="text-sm text-muted-foreground">5.0</span>
                    </div>
                    <span id="vote-count" class="text-xs text-muted-foreground">0 votes</span>
                </div>
            </div>
        </div>

    </div>



    <!-- Report Content -->
    <div class="px-6 pb-12 relative" id="masonry-container">

        <!-- Executive Summary Section -->
        <div id="executive-summary-section"
            class="bg-card shadow-lg rounded-lg p-6 w-[600px] mb-4 rainbow-shadow report-section active">
            <div class="flex items-center justify-between ">
                <h2 class="text-2xl font-bold text-foreground flex items-center gap-2">
                    <svg class="lucide lucide-file-text w-6 h-6 text-primary" xmlns="http://www.w3.org/2000/svg"
                        width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                        <polyline points="14,2 14,8 20,8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <line x1="10" y1="9" x2="8" y2="9" />
                    </svg>
                    <span contenteditable="true" class="editable-title">Executive Summary</span>
                </h2>
                <div class="flex">
                    <button
                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">
                        {{{ icon 'edit' class='w-4 h-4' }}}
                        <span class="hidden group-hover:inline">Edit</span>
                    </button>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mt-4">
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'file-text' class='w-4 h-4' }}}
                    <span>Words: 245</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'tag' class='w-4 h-4' }}}
                    <span>Tags: 5</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'check-circle' class='w-4 h-4' }}}
                    <span>Elements: 4/4</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'credit-card' class='w-4 h-4' }}}
                    <span>Credit: 2</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'calendar' class='w-4 h-4' }}}
                    <span>Updated: 2024-01-15</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'clock' class='w-4 h-4' }}}
                    <span>Status: Complete</span>
                </div>
            </div>
            <div class="flex items-center gap-2 mt-4">
                <div class="flex-1 bg-muted rounded-full h-2">
                    <div class="bg-primary h-2 rounded-full" style="width: 100%"></div>
                </div>
                <span class="text-xs text-muted-foreground">100% Complete</span>
            </div>
            <div class="space-y-6 content expandable" contenteditable="false">
                <div>
                    <h3 class="text-xl font-bold text-foreground mb-3" id="display-title">Loading...</h3>
                    <div class="flex items-center gap-2 ">
                        <span id="display-category"
                            class="inline-flex items-center gap-1 px-3 py-1 bg-muted text-muted-foreground border border-border text-sm rounded-full">
                            <svg class="lucide lucide-tag w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16"
                                height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path
                                    d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z">
                                </path>
                                <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
                            </svg>
                            Loading category...
                        </span>
                    </div>
                    <p id="display-description" class="text-base text-muted-foreground leading-relaxed ">Loading
                        description...</p>
                    <div class="flex flex-wrap gap-2" id="display-tags">
                        <!-- Tags will be populated here -->
                    </div>
                </div>
            </div>
            <!-- Toolbar -->
            <div class="px-3 flex gap-2 items-center mt-4">
                <div class="flex gap-2 items-center flex-shrink-0">
                    <!-- Improve with AI -->
                    <button type="button" aria-label="Improve with AI" title="Improve with AI"
                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">
                        <svg class="lucide lucide-lightbulb w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16"
                            height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5">
                            </path>
                            <path d="M9 18h6"></path>
                            <path d="M10 22h4"></path>
                        </svg>
                        <span class="hidden group-hover:inline transition-all duration-200">Improve with AI</span>
                    </button>
                    <!-- Add tags with AI -->
                    <button type="button" aria-label="Add tags with AI" title="Add tags with AI"
                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">
                        <svg class="lucide lucide-tag w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z">
                            </path>
                            <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
                        </svg>
                        <span class="hidden group-hover:inline transition-all duration-200">Add Tags with AI</span>
                    </button>
                    <!-- Generate Content with AI -->
                    <button type="button" aria-label="Generate Content with AI" title="Generate Content with AI"
                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">
                        <svg class="lucide lucide-wand-sparkles w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16"
                            height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72">
                            </path>
                            <path d="m14 7 3 3"></path>
                            <path d="M5 6v4"></path>
                            <path d="M19 14v4"></path>
                            <path d="M10 2v2"></path>
                            <path d="M7 8H3"></path>
                            <path d="M21 16h-4"></path>
                            <path d="M11 3H9"></path>
                        </svg>
                        <span class="hidden group-hover:inline transition-all duration-200">Generate Content with
                            AI</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Problem Section -->
        <div id="problem-analysis-section" class="bg-card rounded-lg p-6 w-[600px] mb-4 report-section">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-foreground flex items-center gap-2">
                    <svg class="lucide lucide-alert-triangle w-6 h-6 text-destructive"
                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                    <span contenteditable="true" class="editable-title">2. Problem Analysis</span>
                </h2>
                <div class="flex">
                    <button
                        class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">
                        {{{ icon 'edit' class='w-4 h-4' }}}
                        <span class="hidden group-hover:inline">Edit</span>
                    </button>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mt-4">
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'file-text' class='w-4 h-4' }}}
                    <span>Words: 320</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'list' class='w-4 h-4' }}}
                    <span>Subsections: 4/4</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'users' class='w-4 h-4' }}}
                    <span>Audience: Defined</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'credit-card' class='w-4 h-4' }}}
                    <span>Credit: 2</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'calendar' class='w-4 h-4' }}}
                    <span>Updated: 2024-01-14</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/30 rounded px-2 py-1">
                    {{{ icon 'clock' class='w-4 h-4' }}}
                    <span>Status: In Progress</span>
                </div>
            </div>
            <div class="flex items-center gap-2 mt-4">
                <div class="flex-1 bg-muted rounded-full h-2">
                    <div class="bg-primary h-2 rounded-full" style="width: 85%"></div>
                </div>
                <span class="text-xs text-muted-foreground">85% Complete</span>
            </div>
            <p class="text-base text-muted-foreground leading-relaxed mb-6">This section analyzes the core problem that
                the idea aims to solve, including the problem statement, target audience, key assumptions, and existing
                alternatives in the market.</p>
            <div class="space-y-6 content expandable" contenteditable="false">
                <div class="bg-muted/50 rounded-lg p-4 border border-border/50 rainbow-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-lg font-semibold text-foreground">Problem Statement</h3>
                        <button
                            class="bg-muted hover:bg-muted/90 text-muted-foreground px-3 py-1 rounded-full text-sm">Save</button>
                    </div>
                    <p class="text-base text-muted-foreground leading-relaxed">Small businesses struggle with
                        inefficient project management tools that don't scale with their growth, leading to missed
                        deadlines, poor team coordination, and increased operational costs.</p>
                    <div class="flex gap-2 items-center mt-4">
                        <button type="button" aria-label="Improve with AI" title="Improve with AI"
                            class="rounded-full border border-border inline-flex items-center justify-center gap-1 cursor-pointer text-xs text-muted-foreground hover:bg-primary-100 hover:text-primary-900 px-2 py-1 shrink-0 transition-all duration-300 group">
                            <svg class="lucide lucide-lightbulb w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="16"
                                height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path
                                    d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5">
                                </path>
                                <path d="M9 18h6"></path>
                                <path d="M10 22h4"></path>
                            </svg>
                            <span class="hidden group-hover:inline transition-all duration-200">Improve with AI</span>
                        </button>
                    </div>
                </div>
