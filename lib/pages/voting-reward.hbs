                                    font: {
                                        size: 12,
                                        weight: '500'
                                    },
                                    padding: 15,
                                    precision: 0
                                },
                                border: {
                                    display: false
                                }
                            }
                        },
                        interaction: {
                            mode: 'nearest',
                            axis: 'x',
                            intersect: false
                        }
                    }
                });
            });
        </script>
