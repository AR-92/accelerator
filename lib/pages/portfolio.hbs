<div class="p-20">
    <div class="grid gap-1  mb-12">
        <h1 class="font-heading text-3xl font-semibold text-foreground">
            Ideas Portfolio
        </h1>
        <p class="text-lg text-muted-foreground">
            Manage your ideas here
        </p>
    </div>


    <!-- Ideas Grid Section -->
    <div id="main-main-content">
        <!-- Ideas Grid Section -->
        <div class="flex flex-col">
            <div class="flex flex-col w-full px-4 mx-auto ">
                <div class="flex flex-col pb-[100px] max-md:pb-[64px] ">


                    <div class="my-6">
                        <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 column-gap-6 relative">
                            {{#each ideas}}
                            <a class="flex relative flex-col gap-1 items-start p-4 mb-4 cursor-pointer group-item-btns overflow-hidden border rounded-md border-border bg-card hover:shadow-lg dark:hover:shadow-primary focus:outline-none"
                                href="/idea-detail?ideaId={{id}}" draggable="false" data-id="{{id}}" data-status="{{status}}"
                                data-type="{{category}}" data-favorite="{{is_favorite}}">
                                <button onclick="redirectToPopulate('{{id}}'); return false;"
                                    class="absolute top-2 right-2 text-muted-foreground hover:text-primary cursor-pointer">

                                    {{{icon 'copy' class='w-4 h-4'}}}

                                </button>
                                <div class="w-full">
                                    <span
                                        class="text-ellipsis break-words line-clamp-2 text-sm text-foreground font-medium">{{title}}</span>
                                </div>

                                <div class="flex items-center gap-1.5 mb-1">
                                    <div class="text-muted-foreground text-[13px] leading-[18px] truncate">
                                    </div>
                                </div>

                                <div class="text-xs text-foreground dark:text-muted-foreground mb-2 line-clamp-2">
                                    {{description}}</div>

                                <div class="flex flex-wrap gap-1 mb-2">
                                    {{#each tags}}
                                    <span
                                        class="px-2 py-0.5 bg-secondary/10 text-foreground text-xs rounded-md border border-secondary/40">{{this}}</span>
                                    {{/each}}
                                </div>

                                <div
                                    class="flex items-center justify-between w-full mt-auto pt-2 border-t border-border">
                                    <div class="flex items-center">

                                        <div class="flex">

                                            <svg class="lucide lucide-star w-3.5 h-3.5 {{#if (gt rating 0)}}fill-yellow-400 text-yellow-400{{else}}text-muted-foreground{{/if}}"
                                                xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="currentColor" stroke="currentColor"
                                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z">
                                                </path>
                                            </svg>


                                            <svg class="lucide lucide-star w-3.5 h-3.5 {{#if (gt rating 1)}}fill-yellow-400 text-yellow-400{{else}}text-muted-foreground{{/if}}"
                                                xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z">
                                                </path>
                                            </svg>


                                            <svg class="lucide lucide-star w-3.5 h-3.5 {{#if (gt rating 2)}}fill-yellow-400 text-yellow-400{{else}}text-muted-foreground{{/if}}"
                                                xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z">
                                                </path>
                                            </svg>


                                            <svg class="lucide lucide-star w-3.5 h-3.5 {{#if (gt rating 3)}}fill-yellow-400 text-yellow-400{{else}}text-muted-foreground{{/if}}"
                                                xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z">
                                                </path>
                                            </svg>


                                            <svg class="lucide lucide-star w-3.5 h-3.5 {{#if (gt rating 4)}}fill-yellow-400 text-yellow-400{{else}}text-muted-foreground{{/if}}"
                                                xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z">
                                                </path>
                                            </svg>

                                        </div>


                                    </div>

                                    <div class="flex space-x-2">
                                        <button
                                            class="text-muted-foreground hover:text-orange-500 rounded-full hover:bg-primary-100 hover:text-primary-900 unpublish-btn">

                                            <svg class="lucide lucide-eye-off w-4 h-4"
                                                xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49">
                                                </path>
                                                <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
                                                <path
                                                    d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143">
                                                </path>
                                                <path d="m2 2 20 20"></path>
                                            </svg>

                                        </button>

                                        <button
                                            class="text-muted-foreground rounded-full hover:text-green-500 {{#if is_favorite}}fill-red-500 text-red-500{{else}}{{/if}}">

                                            <svg class="lucide lucide-heart w-4 h-4" xmlns="http://www.w3.org/2000/svg"
                                                width="16" height="16" viewBox="0 0 24 24" {{#if
                                                is_favorite}}fill="currentColor" stroke="currentColor"
                                                {{else}}fill="none" stroke="currentColor" {{/if}} stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5">
                                                </path>
                                            </svg>

                                        </button>
                                        <button
                                            class="text-muted-foreground hover:text-red-500 rounded-full hover:bg-primary-100 hover:text-primary-900 archive-btn">

                                            <svg class="lucide lucide-archive w-4 h-4"
                                                xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="20" height="5" x="2" y="3" rx="1"></rect>
                                                <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path>
                                                <path d="M10 12h4"></path>
                                            </svg>

                                        </button>
                                    </div>
                                </div>
                            </a>
                            {{/each}}

                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>

</div>