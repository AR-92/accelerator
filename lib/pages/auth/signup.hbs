<div class="w-full min-h-screen flex flex-col lg:flex-row items-center justify-center lg:gap-8 grid-bg">
  <div class="flex items-center">
    <div class="flex flex-col items-center justify-center h-full gap-6 w-[350px] mx-auto">
      <div class="grid gap-2 text-center">
        <h1 class="text-3xl font-bold text-foreground text-glow text-center">Sign Up</h1>
        <p class="text-balance text-muted-foreground">
          Create your account to get started
        </p>
      </div>

      <form hx-post="/auth/signup" hx-target="#auth-response" hx-swap="innerHTML"
        hx-on:htmx:before-request="showSpinner()" hx-on:htmx:after-request="hideSpinner()"
        class="grid gap-4 text-center">
        <input type="hidden" name="_csrf" value="{{csrf}}" />

        <div class="grid gap-2 text-left">
          <label
            class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
            for="firstName">
            First Name
          </label>
          <input type="text" name="firstName"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
            id="firstName" placeholder="First Name" required="" />
        </div>

        <div class="grid gap-2 text-left">
          <label
            class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
            for="lastName">
            Last Name
          </label>
          <input type="text" name="lastName"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
            id="lastName" placeholder="Last Name" required="" />
        </div>

        <div class="grid gap-2 text-left">
          <label
            class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
            for="email">
            Email
          </label>
          <input type="email" name="email"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
            id="email" placeholder="m@example.com" required="" />
        </div>

        <div class="grid gap-2 text-left">
          <label
            class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
            for="password">
            Password
          </label>
          <input type="password" name="password"
            class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm text-foreground shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
            id="password" placeholder="Enter your password" required="" />
        </div>

        <div class="flex items-center space-x-2">
          <input class="h-4 w-4 rounded border border-input/80" id="terms" name="terms" type="checkbox" required />
          <label
            class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
            for="terms">
            I agree to the
            <a href="/terms" class="text-primary hover:text-primary-600 focus:outline-none monotone-logo">Terms and Conditions</a>
          </label>
        </div>

        <div class="w-full">
          <button type="submit" id="signup-button" class="shiny-cta text-center bg-card"
            style="padding: 0.5rem 1rem; width: 200px; margin: 0 auto;">
            <span>
              <span id="signup-text">Sign Up</span>
            </span>
          </button>
        </div>

      </form>

      <div class="mt-4 text-center text-sm text-muted-foreground">
        Already have an account?
        <a class="underline text-muted-foreground hover:text-foreground focus:outline-none monotone-logo"
          href="/auth/login">Sign in</a>
      </div>
    </div>
  </div>
  <div class="">
    <div class="relative w-[600px] h-[400px] overflow-hidden place-self-center"
      style="background-image: url('/images/accelerator_logo.svg'); background-size: contain; background-position: center; background-repeat: no-repeat;">
    </div>
  </div>

</div>
</div>

<div id="auth-response"></div>