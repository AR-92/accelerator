<div class="min-h-screen flex items-center justify-center p-8">
  <div class="w-full max-w-5xl">
    <!-- Header Section -->
    <div class="bg-card rounded-2xl shadow-xl overflow-hidden mb-8">
        <div class="bg-gradient-to-r from-primary to-primary/80 px-8 py-6 text-primary-foreground">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold mb-2">Choose Your Plan</h1>
                    <p class="text-primary-foreground/80">Select the perfect plan to accelerate your startup journey</p>
                </div>
                <div class="text-right">
                    <div class="text-sm opacity-90">Current Balance</div>
                    <div class="text-2xl font-semibold">{{currentBalance}} credits</div>
                </div>
            </div>
        </div>

        <div class="px-8 py-6 bg-muted/50 border-b border-border">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-foreground">Package Selection</h2>
                        <p class="text-muted-foreground">Choose the plan that best fits your needs</p>
                    </div>
                </div>

                <div class="flex space-x-3">
                    <a href="/settings" class="bg-background border border-input text-foreground px-4 py-2 rounded-lg hover:bg-accent hover:text-accent-foreground transition-colors flex items-center space-x-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span>Settings</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Package Plans -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {{#each packages}}
        <div class="bg-card rounded-2xl shadow-xl overflow-hidden border border-border">
            <div class="p-6">
                <div class="text-center mb-6">
                    <h3 class="text-xl font-semibold text-foreground mb-2">{{name}} Plan</h3>
                    <div class="text-3xl font-bold text-foreground mb-1">${{price_monthly}}</div>
                    <div class="text-sm text-muted-foreground">per month</div>
                    <div class="text-sm text-muted-foreground mt-2">{{credits_monthly}} credits included</div>
                </div>

                <div class="space-y-3 mb-6">
                    <div class="flex items-center space-x-3">
                        <div class="w-5 h-5 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-3 h-3 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <span class="text-sm text-foreground">Instant delivery</span>
                    </div>

                    <div class="flex items-center space-x-3">
                        <div class="w-5 h-5 bg-blue-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-3 h-3 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <span class="text-sm text-foreground">No expiration</span>
                    </div>

                    <div class="flex items-center space-x-3">
                        <div class="w-5 h-5 bg-amber-500/10 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-3 h-3 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                        </div>
                        <span class="text-sm text-foreground">AI-powered features</span>
                    </div>
                </div>

                <form method="POST" action="/onboarding/package">
                    <input type="hidden" name="_csrf" value="{{csrf}}" />
                    <input type="hidden" name="package_type" value="{{type}}" />
                    <button type="submit" class="w-full bg-primary text-primary-foreground px-4 py-3 rounded-lg hover:bg-primary/90 transition-colors font-medium">
                        Choose {{name}} Plan
                    </button>
                </form>
            </div>
        </div>
        {{/each}}
    </div>

    <!-- Footer -->
    <div class="mt-8 text-center">
        <p class="text-muted-foreground mb-4">Questions about our plans? <a href="/contact" class="text-primary hover:text-primary/80 font-medium transition-colors">Contact our team</a></p>
    </div>
  </div>
</div>