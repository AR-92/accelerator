<div class="space-y-8">
  <div class="card">
    <div class="flex justify-between items-center">
      <h1 class="card-title">Dashboard</h1>

    </div>
    <p class="text-neutral">Welcome to your Accelerator dashboard! Here's an
      overview of your startup journey.</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="card">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          {{{icon "lightbulb" class="h-8 w-8 text-primary"}}}
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-neutral">Active Projects</p>
          <p class="text-2xl font-semibold text-base-content">3</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          {{{icon "trending-up" class="h-8 w-8 text-success"}}}
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-neutral">Ideas Generated</p>
          <p class="text-2xl font-semibold text-base-content">12</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          {{{icon "dollar-sign" class="h-8 w-8 text-warning"}}}
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-neutral">Funding Raised</p>
          <p class="text-2xl font-semibold text-base-content">$25K</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          {{{icon "users" class="h-8 w-8 text-accent"}}}
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-neutral">Team Members</p>
          <p class="text-2xl font-semibold text-base-content">5</p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <div class="card">
      <h3 class="card-title">Recent Projects</h3>
      <div class="space-y-3">
        <div class="flex items-center justify-between p-3 bg-base-200 rounded-md">
          <div>
            <p class="text-sm font-medium text-base-content">AI-Powered Task
              Manager</p>
            <p class="text-xs text-neutral">Last updated 2 days ago</p>
          </div>
          <span class="badge badge-success">
            Active
          </span>
        </div>
        <div class="flex items-center justify-between p-3 bg-base-200 rounded-md">
          <div>
            <p class="text-sm font-medium text-base-content">Sustainable Fashion
              Marketplace</p>
            <p class="text-xs text-neutral">Last updated 1 week ago</p>
          </div>
          <span class="badge badge-warning">
            Planning
          </span>
        </div>
      </div>
    </div>

    <div class="card">
      <h3 class="card-title">Quick Actions</h3>
      <div class="space-y-3">
        <button class="btn btn-primary w-full">
          Generate New Idea
        </button>
        <button class="btn btn-success w-full">
          Create Business Plan
        </button>
        <button class="btn btn-accent w-full">
          Financial Modeling
        </button>
      </div>
    </div>
  </div>
</div>