{{> progress-bar activeStep=activeStep}}

{{> model-header title="Idea Model Report" description="Comprehensive idea development and validation overview"
ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes"}}

<!-- Mixed Progress Bar and Pills Navigation -->
<div class="flex justify-center mb-6">
    <div class="relative w-full max-w-md mx-auto">
        <!-- Progress Bar Background -->
        <div class="absolute top-1/2 left-0 right-0 h-1 bg-muted rounded-full transform -translate-y-1/2"></div>
        <!-- Progress Bar Fill -->
        <div class="absolute top-1/2 left-0 h-1 bg-primary rounded-full transform -translate-y-1/2 transition-all duration-300"
            style="width: 25%"></div>

        <!-- Pills Overlay -->
        <div class="relative flex justify-between items-center">
            <span class="step-pill px-3 py-1 bg-primary text-primary-foreground text-xs rounded-full shadow-md z-10"
                data-section="overview">1. Overview</span>
            <span class="step-pill px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="details">2.</span>
            <span class="step-pill px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="analysis">3.</span>
            <span class="step-pill px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="validation">4.</span>
        </div>
    </div>
</div>

<main class="flex flex-col mx-auto items-center justify-center">
    {{> report-section}}
</main>
<div class=" h-[300px]"></div>

<script>
    // Pill text variations for idea model sections
    const pillFullTexts = [
        '1. Overview',
        '2. Details',
        '3. Analysis',
        '4. Validation'
    ];
    const pillNumbers = ['1.', '2.', '3.', '4.'];

    function addHoverListeners() {
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            pill.addEventListener('mouseenter', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillFullTexts[index];
                }
            });
            pill.addEventListener('mouseleave', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillNumbers[index];
                }
            });
        });
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
        addHoverListeners();
    });
</script>