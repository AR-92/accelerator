<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    // Wait for marked to load
    window.waitForMarked = function(callback) {
        if (typeof marked !== 'undefined') {
            callback();
        } else {
            setTimeout(() => window.waitForMarked(callback), 100);
        }
    }

    window.populateIdea = {{{populateIdeaJson}}};
    console.log('populateIdea set for idea model:', window.populateIdea);
</script>

<script>
    // Pill text variations for idea model sections
    const pillFullTexts = [
        '1. Executive Summary',
        '2. Problem Analysis',
        '3. Solution Overview',
        '4. Market Analysis',
        '5. Product Concept',
        '6. Go-to-Market Strategy',
        '7. Brand Strategy',
        '8. Intellectual Property Protection'
    ];
    const pillNumbers = ['1.', '2.', '3.', '4.', '5.', '6.', '7.', '8.'];

    function addHoverListeners() {
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            pill.addEventListener('mouseenter', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillFullTexts[index];
                }
            });
            pill.addEventListener('mouseleave', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillNumbers[index];
                }
            });
        });
    }

    // Function to show section and update UI
    function showSection(sectionIndex) {
        // Hide all sections
        document.querySelectorAll('.section').forEach(sec => {
            sec.style.display = 'none';
        });
        // Show target section
        const sectionIds = [
            'executive-summary',
            'problem-analysis',
            'solution-overview',
            'market-analysis',
            'product-concept',
            'go-to-market-strategy',
            'brand-strategy',
            'intellectual-property-protection'
        ];
        const targetSection = document.getElementById(sectionIds[sectionIndex]);
        if (targetSection) {
            targetSection.style.display = 'block';
        }

        // Update progress bar
        const progressBar = document.getElementById('progress-fill');
        const width = ((sectionIndex + 1) / 8) * 100 + '%';
        progressBar.style.width = width;

        // Update pills
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            pill.classList.remove('bg-primary', 'text-primary-foreground');
            pill.classList.add('bg-muted', 'text-muted-foreground');
            if (index === sectionIndex) {
                pill.classList.remove('bg-muted', 'text-muted-foreground');
                pill.classList.add('bg-primary', 'text-primary-foreground');
                pill.textContent = pillFullTexts[index];
            } else {
                pill.textContent = pillNumbers[index];
            }
        });
    }

    // Add click listeners to pills
    document.querySelectorAll('.step-pill').forEach((pill, index) => {
        pill.addEventListener('click', () => {
            showSection(index);
        });
    });

    // Add click listeners to move next buttons
    document.querySelectorAll('.move-next-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const currentSection = btn.closest('.section');
            const sectionIds = ['executive-summary', 'problem-analysis', 'solution-overview', 'market-analysis', 'product-concept', 'go-to-market-strategy', 'brand-strategy', 'intellectual-property-protection'];
            const currentIndex = sectionIds.indexOf(currentSection.id);
            if (currentIndex < 7) {
                showSection(currentIndex + 1);
            } else {
                // Last section
                alert('Idea model completed!');
            }
        });
    });

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
    const activeStep = 0; // Default to first section (0-based index)
    showSection(activeStep);

    addHoverListeners();
    });
</script>
</script>
</script>