{{> progress-bar activeStep=activeStep ideaId=ideaId}}

{{> model-header title=pageTitle description="Comprehensive idea development and validation overview"
 ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes" category=ideaCategory tags=ideaTags}}

<!-- Mixed Progress Bar and Pills Navigation -->
<div class="flex justify-center mb-6">
    <div class="relative w-full max-w-[900px]">
        <!-- Progress Bar Background -->
        <div class="absolute top-1/2 left-0 right-0 h-1 bg-muted rounded-full transform -translate-y-1/2"></div>
        <!-- Progress Bar Fill -->
        <div id="progress-fill"
            class="absolute top-1/2 left-0 h-1 bg-primary rounded-full transform -translate-y-1/2 transition-all duration-300"
            style="width: 25%"></div>

        <!-- Pills Overlay -->
        <div class="relative flex justify-between items-center">
            <span
                class="step-pill cursor-pointer px-3 py-1 bg-primary text-primary-foreground text-xs rounded-full shadow-md z-10"
                data-section="executive-summary">0. Executive Summary</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="problem-validation">1.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="solution-development">2.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="customer-model">3.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="branding">4.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="ip-protection">5.</span>
        </div>
    </div>
</div>

<main class="flex flex-col mx-auto items-center justify-center">
    <div class="sections-container">
         <!-- Executive Summary Section -->
         <div id="executive-summary" class="section mb-6">
             <h2 class="text-xl font-semibold mb-4 text-foreground">Executive Summary</h2>
             <p class="text-muted-foreground mb-6">Overview of your startup idea</p>
             <div class="relative">
                 <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">0</div>
                     <div class="flex-1">
                         {{> question-block id="executive-summary-q1" step="0" question="Provide an executive summary of your startup idea." placeholder="This section creates your executive summary. Write a concise overview of your idea, including the problem, solution, market opportunity, and unique value proposition. AI can help craft compelling summaries. Use this section for idea overview. Chat with AI to refine your executive summary or get writing assistance." description=executiveSummaryText form="false"}}
                     </div>
                 </div>
                 <div class="flex items-start gap-4">
                     <div class="w-8 h-8  rounded-full flex items-center justify-center text-sm font-bold relative z-10">    <svg class="lucide lucide-check-circle w-8 h-8 text-success" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
         <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
         <polyline points="22,4 12,14.01 9,11.01"></polyline>
     </svg></div>
                     <div class="flex-1">
                         {{> move-next-block message="You have successfully completed this section of the idea model." buttonText="Move to Next Section"}}
                     </div>
                 </div>
             </div>
         </div>



        <!-- Problem Analysis Section -->


        <div id="problem-validation" class="section mb-6" style="display: none;">
