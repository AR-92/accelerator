                  </div>
                </div>
                <div class="flex items-start gap-4 mb-6">
                  <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">6</div>
                  <div class="flex-1">
                          {{> question-block id="customer-model-q6" step="12" question="What is your unfair advantage?" placeholder="This section defines your unfair advantage. Identify unique assets, partnerships, or positioning hard to replicate. AI can help identify competitive moats. Use this section for sustainable advantage. Chat with AI to discover advantages or learn moat building."}}
                  </div>
                </div>
                <div class="flex items-start gap-4 mb-6">
                  <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">7</div>
                  <div class="flex-1">
