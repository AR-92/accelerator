                    <div class="flex-1">
                        {{> question-block id="financial-risks-q1" step="14" question="What are the financial risks?"}}
                    </div>
                </div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                    <div class="flex-1">
                        {{> question-block id="financial-risks-q2" step="15" question="How will you mitigate these risks?"}}
                    </div>
                </div>
