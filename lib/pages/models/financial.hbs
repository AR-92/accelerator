                 <div class="flex items-start gap-4 mb-6">
                     <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                     <div class="flex-1">
                          {{> question-block id="financial-statements-q1" step="7" question="What formatting do you want for financial statements?" placeholder="This section generates your financial statements. Choose monthly, quarterly, yearly, or 3-5 year projections. AI will compute based on your inputs. Use this section for financial reporting. Chat with AI to understand financial statements or get formatting recommendations."}}
