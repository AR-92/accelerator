            <p class="text-muted-foreground mb-6">Determine when you'll break even.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                    <div class="flex-1">
                        {{> question-block id="break-even-analysis-q1" step="8" question="What is your break-even point?"}}
