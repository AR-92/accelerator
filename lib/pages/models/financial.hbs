{{> progress-bar activeStep=activeStep}}

{{> model-header title="Financial Model Report" description="Comprehensive financial planning and analysis overview"
ratingStars="★★★★★" ratingValue="5.0" voteCount="0 votes"}}

<!-- Mixed Progress Bar and Pills Navigation -->
<div class="flex justify-center mb-6">
    <div class="relative w-full max-w-[900px]">
        <!-- Progress Bar Background -->
        <div class="absolute top-1/2 left-0 right-0 h-1 bg-muted rounded-full transform -translate-y-1/2"></div>
        <!-- Progress Bar Fill -->
        <div id="progress-fill"
            class="absolute top-1/2 left-0 h-1 bg-primary rounded-full transform -translate-y-1/2 transition-all duration-300"
            style="width: 25%"></div>

        <!-- Pills Overlay -->
        <div class="relative flex justify-between items-center">
            <span
                class="step-pill cursor-pointer px-3 py-1 bg-primary text-primary-foreground text-xs rounded-full shadow-md z-10"
                data-section="financial-overview">Financial Overview</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="income-statement">2.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="balance-sheet">3.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="cash-flow">4.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="break-even-analysis">5.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="funding-requirements">6.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="financial-ratios">7.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10"
                data-section="financial-risks">8.</span>
        </div>
    </div>
</div>

<main class="flex flex-col mx-auto items-center justify-center">
    <div class="sections-container">
        <!-- Financial Overview Section -->
        <div id="financial-overview" class="section mb-6">
            <h2 class="text-xl font-semibold mb-4">Financial Overview</h2>
            <p class="text-muted-foreground mb-6">Provide a summary of your financial situation.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                    <div class="flex-1">
                        {{> question-block id="financial-overview-q1" step="1" question="What is your current financial status?"}}
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the financial model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Income Statement Section -->
        <div id="income-statement" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4">Income Statement</h2>
            <p class="text-muted-foreground mb-6">Detail your revenues and expenses.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                    <div class="flex-1">
                        {{> question-block id="income-statement-q1" step="2" question="What are your projected revenues?"}}
                    </div>
                </div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                    <div class="flex-1">
                        {{> question-block id="income-statement-q2" step="3" question="What are your main expenses?"}}
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the financial model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Balance Sheet Section -->
        <div id="balance-sheet" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4">Balance Sheet</h2>
            <p class="text-muted-foreground mb-6">Outline your assets, liabilities, and equity.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                    <div class="flex-1">
                        {{> question-block id="balance-sheet-q1" step="4" question="What are your assets?"}}
                    </div>
                </div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
                    <div class="flex-1">
                        {{> question-block id="balance-sheet-q2" step="5" question="What are your liabilities?"}}
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
                    <div class="flex-1">
                        {{> move-next-block message="You have successfully completed this section of the financial model." buttonText="Move to Next Section"}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Cash Flow Section -->
        <div id="cash-flow" class="section mb-6" style="display: none;">
            <h2 class="text-xl font-semibold mb-4">Cash Flow</h2>
            <p class="text-muted-foreground mb-6">Track your cash inflows and outflows.</p>
            <div class="relative">
                <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
                <div class="flex items-start gap-4 mb-6">
                    <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
                    <div class="flex-1">
