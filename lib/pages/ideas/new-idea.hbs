<div class="flex h-[calc(100vh-4rem)]">
    {{> sidebar projects=projects}}
    <main class="flex flex-col items-center p-6 bg-background  overflow-y-auto">
        <div class="w-full mt-[50px]">
            {{>idea-creation}}

            <!-- Ideas Grid Section -->
            <div class="mt-8 mx-20">
                    <div class="columns-1 sm:columns-1 md:columns-2 lg:columns-3 column-gap-6 relative">
                        {{#each ideas}}
                        {{> idea-card .}}
                        {{/each}}
                    </div>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>