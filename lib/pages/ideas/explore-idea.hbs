<div class="p-20">
    <div class="grid gap-1  mb-12">
        <h1 class="font-heading text-3xl font-semibold text-foreground">
            Explore Ideas
        </h1>
        <p class="text-lg text-muted-foreground">
            Explore other people ideas here
        </p>
    </div>


    <!-- Ideas Grid Section -->
    <div id="main-main-content">
        <!-- Ideas Grid Section -->
        <div class="flex flex-col">
            <div class="flex flex-col w-full px-4 mx-auto ">
                <div class="flex flex-col pb-[100px] max-md:pb-[64px] ">


                    <div class="my-6">
                        <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 column-gap-6 relative">
                             {{#each ideas}}
                              {{> idea-card .}}
                             {{/each}}
                    </div>


                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
// Voting functionality
document.addEventListener('DOMContentLoaded', function() {
    // Handle star rating clicks
    document.querySelectorAll('.star-btn').forEach(btn => {
        btn.addEventListener('click', async function(e) {
            e.preventDefault();
            e.stopPropagation(); // Prevent card click

            const rating = parseInt(this.dataset.rating);
            const ideaId = this.closest('.star-rating').dataset.ideaId;

            try {
                const response = await fetch('/api/votes', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        idea_id: ideaId,
                        rating: rating
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    showToast('Vote submitted successfully!', 'success');
                    // Reload page to show updated ratings
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast(data.error || 'Failed to submit vote', 'error');
                }
            } catch (error) {
                console.error('Voting error:', error);
                showToast('Failed to submit vote', 'error');
            }
        });
    });
});
</script>