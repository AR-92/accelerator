<div class="p-8 max-w-4xl mx-auto">
  <div class="grid gap-1 mb-8">
    <h1 class="font-heading text-3xl font-semibold text-foreground">
      Settings
    </h1>
    <p class="text-lg text-muted-foreground">
      Manage your profile and account settings
    </p>
  </div>

   <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
     <!-- Profile Section -->
     <div class="space-y-6">
       <div class="rounded-md bg-card p-6 text-card-foreground border border-input/80">
         <h2 class="text-xl font-semibold mb-4">Profile Information</h2>

         <form method="POST" action="/settings/profile" enctype="multipart/form-data">
           <!-- Avatar Upload -->
           <div class="mb-4">
             <label class="block text-sm font-medium text-foreground mb-2">Avatar</label>
             <div class="flex items-center gap-4">
               <img src="{{#if profile.avatar_url}}{{profile.avatar_url}}{{else}}/images/avatar.png{{/if}}"
                    class="w-16 h-16 rounded-full object-cover border-2 border-input"
                    id="avatar-preview" alt="Current avatar">
               <div>
                 <input type="file" name="avatar" id="avatar-upload" accept="image/*"
                        class="hidden" onchange="previewAvatar(this)">
                 <label for="avatar-upload"
                        class="px-4 py-2 bg-primary text-primary-foreground rounded-md cursor-pointer hover:bg-primary/90 transition-colors text-sm">
                   Change Avatar
                 </label>
                 <p class="text-xs text-muted-foreground mt-1">Max 5MB, JPG/PNG/WebP</p>
               </div>
             </div>
           </div>

           <!-- Name -->
           <div class="mb-4">
             <label for="name" class="block text-sm font-medium text-foreground mb-2">Name</label>
             <input type="text" id="name" name="name" value="{{profile.name}}"
                    class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="Your full name">
           </div>

           <!-- Role -->
           <div class="mb-4">
             <label for="role" class="block text-sm font-medium text-foreground mb-2">Role</label>
             <input type="text" id="role" name="role" value="{{profile.role}}"
                    class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="e.g. Entrepreneur, Developer, Student">
           </div>

           <!-- Bio -->
           <div class="mb-4">
             <label for="bio" class="block text-sm font-medium text-foreground mb-2">Bio</label>
             <textarea id="bio" name="bio" rows="3"
                       class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                       placeholder="Tell us about yourself">{{profile.preferences.bio}}</textarea>
           </div>

           <!-- Location -->
           <div class="mb-4">
             <label for="location" class="block text-sm font-medium text-foreground mb-2">Location</label>
             <input type="text" id="location" name="location" value="{{profile.preferences.location}}"
                    class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="City, Country">
           </div>

           <!-- Website -->
           <div class="mb-4">
             <label for="website" class="block text-sm font-medium text-foreground mb-2">Website</label>
             <input type="url" id="website" name="website" value="{{profile.preferences.website}}"
                    class="w-full px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="https://yourwebsite.com">
           </div>

           <!-- Social Links -->
           <div class="mb-6">
             <label class="block text-sm font-medium text-foreground mb-2">Social Links</label>
             <div id="social-links-container" class="space-y-3">
               <!-- Predefined platforms -->
               <div class="flex items-center gap-2">
                 <span class="text-sm font-medium w-20">Twitter:</span>
                 <input type="url" id="social-twitter" placeholder="https://twitter.com/username"
                        class="flex-1 px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
               </div>
               <div class="flex items-center gap-2">
                 <span class="text-sm font-medium w-20">LinkedIn:</span>
                 <input type="url" id="social-linkedin" placeholder="https://linkedin.com/in/username"
                        class="flex-1 px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
               </div>
               <div class="flex items-center gap-2">
                 <span class="text-sm font-medium w-20">GitHub:</span>
                 <input type="url" id="social-github" placeholder="https://github.com/username"
                        class="flex-1 px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
               </div>
               <div class="flex items-center gap-2">
                 <span class="text-sm font-medium w-20">Instagram:</span>
                 <input type="url" id="social-instagram" placeholder="https://instagram.com/username"
                        class="flex-1 px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
               </div>
               <div class="flex items-center gap-2">
                 <span class="text-sm font-medium w-20">YouTube:</span>
                 <input type="url" id="social-youtube" placeholder="https://youtube.com/@username"
                        class="flex-1 px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
               </div>
               <!-- Custom links will be added here -->
             </div>
             <button type="button" id="add-custom-link" class="mt-3 px-4 py-2 text-sm text-primary hover:text-primary/80 border border-primary rounded-md hover:bg-primary/5 transition-colors">
               + Add Custom Link
             </button>
             <!-- Hidden textarea to store JSON -->
             <textarea id="social_links" name="social_links" class="hidden"></textarea>
           </div>

           <button type="submit" class="w-full px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
             Save Profile
           </button>
         </form>
       </div>
     </div>

     <!-- Package & Account Section -->
     <div class="space-y-6">
       <div class="rounded-md bg-card p-6 text-card-foreground border border-input/80">
         <h2 class="text-xl font-semibold mb-4">Package & Account</h2>

         <!-- Current Package Info -->
         <div class="mb-6 p-4 bg-muted rounded-md">
           <h3 class="font-medium text-foreground mb-2">Current Package</h3>
           <div class="flex items-center justify-between">
             <div>
               <span class="text-lg font-semibold capitalize">{{profile.package_type}}</span>
               <span class="text-sm text-muted-foreground ml-2">
                 {{#if (eq profile.package_type "free")}}
                   Free Plan
                 {{else}}
                   ${{profile.package_type}}/month
                 {{/if}}
               </span>
             </div>
             <div class="text-right">
               <div class="text-sm text-muted-foreground">Credits</div>
               <div class="text-lg font-semibold">{{profile.credit_balance}}</div>
             </div>
           </div>
           {{#if profile.package_expires}}
           <div class="text-sm text-muted-foreground mt-2">
             Expires: {{formatDate profile.package_expires}}
           </div>
           {{/if}}
         </div>

         <!-- Package Selection -->
         <div class="mb-6">
           <label class="block text-sm font-medium text-foreground mb-3">Change Package</label>
           <form method="POST" action="/settings/package">
             <div class="space-y-3">
               <div class="flex items-center">
                 <input type="radio" id="free" name="package_type" value="free"
                        {{#if (eq profile.package_type "free")}}checked{{/if}}
                        class="h-4 w-4 text-primary focus:ring-primary border-input">
                 <label for="free" class="ml-3 block text-sm">
                   <span class="font-medium">Free</span> - Vote on ideas, limited features (50 credits)
                 </label>
               </div>
               <div class="flex items-center">
                 <input type="radio" id="student" name="package_type" value="student"
                        {{#if (eq profile.package_type "student")}}checked{{/if}}
                        class="h-4 w-4 text-primary focus:ring-primary border-input">
                 <label for="student" class="ml-3 block text-sm">
                   <span class="font-medium">Student - $9.99/month</span> - Create ideas, models, reports (500 credits)
                 </label>
               </div>
               <div class="flex items-center">
                 <input type="radio" id="enterprise" name="package_type" value="enterprise"
                        {{#if (eq profile.package_type "enterprise")}}checked{{/if}}
                        class="h-4 w-4 text-primary focus:ring-primary border-input">
                 <label for="enterprise" class="ml-3 block text-sm">
                   <span class="font-medium">Enterprise - $29.99/month</span> - Team features, analytics (2000 credits)
                 </label>
               </div>
             </div>
             <button type="submit" class="mt-4 w-full px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors">
               Update Package
             </button>
           </form>
         </div>

         <!-- Credit History -->
         <div>
           <h3 class="font-medium text-foreground mb-3">Recent Credit Activity</h3>
           <div class="text-sm text-muted-foreground">
             Credit history will be displayed here
           </div>
         </div>
       </div>
    </div>
  </div>
</div>

<!-- Social links data for JavaScript -->
<script>
  window.existingSocialLinks = {{#if profile.preferences.social_links}}{{{json profile.preferences.social_links}}}{{else}}{}{{/if}};
</script>

<script>
function previewAvatar(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('avatar-preview').src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
  }
}

// Social links management
let customLinkCount = 0;

function populateSocialLinks() {
  const socialLinksData = window.existingSocialLinks || {};
  if (!socialLinksData || Object.keys(socialLinksData).length === 0) return;

  // Populate predefined fields
  const predefinedFields = ['twitter', 'linkedin', 'github', 'instagram', 'youtube'];
  predefinedFields.forEach(platform => {
    const input = document.getElementById(`social-${platform}`);
    if (input && socialLinksData[platform]) {
      input.value = socialLinksData[platform];
    }
  });

  // Populate custom fields
  Object.keys(socialLinksData).forEach(key => {
    if (!predefinedFields.includes(key)) {
      addCustomLink(key, socialLinksData[key]);
    }
  });
}

function addCustomLink(platform = '', url = '') {
  customLinkCount++;
  const container = document.getElementById('social-links-container');

  const customDiv = document.createElement('div');
  customDiv.className = 'flex items-center gap-2 custom-link';
  customDiv.innerHTML = `
    <input type="text" placeholder="Platform name" value="${platform}"
           class="w-20 px-2 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    <input type="url" placeholder="https://example.com/username" value="${url}"
           class="flex-1 px-3 py-2 border border-input rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
    <button type="button" class="remove-custom-link px-2 py-1 text-red-500 hover:text-red-700 text-sm">×</button>
  `;

  // Add remove functionality
  customDiv.querySelector('.remove-custom-link').addEventListener('click', function() {
    customDiv.remove();
  });

  container.appendChild(customDiv);
}

function serializeSocialLinks() {
  const socialLinks = {};

  // Get predefined fields
  const predefinedFields = ['twitter', 'linkedin', 'github', 'instagram', 'youtube'];
  predefinedFields.forEach(platform => {
    const input = document.getElementById(`social-${platform}`);
    if (input && input.value.trim()) {
      socialLinks[platform] = input.value.trim();
    }
  });

  // Get custom fields
  const customLinks = document.querySelectorAll('.custom-link');
  customLinks.forEach(link => {
    const inputs = link.querySelectorAll('input');
    const platform = inputs[0].value.trim().toLowerCase();
    const url = inputs[1].value.trim();
    if (platform && url) {
      socialLinks[platform] = url;
    }
  });

  return Object.keys(socialLinks).length > 0 ? socialLinks : null;
}

document.addEventListener('DOMContentLoaded', function() {
  populateSocialLinks();

  // Add custom link button
  document.getElementById('add-custom-link').addEventListener('click', function() {
    addCustomLink();
  });

  // Handle form submission
  const profileForm = document.querySelector('form[action="/settings/profile"]');
  if (profileForm) {
    profileForm.addEventListener('submit', function(e) {
      const socialLinks = serializeSocialLinks();
      document.getElementById('social_links').value = socialLinks ? JSON.stringify(socialLinks) : '';
    });
  }
});
</script>