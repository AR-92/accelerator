<!-- Stages Progress Bar -->
<div id="progress-bar" class="progress-bar w-[900px]  mx-auto my-6">
    <div class="flex items-center justify-between flex-wrap">
        <!-- Step 1: Idea -->
        <a href="/models/idea" class="group flex flex-col items-center">
            <div
                class="w-4 h-4 rounded-full {{#if (eq activeStep 'idea')}}bg-primary{{else}}bg-muted group-hover:bg-primary{{/if}}">
            </div>
            <span
                class="{{#if (eq activeStep 'idea')}}text-primary{{else}}text-muted-foreground{{/if}} text-xs mt-2 group-hover:text-primary">Idea</span>
        </a>
        <!-- Connecting line -->
        <div class="flex-1 h-0.5 bg-border mx-2 hidden sm:block -mt-6"></div>
        <!-- Step 2: Business -->
        <a href="/models/business" class="group flex flex-col items-center">
