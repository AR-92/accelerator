{{> progress-steps}}


<!-- Back Button -->
<div id="back-button" class="flex mx-auto  py-4 max-w-[900px] gap-4 text-xs">
    <a href="/new-idea"
        class="inline-flex  items-center gap-2 text-muted-foreground hover:text-foreground transition-colors">
        {{{ icon 'arrow-left' class='w-4 h-4' }}}
        <span>Back</span>
    </a>
    <div class="flex flex-grow justify-center gap-4">
        <a href="/reports/pitch-deck"
            class="inline-flex items-center gap-2 {{#if (eq activeReport 'pitch-deck')}}text-primary{{else}}text-muted-foreground{{/if}} hover:text-foreground transition-colors">
            {{{ icon 'presentation' class='w-4 h-4' }}}
            <span>Pitch Deck</span>
        </a>
        <a href="/reports/business-plan"
            class="inline-flex items-center gap-2 {{#if (eq activeReport 'business-plan')}}text-primary{{else}}text-muted-foreground{{/if}} hover:text-foreground transition-colors">
            {{{ icon 'file-text' class='w-4 h-4' }}}
            <span>Business Plan</span>
        </a>
        <a href="/reports/valuation"
            class="inline-flex items-center gap-2 {{#if (eq activeReport 'valuation')}}text-primary{{else}}text-muted-foreground{{/if}} hover:text-foreground transition-colors">
            {{{ icon 'calculator' class='w-4 h-4' }}}
            <span>Valuation</span>
        </a>
    </div>
</div>