<script>
    window.populateIdea = null;
    console.log('populateIdea set:', window.populateIdea);
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        console.log('DOMContentLoaded fired for create-idea-card');
        // Initialize form elements
        const form = document.getElementById('new-project-form');
        const titleSpan = document.getElementById('title');
        const categorySpan = document.getElementById('category'); // Second contenteditable
        const descriptionTextarea = document.getElementById('assistant-prompt');
        const tagsContainer = document.getElementById('tagslist');
        const submitButton = document.querySelector('button[type="submit"]');

        // Auto-expand textarea
        function autoExpandTextarea() {
            descriptionTextarea.style.height = 'auto';
            descriptionTextarea.style.height = descriptionTextarea.scrollHeight + 'px';
        }

        // Character counter
        function updateCharCounter() {
            const length = descriptionTextarea.value.length;
            const counter = document.getElementById('char-counter');
            counter.textContent = `Characters: ${length} / 2000`;
            if (length < 100 || length > 2000) {
                counter.className = 'text-xs text-red-500/60 mr-2';
            } else {
                counter.className = 'text-xs text-green-500/60 mr-2';
            }
            autoExpandTextarea();
        }

        // Initialize textarea height
        descriptionTextarea.style.minHeight = '2.5rem'; // Match the rows="2" initial height
        descriptionTextarea.style.resize = 'none'; // Prevent manual resizing
        descriptionTextarea.style.overflow = 'hidden'; // Hide scrollbar

        descriptionTextarea.addEventListener('input', updateCharCounter);
        updateCharCounter();

        // Ensure textarea height is adjusted for pre-filled content
        setTimeout(() => {
            autoExpandTextarea();
        }, 0);

        // Toast helper
        function showToastMessage(message, type) {
            if (typeof showToast !== 'undefined') {
                showToast(message, type);
            } else {
                alert(message);
            }
        }

        const addOneTagBtn = document.getElementById('addOneTag');
        if (addOneTagBtn) {
            addOneTagBtn.addEventListener('click', function (e) {
                const tagSpan = document.createElement('span');
                tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full tag-lskjsdb';
                tagSpan.innerHTML = `<span contenteditable="true">Click and type to edit</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
                const addMoreBtn = tagsContainer.querySelector('[class*="bg-success/5"]');
                if (addMoreBtn) {
                    addMoreBtn.after(tagSpan);
                }
                tagSpan.querySelector('button').addEventListener('click', function () {
                    tagSpan.remove();
                    showToastMessage('Tag removed', 'success');
                    updateRemoveAllVisibility();
                });
                showToastMessage('Tag added successfully', 'success');
                updateRemoveAllVisibility();
            });
        }

        const removeAllTagsBtn = document.getElementById('removeAllTags');
        removeAllTagsBtn.style.display = 'none';

        function updateRemoveAllVisibility() {
            const tagCount = document.querySelectorAll('.tag-lskjsdb').length;
            removeAllTagsBtn.style.display = tagCount > 1 ? 'inline-flex' : 'none';
        }

        removeAllTagsBtn.addEventListener('click', function (e) {
            removeAllTags();
        });

        // Tag management functions
        function addTag(tagText) {
            console.log('addTag called with:', tagText);
            if (typeof tagText === 'object') {
                tagText = tagText.name || tagText.value || tagText.toString();
            }
            if (!tagText || !tagText.trim()) {
                console.log('Tag text is empty or invalid, skipping');
                return;
            }
            const tagSpan = document.createElement('span');
            tagSpan.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-secondary/5 text-secondary-foreground border border-secondary/40 text-xs rounded-full tag-lskjsdb';
            tagSpan.innerHTML = `<span contenteditable="true">${tagText}</span> <button class="text-muted-foreground hover:text-destructive p-0">×</button>`;
            const addMoreBtn = tagsContainer.querySelector('[class*="bg-success/5"]');
            console.log('addMoreBtn found:', addMoreBtn);
            if (addMoreBtn) {
                addMoreBtn.after(tagSpan);
                console.log('Tag span added');
            } else {
                console.log('addMoreBtn not found, tag not added');
            }
            tagSpan.querySelector('button').addEventListener('click', function () {
                tagSpan.remove();
                showToastMessage('Tag removed', 'success');
                updateRemoveAllVisibility();
            });
            updateRemoveAllVisibility();
        }

        function addTagsFromArray(tagsArray) {
            if (Array.isArray(tagsArray)) {
                tagsArray.forEach(tag => addTag(tag));
            }
        }

        function removeAllTags() {
            const tagElements = document.querySelectorAll('.tag-lskjsdb');
            const count = tagElements.length;
            if (count === 0) {
                showToastMessage('No tags to remove', 'warning');
            } else {
                tagElements.forEach(tag => tag.remove());
                showToastMessage(`${count} tags removed`, 'success');
                updateRemoveAllVisibility();
            }
        }

        // Populate tags if populateIdea
        console.log('Checking populateIdea for tags:', window.populateIdea);
        if (window.populateIdea && window.populateIdea.tags) {
            console.log('Tags found:', window.populateIdea.tags);
            window.populateIdea.tags.forEach(tag => {
                console.log('Adding tag:', tag);
                addTag(tag);
            });
        } else {
            console.log('No tags to populate');
        }

        // AI button handlers
        async function callAIApi(endpoint, data) {
            try {
                const response = await fetch(`/api/ai/${endpoint}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                return await response.json();
            } catch (error) {
                console.error('AI API error:', error);
                return { error: 'Network error' };
            }
        }


        // Generate random idea
        const randomIdeaBtn = document.querySelector('[aria-label="Generate random idea"]');
        console.log('Random idea button found:', randomIdeaBtn);
        randomIdeaBtn.addEventListener('click', async function (e) {
            e.preventDefault();


            const result = await callAIApi('random-idea', {});
            if (result.error) {
                if (typeof showToast !== 'undefined') {
                    showToast('AI error: ' + result.error, 'error');
                }
            } else {
                titleSpan.innerHTML = result.title || '';
                categorySpan.innerHTML = result.category || '';
                descriptionTextarea.value = result.description || '';
                updateCharCounter();
                removeAllTags();
                if (result.tags) {
                    addTagsFromArray(result.tags);
                }
                if (result.title) addTag(result.title);
                if (result.category) addTag(result.category);
                if (typeof showToast !== 'undefined') {
                    showToast('Random idea generated successfully', 'success');
                    showToast('10 credits deducted for AI usage', 'warning');
                }
                if (typeof window.loadNavCreditBalance === 'function') {
                    window.loadNavCreditBalance();
                }
            }
        });

        // Generate title with AI
        const generateTitleBtn = document.querySelector('[aria-label="Generate title with AI"]');
        if (generateTitleBtn) {
            generateTitleBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const description = descriptionTextarea.value;
                if (!description.trim()) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                showToastMessage('Generating title with AI...', 'info');
                const result = await callAIApi('suggest-title', { description });
                if (result.error) {
                    showToastMessage('AI error: ' + result.error, 'error');
                } else {
                    titleSpan.innerHTML = result.title || '';
                    showToastMessage('Title generated successfully', 'success');
                    showToastMessage('10 credits deducted for AI usage', 'warning');
                    if (typeof window.loadNavCreditBalance === 'function') {
                        window.loadNavCreditBalance();
                    }
                }
            });
        }

        // Add category with AI
        const addCategoryBtn = document.querySelector('[aria-label="Add category with AI"]');
        if (addCategoryBtn) {
            addCategoryBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const description = descriptionTextarea.value;
                if (!description.trim()) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                showToastMessage('Categorizing with AI...', 'info');
                const result = await callAIApi('add-category', { description });
                if (result.error) {
                    showToastMessage('AI error: ' + result.error, 'error');
                } else {
                    categorySpan.innerHTML = result.category || '';
                    showToastMessage('Category set successfully', 'success');
                    showToastMessage('10 credits deducted for AI usage', 'warning');
                    if (typeof window.loadNavCreditBalance === 'function') {
                        window.loadNavCreditBalance();
                    }
                }
            });
        }

        // Add tags with AI
        const addTagsBtn = document.querySelector('[aria-label="Add tags with AI"]');
        if (addTagsBtn) {
            addTagsBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const description = descriptionTextarea.value;
                if (!description.trim()) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                showToastMessage('Generating tags with AI...', 'info');
                const result = await callAIApi('add-tags', { description });
                if (result.error) {
                    showToastMessage('AI error: ' + result.error, 'error');
                } else if (result.tags) {
                    addTagsFromArray(result.tags);
                    showToastMessage(`${result.tags.length} tags added successfully`, 'success');
                    showToastMessage('10 credits deducted for AI usage', 'warning');
                    if (typeof window.loadNavCreditBalance === 'function') {
                        window.loadNavCreditBalance();
                    }
                }
            });
        }

        // Reset form
        const resetFormBtn = document.querySelector('[aria-label="Reset form"]');
        if (resetFormBtn) {
            resetFormBtn.addEventListener('click', function (e) {
                titleSpan.innerHTML = 'Untitled';
                categorySpan.innerHTML = 'Category';
                descriptionTextarea.value = '';
                removeAllTags();
                updateCharCounter();
                showToastMessage('Form reset successfully', 'info');
            });
        }

        // Auto fill with AI
        const autoFillBtn = document.querySelector('[aria-label="Auto fill with AI"]');
        if (autoFillBtn) {
            autoFillBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const description = descriptionTextarea.value;
                if (!description.trim()) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                showToastMessage('Auto filling with AI...', 'info');
                const result = await callAIApi('auto-fill', { description });
                if (result.error) {
                    showToastMessage('AI error: ' + result.error, 'error');
                } else {
                    titleSpan.innerHTML = result.title || '';
                    categorySpan.innerHTML = result.category || '';
                    descriptionTextarea.value = result.description || '';
                    updateCharCounter();
                    removeAllTags();
                    if (result.tags) {
                        addTagsFromArray(result.tags);
                    }
                    showToastMessage('Form auto filled successfully', 'success');
                    showToastMessage('10 credits deducted for AI usage', 'warning');
                    if (typeof window.loadNavCreditBalance === 'function') {
                        window.loadNavCreditBalance();
                    }
                }
            });
        }

        // Improve with AI
        const improveBtn = document.querySelector('[aria-label="Improve with AI"]');
        if (improveBtn) {
            improveBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const description = descriptionTextarea.value;
                if (!description.trim()) {
                    showToastMessage('Please enter a description first', 'warning');
                    return;
                }
                showToastMessage('Improving description with AI...', 'info');
                const result = await callAIApi('improve', { description });
                if (result.error) {
                    showToastMessage('AI error: ' + result.error, 'error');
                } else {
                    descriptionTextarea.value = result.improved_description;
                    updateCharCounter();
                    showToastMessage('Description improved successfully', 'success');
                    showToastMessage('10 credits deducted for AI usage', 'warning');
                    if (typeof window.loadNavCreditBalance === 'function') {
                        window.loadNavCreditBalance();
                    }
                }
            });
        }

        // Form submission
        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            // Client-side validation
            if (!descriptionTextarea.value.trim()) {
                if (typeof showToast !== 'undefined') {
                    showToast('Please enter a project description', 'warning');
                }
                return;
            }
            const descLength = descriptionTextarea.value.length;
            if (descLength < 100 || descLength > 2000) {
                if (typeof showToast !== 'undefined') {
                    showToast('Description must be between 100 and 2000 characters', 'warning');
                }
                return;
            }

            // Collect form data
            const title = titleSpan.textContent.trim() || 'Untitled';
            const category = categorySpan.textContent.trim() || 'Category';
            const description = descriptionTextarea.value;
            const tags = Array.from(document.querySelectorAll('.tag-lskjsdb span[contenteditable]')).map(span => span.textContent.trim()).filter(tag => tag);

            // Show loading state
            submitButton.disabled = true;
            submitButton.innerHTML = '<span>Creating...</span>';

            if (typeof showToast !== 'undefined') {
                showToast('Creating your idea...', 'info');
            }

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        _csrf: document.querySelector('input[name="_csrf"]').value,
                        prompt: description,
                        title,
                        category,
                        tags: JSON.stringify(tags)
                    })
                });

                if (response.ok) {
                    if (typeof showToast !== 'undefined') {
                        showToast('Idea created successfully!', 'success');
                    }
                    // Success - redirect after a short delay to show toast
                    setTimeout(() => {
                        window.location.href = '/admin/other-pages/new-project?success=created';
                    }, 1000);
                } else {
                    const errorData = await response.json();
                    if (typeof showToast !== 'undefined') {
                        showToast('Error: ' + (errorData.error || 'Failed to create project'), 'error');
                    }
                }
            } catch (error) {
                console.error('Submission error:', error);
                if (typeof showToast !== 'undefined') {
                    showToast('Network error. Please try again.', 'error');
                }
            } finally {
                // Reset loading state
                submitButton.disabled = false;
                submitButton.innerHTML = `
     <svg
       class="lucide lucide-plus w-4 h-4"
       xmlns="http://www.w3.org/2000/svg"
       width="16"
       height="16"
       viewBox="0 0 24 24"
       fill="none"
       stroke="currentColor"
       stroke-width="2"
       stroke-linecap="round"
       stroke-linejoin="round"
     >
       <path d="M5 12h14" />
       <path d="M12 5v14" />
     </svg>
      <span class="hidden group-hover:inline transition-all duration-200">Create Project</span>`;
            }
        });
    });


</script>