
<style>
/* Style range input as progress bar */
.progress-range {
    -webkit-appearance: none;
    appearance: none;
    background: linear-gradient(to right, hsl(290, 64%, 43%) 0%, hsl(290, 64%, 43%) calc(var(--value) / var(--max) * 100%), #f3f4f6 calc(var(--value) / var(--max) * 100%));
    cursor: default;
    pointer-events: none;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    border: none;
    outline: none;
}

/* Dark mode styles */
@media (prefers-color-scheme: dark) {
    .progress-range {
        background: linear-gradient(to right, hsl(290, 64%, 43%) 0%, hsl(290, 64%, 43%) calc(var(--value) / var(--max) * 100%), #374151 calc(var(--value) / var(--max) * 100%));
    }
}

.progress-range::-webkit-slider-track {
    background: transparent;
    height: 100%;
    border-radius: inherit;
    border: none;
}
.progress-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 0;
    height: 0;
}
.progress-range::-moz-range-track {
    background: transparent;
    height: 100%;
    border-radius: inherit;
    border: none;
}
.progress-range::-moz-range-thumb {
    width: 0;
    height: 0;
    border: none;
}
</style>

<!-- Mixed Progress Bar and Pills Navigation -->
<div class="flex justify-center mb-6">
    <div class="relative w-full max-w-[900px]">
        <!-- Progress Bar Background -->
        <div class="absolute top-1/2 left-0 right-0 h-1 bg-muted rounded-full transform -translate-y-1/2"></div>
        <!-- Progress Bar Fill -->
        <div id="progress-fill"
            class="absolute top-1/2 left-0 h-1 bg-primary rounded-full transform -translate-y-1/2 transition-all duration-300"
            style="width: {{progressPercent}}%"></div>

        <!-- Pills Overlay -->
        <div class="relative">
            <span
                class="step-pill cursor-pointer px-3 py-1 bg-primary text-primary-foreground text-xs rounded-full shadow-md z-10 absolute top-0"
                style="left: 0%; transform: translateX(-50%) translateY(-50%); white-space: nowrap;"
                data-section="executive-summary">0. Executive Summary</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10 absolute top-0"
                style="left: 20%; transform: translateX(-50%) translateY(-50%); white-space: nowrap;"
                data-section="problem-validation">1.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10 absolute top-0"
                style="left: 40%; transform: translateX(-50%) translateY(-50%); white-space: nowrap;"
                data-section="solution-development">2.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10 absolute top-0"
                style="left: 60%; transform: translateX(-50%) translateY(-50%); white-space: nowrap;"
                data-section="customer-model">3.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10 absolute top-0"
                style="left: 80%; transform: translateX(-50%) translateY(-50%); white-space: nowrap;"
                data-section="branding">4.</span>
            <span class="step-pill cursor-pointer px-3 py-1 bg-muted text-muted-foreground text-xs rounded-full z-10 absolute top-0"
                style="left: 100%; transform: translateX(-50%) translateY(-50%); white-space: nowrap;"
                data-section="ip-protection">5.</span>
        </div>
    </div>
</div>
<script>
    // Pill text variations for idea model sections
    const pillFullTexts = [
        '0. Executive Summary',
        '1. Problem Validation',
        '2. Solution Development',
        '3. Customer Model',
        '4. Branding',
        '5. IP Protection'
    ];
    const pillNumbers = ['0.', '1.', '2.', '3.', '4.', '5.'];

    function addHoverListeners() {
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            pill.addEventListener('mouseenter', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillFullTexts[index];
                }
            });
            pill.addEventListener('mouseleave', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillNumbers[index];
                }
            });
        });
    }

    // Function to show section and update UI
    function showSection(sectionIndex) {
        // Hide all sections
        document.querySelectorAll('.section').forEach(sec => {
            sec.style.display = 'none';
        });
        // Show target section
        const sectionIds = [
            'executive-summary',
            'problem-validation',
            'solution-development',
            'customer-model',
            'branding',
            'ip-protection'
        ];
        const targetSection = document.getElementById(sectionIds[sectionIndex]);
        if (targetSection) {
            targetSection.style.display = 'block';
        }

        // Update progress bar
        const progressBar = document.getElementById('progress-fill');
        const width = ((sectionIndex) / 5) * 100 + '%';
        progressBar.style.width = width;

        // Update pills
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            if (index < sectionIndex) {
                pill.classList.remove('bg-muted', 'text-muted-foreground');
                pill.classList.add('bg-primary', 'text-primary-foreground');
                pill.textContent = pillNumbers[index];
            } else if (index === sectionIndex) {
                pill.classList.remove('bg-muted', 'text-muted-foreground');
                pill.classList.add('bg-primary', 'text-primary-foreground');
                pill.textContent = pillFullTexts[index];
            } else {
                pill.classList.remove('bg-primary', 'text-primary-foreground');
                pill.classList.add('bg-muted', 'text-muted-foreground');
                pill.textContent = pillNumbers[index];
            }
        });
    }

    // Add click listeners to pills
    document.querySelectorAll('.step-pill').forEach((pill, index) => {
        pill.addEventListener('click', () => {
            showSection(index);
        });
    });

    // Add click listeners to move next buttons
    document.querySelectorAll('.move-next-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const currentSection = btn.closest('.section');
            const sectionIds = ['executive-summary', 'problem-validation', 'solution-development', 'customer-model', 'branding', 'ip-protection'];
            const currentIndex = sectionIds.indexOf(currentSection.id);
            if (currentIndex < 5) {
                showSection(currentIndex + 1);
            } else {
                // Last section
                alert('Idea model completed!');
            }
        });
    });

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
    const activeStep = 1;
    showSection(activeStep - 1); // activeStep is 1-based, index is 0-based



    addHoverListeners();
    });
</script>
