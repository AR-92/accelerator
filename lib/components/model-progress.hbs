
<style>
/* Style range input as progress bar */
.progress-range {
    -webkit-appearance: none;
    appearance: none;
    background: linear-gradient(to right, hsl(290, 64%, 43%) 0%, hsl(290, 64%, 43%) calc(var(--value) / var(--max) * 100%), #f3f4f6 calc(var(--value) / var(--max) * 100%));
    cursor: default;
    pointer-events: none;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    border: none;
    outline: none;
}

/* Dark mode styles */
@media (prefers-color-scheme: dark) {
    .progress-range {
        background: linear-gradient(to right, hsl(290, 64%, 43%) 0%, hsl(290, 64%, 43%) calc(var(--value) / var(--max) * 100%), #374151 calc(var(--value) / var(--max) * 100%));
    }
}

.progress-range::-webkit-slider-track {
    background: transparent;
    height: 100%;
    border-radius: inherit;
    border: none;
}
.progress-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 0;
    height: 0;
}
.progress-range::-moz-range-track {
    background: transparent;
    height: 100%;
    border-radius: inherit;
    border: none;
}
.progress-range::-moz-range-thumb {
    width: 0;
    height: 0;
    border: none;
}
</style>

<!-- Mixed Progress Bar and Pills Navigation -->
<div class="flex justify-center mb-6">
    <div class="relative w-full max-w-[900px]">
        <!-- Progress Bar Background -->
        <div class="absolute top-1/2 left-0 right-0 h-1 bg-muted rounded-full transform -translate-y-1/2"></div>
        <!-- Progress Bar Fill -->
        <div id="progress-fill"
            class="absolute top-1/2 left-0 h-1 bg-primary rounded-full transform -translate-y-1/2 transition-all duration-300"></div>

        <!-- Pills Overlay -->
        <div class="relative progress-pills-container">
            <!-- Pills will be generated dynamically by JS -->
        </div>
    </div>
</div>
<script>
    var data = {{{data}}}
    // Data is already parsed as array
    const parsedData = data;

    // Derive dynamic arrays from data
    const sectionIds = parsedData.map(item => item.id);
    const pillFullTexts = parsedData.map(item => item.fullLabel);
    const pillNumbers = parsedData.map(item => item.shortLabel);

    function addHoverListeners() {
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            pill.addEventListener('mouseenter', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillFullTexts[index];
                }
            });
            pill.addEventListener('mouseleave', () => {
                if (!pill.classList.contains('bg-primary')) {
                    pill.textContent = pillNumbers[index];
                }
            });
        });
    }

    // Function to show section and update UI
    function showSection(sectionIndex) {
        // Hide all sections
        document.querySelectorAll('.section').forEach(sec => {
            sec.style.display = 'none';
        });
        // Show target section
        const targetSection = document.getElementById(sectionIds[sectionIndex]);
        if (targetSection) {
            targetSection.style.display = 'block';
        }

        // Update progress bar
        const progressBar = document.getElementById('progress-fill');
        const width = ((sectionIndex) / (parsedData.length - 1)) * 100 + '%';
        progressBar.style.width = width;

        // Save to localStorage
        localStorage.setItem('modelProgressSection', sectionIndex);

        // Update pills
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            if (index < sectionIndex) {
                pill.classList.remove('bg-muted', 'text-muted-foreground');
                pill.classList.add('bg-primary', 'text-primary-foreground');
                pill.textContent = pillNumbers[index];
            } else if (index === sectionIndex) {
                pill.classList.remove('bg-muted', 'text-muted-foreground');
                pill.classList.add('bg-primary', 'text-primary-foreground');
                pill.textContent = pillFullTexts[index];
            } else {
                pill.classList.remove('bg-primary', 'text-primary-foreground');
                pill.classList.add('bg-muted', 'text-muted-foreground');
                pill.textContent = pillNumbers[index];
            }
        });
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
        // Generate pills dynamically
        const pillsContainer = document.querySelector('.progress-pills-container');
        parsedData.forEach((item, index) => {
            const span = document.createElement('span');
            span.className = `step-pill cursor-pointer px-3 py-1 ${index === 0 ? 'bg-primary text-primary-foreground' : 'bg-muted text-muted-foreground'} text-xs rounded-full shadow-md z-10 absolute top-1/2`;
            span.style.left = `${item.position}%`;
            span.style.transform = 'translateX(-50%) translateY(-50%)';
            span.style.whiteSpace = 'nowrap';
            span.dataset.section = item.id;
            span.textContent = index === 0 ? item.fullLabel : item.shortLabel;
            pillsContainer.appendChild(span);
        });

        // Add click listeners to pills (after pills are created)
        document.querySelectorAll('.step-pill').forEach((pill, index) => {
            pill.addEventListener('click', () => {
                showSection(index);
            });
        });

        // Add click listeners to move next buttons
        document.querySelectorAll('.move-next-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const currentSection = btn.closest('.section');
                const currentIndex = sectionIds.indexOf(currentSection.id);
                if (currentIndex < parsedData.length - 1) {
                    showSection(currentIndex + 1);
                } else {
                    // Last section
                    alert('Idea model completed!');
                }
            });
        });

        showSection(0); // Always start with the first section
        addHoverListeners();
    });
</script>
