<div class="w-full ">
    <div class="px-6 py-8">
        <div class="flex flex-col items-center text-center">
            <!-- Title Section -->
            <div class="text-center">
                <h1 class="text-4xl font-bold text-foreground mb-2">{{title}}</h1>
                <p class="text-muted-foreground text-lg">{{description}}</p>
                <div class="mt-4 h-1 bg-primary w-24 mx-auto rounded-full mb-2"></div>
            </div>

            <!-- Rating Section -->
            <div class="flex flex-row items-center gap-6 min-w-0 mb-4">
                <div class="flex items-center gap-1 mb-1">
                    <span id="rating-stars" class="text-yellow-400 text-lg">{{ratingStars}}</span>
                    <span id="rating-value" class="text-sm text-muted-foreground">{{ratingValue}}</span>
                </div>
                <span id="vote-count" class="text-xs text-muted-foreground">{{voteCount}}</span>
            </div>


        </div>
    </div>

</div>