<h1 class="text-2xl font-bold mb-4">Generate Your Business Report</h1>
<p class="text-muted-foreground mb-6">Answer the following questions to build a comprehensive business report for your project.</p>
<div class="relative">
    <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-border"></div>
    <div class="flex items-start gap-4 mb-6">
        <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">1</div>
        <div class="flex-1">
            {{>question-block id="step1" step="1" question="What is the core problem your project solves?"}}
        </div>
    </div>
    <div class="flex items-start gap-4 mb-6">
        <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">2</div>
        <div class="flex-1">
            {{>question-block id="step2" step="2" question="Describe your proposed solution."}}
        </div>
    </div>
    <div class="flex items-start gap-4 mb-6">
        <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">3</div>
        <div class="flex-1">
            {{>question-block id="step3" step="3" question="Who is your target audience?"}}
        </div>
    </div>
    <div class="flex items-start gap-4 mb-6">
        <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">4</div>
        <div class="flex-1">
            {{>question-block id="step5" step="5" question="What are your key success metrics?"}}
        </div>
    </div>
    <div class="flex items-start gap-4">
        <div class="w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold relative z-10">5</div>
        <div class="flex-1">
            <div class="flex flex-col border border-primary/20 dark:border-primary/40 rounded-md bg-primary/5 dark:bg-primary/10 p-6">
                <div class="text-center">
                    <svg class="lucide lucide-check-circle w-12 h-12 text-primary mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22,4 12,14.01 9,11.01"></polyline>
                    </svg>
                    <p class="text-primary font-medium mb-6">You have successfully completed this section of the business report.</p>
                    <button class="bg-primary text-primary-foreground px-8 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors shadow-md">Move to Next Section</button>
                </div>
            </div>
        </div>
    </div>
</div>